        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <thead>
            <tr style="border-bottom:2px solid var(--bs-accent);">
              <th style="text-align:left;padding:14px 12px;color:var(--bs-accent);font-weight:600;">Feature</th>
              <th style="text-align:left;padding:14px 12px;color:var(--bs-accent);font-weight:600;">BirkyStudio</th>
              <th style="text-align:left;padding:14px 12px;color:var(--bs-accent);font-weight:600;">CINC</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Starting Price</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">$0 audit (15 min), projects from $297 one-time</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">Quote only, third party reports from $899/month solo</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.02);">
              <td style="padding:14px 12px;color:white;font-weight:600;">What It Is</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">A done-for-you AI operator we build and run for you</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">A managed lead-gen and CRM platform you rent and operate</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Price Visible Before a Sales Call</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ Yes, every price is published on our site</td>
              <td style="padding:14px 12px;color:white;font-weight:600;"><span class="mark-soft">✕</span> No, all four plans say Request Pricing</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.02);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Pricing Model</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ One-time builds you own, optional $97/mo or $197/mo care</td>
              <td style="padding:14px 12px;color:white;font-weight:600;"><span class="mark-soft">⚠️</span> Monthly subscription plus a mandatory ad budget</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
