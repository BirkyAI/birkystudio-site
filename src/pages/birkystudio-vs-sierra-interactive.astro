              <th style="text-align:left;padding:14px 12px;color:var(--bs-accent);font-weight:600;">Sierra Interactive</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
