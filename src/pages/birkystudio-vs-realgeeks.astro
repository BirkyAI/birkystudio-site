              <td style="padding:14px 12px;color:white;font-weight:600;">❌ Basic contact info only</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.02);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Lead Guarantee</td>
