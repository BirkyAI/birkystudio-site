---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Partner With Birky Studio | AI Agent Broker & Affiliate" description="Earn commissions and recurring income by referring clients for AI agents, websites, and receptionist setups. You bring the leads, we build and deliver." image="/images/birky-mascot.jpg">

  <!-- Hero -->
  <section style="background:linear-gradient(135deg,#0f172a 0%,#1e1b4b 50%,#312e81 100%);padding:100px 0 80px;position:relative;overflow:hidden;">
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 20% 50%,rgba(99,102,241,0.15),transparent 50%),radial-gradient(circle at 80% 50%,rgba(236,72,153,0.1),transparent 50%);"></div>
    <div class="container" style="position:relative;z-index:1;text-align:center;">
      <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#818cf8,#f472b6);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:2.2rem;box-shadow:0 0 40px rgba(99,102,241,0.3);">
        🤝
      </div>
      <h1 style="font-size:clamp(2rem,5vw,3.2rem);font-weight:800;color:white;margin-bottom:20px;">
        Sell AI Solutions.<br><span style="background:linear-gradient(135deg,#818cf8,#f472b6,#22d3ee);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Earn. Every. Month.</span>
      </h1>
      <p style="font-size:1.15rem;color:#cbd5e1;max-width:650px;margin:0 auto;line-height:1.8;">
        You bring the clients. We build, deploy, and support the product. You earn one-time commissions on every setup <em>plus</em> ongoing residuals on monthly retainers — as long as your client stays with us, you get paid.
      </p>
    </div>
  </section>

  <!-- What You Can Sell -->
  <section style="padding:80px 0;background:linear-gradient(135deg,#1a0f2e 0%,#2d1b4e 100%);">
    <div class="container">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:48px;">
        What Your Clients Get (That You Sell)
      </h2>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;max-width:1000px;margin:0 auto;">
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;">
          <div style="font-size:2rem;margin-bottom:8px;">🤖</div>
          <h3 style="color:white;font-size:1.2rem;margin-bottom:4px;">AI Agent Setup</h3>
          <div style="font-size:1.5rem;font-weight:700;color:#818cf8;margin-bottom:12px;">$1,297</div>
          <p style="color:#94a3b8;font-size:0.92rem;line-height:1.7;">
            Custom AI assistant with Notion CRM, email automation, WhatsApp integration, and training call. Bilingual EN/ES. One-time setup.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;">
          <div style="font-size:2rem;margin-bottom:8px;">📞</div>
          <h3 style="color:white;font-size:1.2rem;margin-bottom:4px;">AI Voice Receptionist</h3>
          <div style="font-size:1.5rem;font-weight:700;color:#818cf8;margin-bottom:12px;">$550</div>
          <p style="color:#94a3b8;font-size:0.92rem;line-height:1.7;">
            AI phone + text receptionist with natural voice. Answers calls, qualifies leads, transfers urgent ones. 24/7, bilingual.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;">
          <div style="font-size:2rem;margin-bottom:8px;">💬</div>
          <h3 style="color:white;font-size:1.2rem;margin-bottom:4px;">AI Text Receptionist</h3>
          <div style="font-size:1.5rem;font-weight:700;color:#818cf8;margin-bottom:12px;">$297</div>
          <p style="color:#94a3b8;font-size:0.92rem;line-height:1.7;">
            WhatsApp-based AI that responds 24/7. Answers FAQs, captures leads, takes messages. Bilingual. One-time setup.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;">
          <div style="font-size:2rem;margin-bottom:8px;">🌐</div>
          <h3 style="color:white;font-size:1.2rem;margin-bottom:4px;">Websites</h3>
          <div style="font-size:1.5rem;font-weight:700;color:#818cf8;margin-bottom:12px;">$499 - $1,999</div>
          <p style="color:#94a3b8;font-size:0.92rem;line-height:1.7;">
            Professional bilingual websites, mobile-first, SEO-ready. Delivered in 3 days. Starter to Premium tiers.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;">
          <div style="font-size:2rem;margin-bottom:8px;">🔧</div>
          <h3 style="color:white;font-size:1.2rem;margin-bottom:4px;">Monthly Support</h3>
          <div style="font-size:1.5rem;font-weight:700;color:#818cf8;margin-bottom:12px;">$29 - $49/mo</div>
          <p style="color:#94a3b8;font-size:0.92rem;line-height:1.7;">
            Optional maintenance & prompt tweaks. Keeps their AI sharp and up-to-date. No contract, cancel anytime.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;">
          <div style="font-size:2rem;margin-bottom:8px;">🤝</div>
          <h3 style="color:white;font-size:1.2rem;margin-bottom:4px;">Business AI Partner Retainer</h3>
          <div style="font-size:1.5rem;font-weight:700;color:#818cf8;margin-bottom:12px;">$197/mo</div>
          <p style="color:#94a3b8;font-size:0.92rem;line-height:1.7;">
            Monthly strategy call, performance report, and one custom automation per month. Their AI keeps getting smarter.
          </p>
        </div>
      </div>

      <div style="text-align:center;margin-top:40px;">
        <p style="color:#94a3b8;font-size:0.95rem;">
          All prices are one-time setup fees except Monthly Support and the Business AI Partner Retainer, which are monthly — this is where your recurring income lives.
        </p>
      </div>
    </div>
  </section>

  <!-- The Partner Offer -->
  <section style="padding:80px 0;background:#0f172a;">
    <div class="container">
      <div style="max-width:750px;margin:0 auto;">
        <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:16px;">
          What's In It For You
        </h2>
        <p style="color:#94a3b8;text-align:center;font-size:1rem;margin-bottom:48px;line-height:1.7;">
          Here's the deal in plain numbers. Every client you bring generates two income streams for you.
        </p>

        <div style="display:grid;gap:20px;margin-bottom:40px;">
          <div style="background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.25);border-radius:16px;padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#6366f1,#818cf8);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0;">💰</div>
            <div>
              <h3 style="color:white;font-size:1.1rem;margin-bottom:6px;">One-Time Commissions</h3>
              <p style="color:#94a3b8;font-size:0.92rem;line-height:1.7;">
                Earn a percentage of every setup fee. AI agent ($1,297)? Voice receptionist ($550)? Website ($499-$1,999)? You get paid when the client pays — <strong style="color:#e2e8f0;">every single deal</strong>.
              </p>
            </div>
          </div>

          <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.25);border-radius:16px;padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#10b981,#34d399);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0;">🔄</div>
            <div>
              <h3 style="color:white;font-size:1.1rem;margin-bottom:6px;">Monthly Residuals</h3>
              <p style="color:#94a3b8;font-size:0.92rem;line-height:1.7;">
                Every client who stays on our optional support retainer ($197/mo for AI Agent with training, or $29-49/mo basic) pays you every month. <strong style="color:#e2e8f0;">Stack 5 clients and you've built real passive income.</strong> No cap.
              </p>
            </div>
          </div>

          <div style="background:rgba(236,72,153,0.1);border:1px solid rgba(236,72,153,0.25);border-radius:16px;padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#ec4899,#f472b6);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0;">🛠️</div>
            <div>
              <h3 style="color:white;font-size:1.1rem;margin-bottom:6px;">Zero Delivery Work</h3>
              <p style="color:#94a3b8;font-size:0.92rem;line-height:1.7;">
                You don't build, deploy, support, or train. We handle everything after the sale. You bring leads, close deals, and collect. That's it.
              </p>
            </div>
          </div>
        </div>

        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;margin-bottom:40px;">
          <h3 style="color:white;font-size:1.1rem;margin-bottom:12px;text-align:center;">📊 Stacking Example</h3>
          <div style="color:#94a3b8;font-size:0.92rem;line-height:1.8;max-width:500px;margin:0 auto;">
            <p>Bring 5 clients in your first year:</p>
            <div style="display:grid;grid-template-columns:1fr auto;gap:4px 16px;margin:16px 0;font-size:0.92rem;">
              <span style="color:#cbd5e1;">Setup commissions (5×)</span><span style="color:#6ee7b7;text-align:right;">~$975</span>
              <span style="color:#cbd5e1;">Residuals (stacked over 12 months)</span><span style="color:#6ee7b7;text-align:right;">~$2,945</span>
              <span style="border-top:1px solid rgba(255,255,255,0.15);padding-top:8px;color:white;font-weight:700;">Year 1 Total</span><span style="color:#22d3ee;text-align:right;font-weight:700;border-top:1px solid rgba(255,255,255,0.15);padding-top:8px;">~$3,900</span>
            </div>
            <p style="font-size:0.85rem;color:#64748b;">And those residuals keep coming year after year as long as clients stay.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who This Is For -->
  <section style="padding:80px 0;background:linear-gradient(135deg,#1a0f2e 0%,#2d1b4e 100%);">
    <div class="container" style="max-width:900px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:48px;">
        Who Should Apply
      </h2>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:24px;">
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;text-align:center;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🏢</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:12px;">Agency Owners</h3>
          <p style="color:#94a3b8;font-size:0.9rem;line-height:1.7;">
            You run a marketing, web design, or consulting agency. Add AI solutions to your offering without hiring developers.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;text-align:center;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🤝</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:12px;">Business Consultants</h3>
          <p style="color:#94a3b8;font-size:0.9rem;line-height:1.7;">
            You already advise business owners. Now you can recommend and sell real AI solutions — and earn from it.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;text-align:center;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🌐</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:12px;">Networkers & Connectors</h3>
          <p style="color:#94a3b8;font-size:0.9rem;line-height:1.7;">
            You know business owners who are overwhelmed by admin, missing calls, or need a better website. Connect them with us.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section style="padding:80px 0;background:#0f172a;">
    <div class="container" style="max-width:800px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:48px;">
        How It Works
      </h2>

      <div style="display:grid;grid-template-columns:1fr;gap:0px;position:relative;">
        <!-- Timeline line -->
        <div style="position:absolute;left:24px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,#6366f1,#ec4899);"></div>

        <!-- Step 1 -->
        <div style="display:flex;gap:24px;padding-bottom:40px;position:relative;">
          <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#818cf8);display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;color:white;flex-shrink:0;position:relative;z-index:1;">1</div>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;flex:1;">
            <h3 style="color:white;font-size:1rem;margin-bottom:4px;">Book a Chat</h3>
            <p style="color:#94a3b8;font-size:0.9rem;line-height:1.6;">We'll walk through the deal structure, your network, and what works best for both of us. No commitment.</p>
          </div>
        </div>

        <!-- Step 2 -->
        <div style="display:flex;gap:24px;padding-bottom:40px;position:relative;">
          <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#818cf8);display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;color:white;flex-shrink:0;position:relative;z-index:1;">2</div>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;flex:1;">
            <h3 style="color:white;font-size:1rem;margin-bottom:4px;">Refer & Close</h3>
            <p style="color:#94a3b8;font-size:0.9rem;line-height:1.6;">You introduce potential clients. We handle the demo, tech specs, and delivery details. You close the deal.</p>
          </div>
        </div>

        <!-- Step 3 -->
        <div style="display:flex;gap:24px;padding-bottom:0;position:relative;">
          <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#818cf8);display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;color:white;flex-shrink:0;position:relative;z-index:1;">3</div>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;flex:1;">
            <h3 style="color:white;font-size:1rem;margin-bottom:4px;">Collect & Stack</h3>
            <p style="color:#94a3b8;font-size:0.9rem;line-height:1.6;">You get paid on every closed deal — one-time commissions plus monthly residuals. Bring more clients, stack more income. No cap.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="padding:80px 0;background:linear-gradient(135deg,#1a0f2e 0%,#2d1b4e 100%);">
    <div class="container" style="max-width:700px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:48px;">
        Common Questions
      </h2>

      <div style="display:grid;gap:16px;">
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:8px;">Do I need technical knowledge?</h3>
          <p style="color:#94a3b8;font-size:0.9rem;line-height:1.7;">Zero. You sell, we build. If a client asks a technical question, we answer it. Your job is finding the right people and closing.</p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:8px;">What if the client cancels support?</h3>
          <p style="color:#94a3b8;font-size:0.9rem;line-height:1.7;">Commission is paid on actual revenue received. If the client drops support, the residual stops. No risk to you, no overpayment on our side.</p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:8px;">Is there an exclusive territory or non-compete?</h3>
          <p style="color:#94a3b8;font-size:0.9rem;line-height:1.7;">Not at this stage. You can sell alongside others. First come, first paid. If the model grows, we may create tiers for top performers.</p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:8px;">How do I get paid?</h3>
          <p style="color:#94a3b8;font-size:0.9rem;line-height:1.7;">Direct transfer at the end of each month. One-time commissions are paid after the client's payment clears. Residuals are paid monthly.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Download Sales Brief -->
  <section style="padding:60px 0;background:#0f172a;">
    <div class="container" style="max-width:600px;text-align:center;">
      <div style="background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.25);border-radius:16px;padding:40px 32px;">
        <div style="font-size:2.5rem;margin-bottom:12px;">📄</div>
        <h2 style="color:white;font-size:1.4rem;margin-bottom:12px;">
          Sales Partner Brief
        </h2>
        <p style="color:#94a3b8;line-height:1.7;margin-bottom:24px;">
          A simple one-page doc that explains everything your sales partners need to know — products, pricing, how to pitch, and common objections. No tech jargon, just plain English.
        </p>
        <a href="/sales-brief-for-partners.pdf" target="_blank" rel="noopener" class="btn btn-primary" style="font-size:1.1rem;padding:16px 36px;" download>
          📥 Download Sales Brief →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding:80px 0;background:#0f172a;">
    <div class="container" style="max-width:700px;text-align:center;">
      <div style="background:linear-gradient(135deg,#1e1b4b,#312e81);border-radius:16px;padding:48px 32px;border:1px solid rgba(129,140,248,0.3);">
        <h2 style="color:white;font-size:1.5rem;margin-bottom:16px;">
          Ready to Partner Up?
        </h2>
        <p style="color:#cbd5e1;line-height:1.8;margin-bottom:24px;max-width:480px;margin-left:auto;margin-right:auto;">
          Pick a time that works for you. We'll talk through your network, the numbers, and whether this is a fit for both of us.
        </p>
        <a href="https://calendar.app.google/9wfTHPwTYaAW4NKi8" target="_blank" rel="noopener" class="btn btn-primary" style="font-size:1.1rem;padding:16px 36px;">
          📅 Pick a Time →
        </a>
        <p style="color:#64748b;font-size:0.82rem;margin-top:16px;">
          A Google Meet link is auto-generated for every booking. No commitment, no pressure.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>