---
import BaseLayout from '../layouts/BaseLayout.astro';

const oneTime = [
  { name: 'Base Agent, solo', retail: '$1,297', pay: '$648', keep: '$649' },
  { name: 'Base Agent, with a team', retail: '$2,997', pay: '$1,498', keep: '$1,499' },
  { name: 'Text Receptionist (WhatsApp)', retail: '$297', pay: '$148', keep: '$149' },
  { name: 'Voice Receptionist (phone, 24/7)', retail: '$550', pay: '$275', keep: '$275' },
  { name: 'Review Engine', retail: '$497', pay: '$248', keep: '$249' },
  { name: 'Verified Prospect List, starter (25 leads)', retail: '$497', pay: '$248', keep: '$249' },
  { name: 'Verified Prospect List, pro (100 leads)', retail: '$997', pay: '$498', keep: '$499' },
  { name: 'Lead Generation Pack', retail: '$1,997', pay: '$998', keep: '$999' },
  { name: 'Outreach Engine', retail: '$797', pay: '$398', keep: '$399' },
  { name: 'GBP Autopilot', retail: '$397', pay: '$198', keep: '$199' },
  { name: 'Content Engine', retail: '$497', pay: '$248', keep: '$249' },
  { name: 'Website Starter (1 to 3 pages)', retail: '$499', pay: '$249', keep: '$250' },
  { name: 'Website Professional (EN and ES)', retail: '$999', pay: '$499', keep: '$500' },
  { name: 'Website Premium (10+ pages with blog)', retail: '$1,999', pay: '$999', keep: '$1,000' },
  { name: 'Self-Editing CMS', retail: '$130', pay: '$65', keep: '$65' },
  { name: 'Custom Assessment, solo', retail: '$349', pay: '$174', keep: '$175' },
  { name: 'Custom Assessment, business', retail: '$999', pay: '$499', keep: '$500' },
];

const monthly = [
  { name: 'Care and Maintenance', retail: '$97', pay: '$48', keep: '$49' },
  { name: 'Business AI Partner', retail: '$197', pay: '$98', keep: '$99' },
  { name: 'Content Booster', retail: '$149', pay: '$74', keep: '$75' },
  { name: 'Content Pro', retail: '$199', pay: '$99', keep: '$100' },
];
---

<BaseLayout title="White Label AI Partner Program" description="Resell AI agents, receptionists, lead generation and websites under your own brand. Buy at half of retail, sell at retail or above, keep the difference. We build, run and support it." image="/images/birky-logo.jpg">

  <!-- Hero -->
  <section style="padding:100px 0 80px;position:relative;overflow:hidden">
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 20% 50%,rgba(255,45,149,0.15),transparent 50%),radial-gradient(circle at 80% 50%,rgba(255,45,149,0.1),transparent 50%);"></div>
    <div class="container" style="position:relative;z-index:1;text-align:center;">
      <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--bs-accent),var(--bs-accent));display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:2.2rem;box-shadow:0 0 40px rgba(255,45,149,0.3);">
        🤝
      </div>
      <h1 style="font-size:clamp(2rem,5vw,3.2rem);font-weight:800;color:white;margin-bottom:20px;text-transform:uppercase;">
        Wholesale AI Agents.<br><span style="color:var(--bs-accent);">Sold Under Your Brand.</span>
      </h1>
      <p style="font-size:1.15rem;color:var(--bs-text);max-width:680px;margin:0 auto;line-height:1.8;">
        You buy at <strong>half of retail</strong>. You sell at retail or above, on your own invoice, under your own brand. We build, run and support everything behind the curtain, and your client never hears our name.
      </p>
    </div>
  </section>

  <!-- How the money works -->
  <section style="padding:80px 0">
    <div class="container">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:48px;text-transform:uppercase;">
        How The Money <em style="font-style:normal;color:var(--bs-accent);">Works</em>
      </h2>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;max-width:1000px;margin:0 auto 40px;">
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;">
          <div style="font-size:2rem;margin-bottom:8px;">🏷️</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:10px;text-transform:uppercase;">You Buy At Half</h3>
          <p style="color:var(--bs-text-muted);font-size:0.92rem;line-height:1.7;">
            Every product has a partner price. It is half of the published retail price, rounded down to the dollar, so the odd dollar always lands on your side. No tiers, no haggling, no volume commitment.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;">
          <div style="font-size:2rem;margin-bottom:8px;">🧾</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:10px;text-transform:uppercase;">You Sell On Your Invoice</h3>
          <p style="color:var(--bs-text-muted);font-size:0.92rem;line-height:1.7;">
            Your client pays you, at retail or above. Your invoice, your brand, your price. We never invoice them and never contact them.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;">
          <div style="font-size:2rem;margin-bottom:8px;">💵</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:10px;text-transform:uppercase;">You Keep The Difference</h3>
          <p style="color:var(--bs-text-muted);font-size:0.92rem;line-height:1.7;">
            From the first invoice, in your own account. No commission to chase, no revenue share to track, no waiting for us to pay you.
          </p>
        </div>
      </div>

      <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;max-width:620px;margin:0 auto;">
        <h3 style="color:white;font-size:1.1rem;margin-bottom:16px;text-align:center;">📊 A Worked Example</h3>
        <div style="color:var(--bs-text-muted);font-size:0.95rem;line-height:1.8;">
          <p style="margin-bottom:12px;">The Voice Receptionist:</p>
          <div style="display:grid;grid-template-columns:1fr auto;gap:6px 16px;">
            <span style="color:var(--bs-text);">Your client pays you</span><span style="color:var(--bs-text);text-align:right;">$550</span>
            <span style="color:var(--bs-text);">You pay Birky Studio</span><span style="color:var(--bs-text);text-align:right;">$275</span>
            <span style="border-top:1px solid rgba(255,255,255,0.15);padding-top:8px;color:white;font-weight:700;">You keep</span><span style="color:var(--bs-accent);text-align:right;font-weight:700;border-top:1px solid rgba(255,255,255,0.15);padding-top:8px;">$275</span>
          </div>
          <p style="font-size:0.88rem;margin-top:16px;">
            Add a monthly care plan and the same split applies every month: your client pays $97, you pay us $48, you keep $49 for as long as they stay. Five clients on care is $245 a month arriving without a single new sale.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Price list -->
  <section style="padding:80px 0">
    <div class="container" style="max-width:900px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:16px;text-transform:uppercase;">
        The Partner <em style="font-style:normal;color:var(--bs-accent);">Price List</em>
      </h2>
      <p style="color:var(--bs-text-muted);text-align:center;font-size:0.95rem;margin-bottom:40px;line-height:1.7;">
        Retail prices are the published birkystudio.com prices, and they are your floor.
      </p>

      <h3 style="color:white;font-size:1.1rem;margin-bottom:16px;text-transform:uppercase;">One-Time Builds</h3>
      <div style="overflow-x:auto;margin-bottom:40px;">
        <table style="width:100%;border-collapse:collapse;font-size:0.92rem;">
          <thead>
            <tr>
              <th style="text-align:left;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">Product</th>
              <th style="text-align:right;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">Your client pays</th>
              <th style="text-align:right;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">You pay us</th>
              <th style="text-align:right;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">You keep</th>
            </tr>
          </thead>
          <tbody>
            {oneTime.map((p) => (
              <tr>
                <td style="padding:10px 12px;color:var(--bs-text);border-bottom:1px solid rgba(255,255,255,0.07);">{p.name}</td>
                <td style="padding:10px 12px;color:var(--bs-text-muted);text-align:right;white-space:nowrap;border-bottom:1px solid rgba(255,255,255,0.07);">{p.retail}</td>
                <td style="padding:10px 12px;color:var(--bs-text-muted);text-align:right;white-space:nowrap;border-bottom:1px solid rgba(255,255,255,0.07);">{p.pay}</td>
                <td style="padding:10px 12px;color:var(--bs-accent);text-align:right;white-space:nowrap;font-weight:600;border-bottom:1px solid rgba(255,255,255,0.07);">{p.keep}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 style="color:white;font-size:1.1rem;margin-bottom:16px;text-transform:uppercase;">Monthly, Where The Recurring Income Lives</h3>
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:0.92rem;">
          <thead>
            <tr>
              <th style="text-align:left;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">Product</th>
              <th style="text-align:right;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">Your client pays</th>
              <th style="text-align:right;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">You pay us</th>
              <th style="text-align:right;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">You keep</th>
            </tr>
          </thead>
          <tbody>
            {monthly.map((p) => (
              <tr>
                <td style="padding:10px 12px;color:var(--bs-text);border-bottom:1px solid rgba(255,255,255,0.07);">{p.name}</td>
                <td style="padding:10px 12px;color:var(--bs-text-muted);text-align:right;white-space:nowrap;border-bottom:1px solid rgba(255,255,255,0.07);">{p.retail} / mo</td>
                <td style="padding:10px 12px;color:var(--bs-text-muted);text-align:right;white-space:nowrap;border-bottom:1px solid rgba(255,255,255,0.07);">{p.pay}</td>
                <td style="padding:10px 12px;color:var(--bs-accent);text-align:right;white-space:nowrap;font-weight:600;border-bottom:1px solid rgba(255,255,255,0.07);">{p.keep}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p style="color:var(--bs-text-muted);font-size:0.88rem;margin-top:24px;line-height:1.8;">
        Voice call usage is billed at cost, roughly $30 to $50 per client per month through Vapi. No markup. If you would rather be the first line of support yourself, you keep the whole monthly instead.
      </p>
    </div>
  </section>

  <!-- Five rules -->
  <section style="padding:80px 0">
    <div class="container" style="max-width:800px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:40px;text-transform:uppercase;">
        Five Rules, So Nothing Is <em style="font-style:normal;color:var(--bs-accent);">Negotiated Twice</em>
      </h2>
      <div style="display:grid;gap:16px;">
        <div style="background:rgba(255,45,149,0.08);border:1px solid rgba(255,45,149,0.25);border-radius:12px;padding:22px 26px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:6px;text-transform:uppercase;">Retail is the floor</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">Sell at retail or above. Undercutting other partners, or our own clients, is the one thing that ends an agreement.</p>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:22px 26px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:6px;text-transform:uppercase;">Partner pricing stays between partners</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">Never offered to an end client as a discount, never published outside a partner conversation.</p>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:22px 26px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:6px;text-transform:uppercase;">You own the client</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">We never contact them directly, and never sell to them afterwards. Your list stays yours.</p>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:22px 26px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:6px;text-transform:uppercase;">Your brand only</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">No Birky Studio logo, name or link in anything your client receives. Co-branding is your choice, and you ask for it before launch.</p>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:22px 26px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:6px;text-transform:uppercase;">Thirty days of support included</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">On every build, the same as our own clients get. After that, a care plan or quoted changes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who this is for -->
  <section style="padding:80px 0">
    <div class="container" style="max-width:900px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:48px;text-transform:uppercase;">
        Who This Is <em style="font-style:normal;color:var(--bs-accent);">For</em>
      </h2>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:24px;">
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;text-align:center;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🏢</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:12px;">Agencies</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">
            Marketing, web, SEO, CRM and GoHighLevel agencies. Add AI agents and receptionists to what you already sell, without hiring a developer or building a platform.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;text-align:center;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🛠️</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:12px;">Automation Builders</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">
            n8n, Make and Zapier operators who already have clients and want a finished voice and lead product to put in front of them, instead of building one from scratch.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;text-align:center;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🤝</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:12px;">Consultants</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">
            You already advise business owners on how they work. Now you can hand them a real system, keep the margin, and let us carry the technical side.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section style="padding:80px 0">
    <div class="container" style="max-width:800px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:48px;text-transform:uppercase;">
        How It <em style="font-style:normal;color:var(--bs-accent);">Works</em>
      </h2>

      <div style="display:grid;grid-template-columns:1fr;gap:0px;position:relative;">
        <div style="position:absolute;left:24px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--bs-accent),var(--bs-accent));"></div>

        <div style="display:flex;gap:24px;padding-bottom:40px;position:relative;">
          <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,var(--bs-accent),var(--bs-accent));display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;color:white;flex-shrink:0;position:relative;z-index:1;">1</div>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;flex:1;">
            <h3 style="color:white;font-size:1rem;margin-bottom:4px;">One Short Call</h3>
            <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.6;">We agree the terms, you get the price list and the intake form, and you are a partner the same day. No volume commitment, no exclusivity, no minimum.</p>
          </div>
        </div>

        <div style="display:flex;gap:24px;padding-bottom:40px;position:relative;">
          <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,var(--bs-accent),var(--bs-accent));display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;color:white;flex-shrink:0;position:relative;z-index:1;">2</div>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;flex:1;">
            <h3 style="color:white;font-size:1rem;margin-bottom:4px;">You Sell It Your Way</h3>
            <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.6;">Your pitch, your client, your price. We stay out of the conversation entirely. If you need a demo or a technical answer, we give you one to deliver yourself.</p>
          </div>
        </div>

        <div style="display:flex;gap:24px;padding-bottom:40px;position:relative;">
          <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,var(--bs-accent),var(--bs-accent));display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;color:white;flex-shrink:0;position:relative;z-index:1;">3</div>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;flex:1;">
            <h3 style="color:white;font-size:1rem;margin-bottom:4px;">We Build It Under Your Brand</h3>
            <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.6;">You send the intake, we confirm the quote in writing, then build. Base Agent is about 15 minutes plus a call to connect accounts, receptionists go live in 1 to 3 days, websites in 2 to 3 days.</p>
          </div>
        </div>

        <div style="display:flex;gap:24px;padding-bottom:0;position:relative;">
          <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,var(--bs-accent),var(--bs-accent));display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;color:white;flex-shrink:0;position:relative;z-index:1;">4</div>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;flex:1;">
            <h3 style="color:white;font-size:1rem;margin-bottom:4px;">You Invoice, You Keep The Margin</h3>
            <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.6;">Half of your wholesale price on order, half at launch. We stay the second line of support behind you, so you always have someone to hand a technical problem to.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="padding:80px 0">
    <div class="container" style="max-width:760px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:48px;text-transform:uppercase;">
        Common <em style="font-style:normal;color:var(--bs-accent);">Questions</em>
      </h2>

      <div style="display:grid;gap:16px;">
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:8px;">Do I need technical knowledge?</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">No. You sell and you keep the relationship. We build, run and fix everything technical, and we answer the technical questions so you can pass them on in your own words.</p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:8px;">Will my client know Birky Studio exists?</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">No. Nothing they receive carries our name, and we do not contact them. If you want co-branding instead, say so before the first launch and we set it up that way.</p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:8px;">Is there a minimum, or a volume commitment?</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">None. One client is a valid start. No exclusivity either, so nobody is blocked out of a city or a niche.</p>
        </div>

