---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: "Antigua Real Estate Development",
    subtitle: "Real Estate Agency",
    url: "https://antiguarealestatedevelopment.com",
    image: "/images/portfolio/ard-screenshot.png",
    description: "Full real estate website for an expat-focused agency in Antigua Guatemala. Bilingual (EN/ES), property listings with galleries, blog with SEO articles, client reviews, WhatsApp integration, and built-in lightbox for property photos.",
    tags: ["Real Estate", "Bilingual", "Blog", "SEO", "WhatsApp"],
    plan: "Professional",
  },
  {
    title: "Watalam Guatemala",
    subtitle: "Ecotourism & Community Adventures",
    url: "https://watalam-site.vercel.app",
    image: "/images/portfolio/watalam-screenshot.png",
    description: "Community-based ecotourism website near Antigua Guatemala. Bilingual (EN/ES) with language toggle, adventure tour packages with Quetzal pricing, photo gallery, traveler reviews, and WhatsApp booking.",
    tags: ["Ecotourism", "Bilingual", "Gallery", "WhatsApp", "Community"],
    plan: "Professional",
  },
  {
    title: "Birky Studio",
    subtitle: "Digital Agency. Websites & AI Agents",
    url: "https://birkystudio.com",
    image: "/images/portfolio/birkystudio-screenshot.png",
    description: "Our own agency website showcasing all three products, website design, AI agent setup, and AI receptionist. Features a live AI demo in the hero, full bilingual support, comprehensive pricing, and a complete blog with daily SEO content.",
    tags: ["Agency", "AI Demo", "Bilingual", "Blog", "SEO"],
    plan: "Professional",
  },
  {
    title: "The Base Agent, Realtor",
    subtitle: "Private Client. Full Automation",
    url: "/contact",
    image: null,
    isAgentCase: true,
    description: "Complete AI assistant installation for a US-based real estate agent. Includes a Notion CRM built for agents, email management with follow-ups, Google Business Profile content automation, and bilingual WhatsApp + Telegram. Saves the client approximately 8 hours per week.",
    tags: ["AI Agent", "Notion CRM", "Automation", "Bilingual", "Real Estate"],
    plan: "The Base Agent",
  },
  {
    title: "AI Voice Receptionist Demo",
    subtitle: "Try Elliot. Birky Studio Voice Agent",
    url: "https://vapi.ai?demo=true&shareKey=60d98cd1-2e54-45ca-adb0-393aa7fa8091&assistantId=90c9ce2b-461e-4b8e-b20f-bae3cf05a5e1",
    image: null,
    isLiveDemo: true,
    description: "Live interactive demo of Elliot, an AI voice agent for real estate and small business. Answers questions about Birky Studio's services, handles service inquiries, books demos, and handles bilingual calls 24/7. Built with Vapi.ai, 92% humanness.",
    tags: ["AI Voice", "Bilingual", "24/7", "Real Estate", "Vapi", "Elliot"],
    plan: "Voice Receptionist",
  },
  {
    title: "AI Assistant Demo",
    subtitle: "Live Demo. Try the Text Assistant",
    url: "/ai-demo",
    image: null,
    isEmbedDemo: true,
    description: "Live demo of the Birky Studio WhatsApp assistant for small businesses. Ask it what it does, what it costs, how setup works, or how it handles bookings and enquiries, and it answers like a real conversation, in English or Spanish.",
    tags: ["AI Agent", "Bilingual", "24/7", "WhatsApp", "Live Demo"],
    plan: "Text Receptionist",
  },
  {
    title: "The Base Agent, Boutique",
    subtitle: "Sample. Customer Support Automation",
    url: "/contact",
    image: null,
    isAgentCase: true,
    description: "AI agent setup for a local Antigua boutique. Handles WhatsApp customer inquiries 24/7 in English and Spanish, automates FAQ responses, manages order inquiries, schedules appointments, and drafts email responses. One-time setup, works through standard WhatsApp.",
    tags: ["AI Agent", "Customer Support", "Bilingual", "WhatsApp", "Automation"],
    plan: "The Base Agent",
  },
];
---

<BaseLayout title="Portfolio" description="See our recent projects for small businesses, websites, AI agents, and voice receptionists. Real solutions, real results." image="/images/portfolio/birkystudio-screenshot.png">

  <!-- Hero -->
  <section style="padding:100px 0 80px;position:relative;overflow:hidden">
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 20% 50%,rgba(255,45,149,0.15),transparent 50%),radial-gradient(circle at 80% 50%,rgba(255,45,149,0.1),transparent 50%);"></div>
    <div class="container" style="position:relative;z-index:1;text-align:center;">
      <div style="display:inline-block;padding:8px 20px;background:rgba(255,255,255,0.1);border-radius:100px;color:var(--bs-accent);font-size:0.9rem;font-weight:500;margin-bottom:24px;">
        🎨 Real projects, real businesses, real results
      </div>
      <h1 style="font-size:clamp(2.2rem,5vw,3.5rem);font-weight:800;color:white;margin-bottom:20px;text-transform:uppercase;">
        Our <span style="color:var(--bs-accent);">Portfolio</span>
      </h1>
      <p style="font-size:1.2rem;color:var(--bs-text);max-width:650px;margin:0 auto;line-height:1.8;">
        Websites, AI agents, and voice receptionists, built for real businesses. Every solution delivered fast, bilingual, and built to grow.
      </p>
    </div>
  </section>

  <!-- Try Elliot Banner -->
  <section style="padding:60px 0;position:relative;overflow:hidden">
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 30% 50%,rgba(255,45,149,0.22),transparent 50%),radial-gradient(circle at 70% 50%,rgba(255,45,149,0.15),transparent 50%);"></div>
    <div class="container" style="position:relative;z-index:1;text-align:center;">
      <div style="display:inline-flex;align-items:center;gap:8px;padding:8px 20px;background:rgba(255,255,255,0.1);border-radius:100px;color:#f9a8d4;font-size:0.9rem;font-weight:500;margin-bottom:24px;">
        <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--bs-accent);animation:pulse 2s infinite;"></span>
        Live Demo. Try It Now
      </div>
      <h2 style="font-size:clamp(1.8rem,3vw,2.5rem);font-weight:800;color:white;margin-bottom:16px;text-transform:uppercase;">
        🎧 Call Elliot. Your AI <em style="font-style:normal;color:var(--bs-accent);">Voice Agent</em>
      </h2>
      <p style="font-size:1.1rem;color:var(--bs-text-muted);max-width:600px;margin:0 auto 32px;line-height:1.8;">
        No login, no signup. One click and Elliot picks up. Ask about properties, pricing, or just test it, it handles everything.
      </p>
      <a href="https://vapi.ai?demo=true&shareKey=60d98cd1-2e54-45ca-adb0-393aa7fa8091&assistantId=90c9ce2b-461e-4b8e-b20f-bae3cf05a5e1" target="_blank" rel="noopener" class="btn" style="display:inline-flex;align-items:center;gap:12px;font-size:1.2rem;padding:18px 40px;background:var(--bs-bg-raised);color:var(--bs-text);border-radius:100px;font-weight:700;box-shadow:0 8px 30px rgba(0,0,0,0.3);transition:transform 0.2s,box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 12px 40px rgba(0,0,0,0.4)'" onmouseout="this.style.transform='none';this.style.boxShadow='0 8px 30px rgba(0,0,0,0.3)'">
        <span style="font-size:1.5rem;">🎧</span>
        Call Elliot Now
        <span style="font-size:0.85rem;color:var(--bs-text);opacity:0.7;">(free, 2 min call)</span>
      </a>
      <p style="color:rgba(255,255,255,0.5);font-size:0.85rem;margin-top:16px;">92% humanness · Bilingual EN/ES · 24/7 available</p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section style="padding:100px 0">
    <div class="container">
      <div style="display:flex;flex-direction:column;gap:80px;">
        {projects.map((project, i) => (
          project.isEmbedDemo ? (
                      /* ═══ EMBEDDED LIVE DEMO CARD ═══
                         Added 27 Sep 2026: the ES portfolio already embedded the
                         /ai-demo assistant here; Luna asked for the same on the EN side. */
                      <div>
                        <div style="text-align:center;margin-bottom:40px;">
                          <div style="display:inline-block;padding:6px 14px;background:var(--bs-accent);border-radius:100px;color:white;font-size:0.8rem;font-weight:600;margin-bottom:16px;">
                            {project.plan}. Try It Live
                          </div>
                          <h2 style="font-size:2rem;color:white;margin-bottom:8px;text-transform:uppercase;">AI <em style="font-style:normal;color:var(--bs-accent);">Assistant</em> Demo</h2>
                          <p style="color:#f9a8d4;font-weight:600;font-size:1.05rem;margin-bottom:16px;">{project.subtitle}</p>
                          <p style="color:var(--bs-text-muted);line-height:1.8;font-size:1.05rem;max-width:700px;margin:0 auto 24px;">{project.description}</p>
                          <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:32px;">
                            {project.tags.map(tag => (
                              <span style="padding:6px 14px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.1);border-radius:100px;font-size:0.82rem;font-weight:500;color:var(--bs-text);">{tag}</span>
                            ))}
                          </div>
                        </div>
                        <div style="border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.1);max-width:440px;margin:0 auto;">
                          <div style="background:var(--bs-bg-raised);padding:12px 16px;display:flex;align-items:center;gap:8px;">
                            <div style="display:flex;gap:6px;">
                              <div style="width:10px;height:10px;border-radius:50%;background:#ef4444;"></div>
                              <div style="width:10px;height:10px;border-radius:50%;background:#eab308;"></div>
                              <div style="width:10px;height:10px;border-radius:50%;background:#22c55e;"></div>
                            </div>
                            <div style="flex:1;background:var(--bs-bg-raised);border-radius:6px;padding:4px 12px;color:var(--bs-text-muted);font-size:0.75rem;font-family:monospace;text-align:center;">
                              birkystudio.com/ai-demo
                            </div>
                          </div>
                          <iframe src="/ai-demo" style="width:100%;height:520px;border:none;display:block;" title="AI Agent Demo" loading="lazy"></iframe>
                        </div>
                        <div style="text-align:center;margin-top:32px;">
                          <a href="/contact" class="btn btn-purple" style="display:inline-flex;font-size:1.05rem;padding:16px 32px;">
                            Get Your Own AI Agent →
                          </a>
                        </div>
                      </div>
          ) : project.isLiveDemo ? (
                      /* ═══ LIVE DEMO CARD ═══ */
                      <div>
                        <div style="text-align:center;margin-bottom:40px;">
                          <div style="display:inline-block;padding:6px 14px;background:var(--bs-accent);border-radius:100px;color:white;font-size:0.8rem;font-weight:600;margin-bottom:16px;">
                            🤖 {project.plan}. Try It Live
                          </div>
                          <h2 style="font-size:2rem;color:white;margin-bottom:8px;text-transform:uppercase;">AI Voice <em style="font-style:normal;color:var(--bs-accent);">Receptionist</em> Demo</h2>
                          <p style="color:white;font-weight:600;font-size:1.05rem;margin-bottom:16px;">{project.subtitle}</p>
                          <p style="color:var(--bs-text-muted);line-height:1.8;font-size:1.05rem;max-width:700px;margin:0 auto 24px;">{project.description}</p>
                          <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:32px;">
                            {project.tags.map(tag => (
                              <span style="padding:6px 14px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.1);border-radius:100px;font-size:0.82rem;font-weight:500;color:var(--bs-text);">{tag}</span>
                            ))}
                          </div>
                        </div>
                        <div style="border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.3);border:1px solid rgba(255,45,149,0.3);max-width:500px;margin:0 auto;padding:60px 40px;text-align:center;background:linear-gradient(135deg,rgba(255,45,149,0.07),rgba(255,45,149,0.05));">
                          <div style="font-size:5rem;margin-bottom:20px;">🎧</div>
                          <h3 style="font-size:1.5rem;color:white;margin-bottom:12px;">Call Elliot Right Now</h3>
                          <p style="color:var(--bs-text-muted);margin-bottom:32px;line-height:1.7;">No login, no signup, no download. One click and Elliot picks up. Try asking about properties, pricing, or just test it with something weird, it handles it.</p>
                          <a href={project.url} target="_blank" rel="noopener" class="btn btn-purple" style="display:inline-flex;font-size:1.2rem;padding:18px 36px;">
                            🎧 Call the Voice Agent →
                          </a>
                        </div>
                        <div style="text-align:center;margin-top:32px;">
                          <a href="/contact" class="btn btn-purple" style="display:inline-flex;font-size:1.05rem;padding:16px 32px;">
                            Get Your Own AI Agent →
                          </a>
                        </div>
                      </div>
          ) : project.isAgentCase ? (
            /* ═══ AGENT CASE STUDY CARD ═══ */
            <div>
              <div style="display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:center;" class="project-row">
                <div style="order:2;">
                  <div style="background:linear-gradient(rgba(2,6,23,0.55),rgba(2,6,23,0.55)),url('/images/portfolio/luna-portrait.jpg');background-size:cover;background-position:center;border:1px solid rgba(255,45,149,0.3);border-radius:24px;padding:48px;text-align:center;">
                    <div style="font-size:4rem;margin-bottom:16px;">🤖</div>
                    <div style="color:var(--bs-accent);font-size:0.9rem;font-weight:600;">AI Agent Installation</div>
                    <div style="color:var(--bs-text);font-size:0.85rem;margin-top:8px;">Private Client. Details Confidential</div>
                  </div>
                </div>
                <div style="order:1;">
                  <div style="display:inline-block;padding:6px 14px;background:var(--bs-accent);border-radius:100px;color:white;font-size:0.8rem;font-weight:600;margin-bottom:16px;">
                    {project.plan} Plan
                  </div>
                  <h2 style="font-size:2rem;color:white;margin-bottom:8px;">{project.title}</h2>
                  <p style="color:#f9a8d4;font-weight:600;font-size:1.05rem;margin-bottom:20px;">{project.subtitle}</p>
                  <p style="color:var(--bs-text-muted);line-height:1.8;font-size:1.05rem;margin-bottom:24px;">{project.description}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px;">
                    {project.tags.map(tag => (
                      <span style="padding:6px 14px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.1);border-radius:100px;font-size:0.82rem;font-weight:500;color:var(--bs-text);">{tag}</span>
                    ))}
                  </div>
                  <a href="/contact" class="btn btn-purple" style="display:inline-flex;">
                    Get a Similar Setup →
                  </a>
                </div>
              </div>
            </div>
          ) : (
            /* ═══ WEBSITE CARD ═══ */
            <div style={`display:grid;grid-template-columns:${i % 2 === 0 ? '1.2fr 1fr' : '1fr 1.2fr'};gap:48px;align-items:center;`} class="project-row">
              {/* Screenshot */}
              <div style={`${i % 2 !== 0 ? 'order:2;' : ''}`}>
                {project.image ? (
                  <a href={project.url} target="_blank" rel="noopener" style="display:block;border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.1);transition:transform 0.3s,box-shadow 0.3s;" class="project-image">
                    <div style="background:var(--bs-bg-raised);padding:12px 16px;display:flex;align-items:center;gap:8px;">
                      <div style="display:flex;gap:6px;">
                        <div style="width:10px;height:10px;border-radius:50%;background:#ef4444;"></div>
                        <div style="width:10px;height:10px;border-radius:50%;background:#eab308;"></div>
                        <div style="width:10px;height:10px;border-radius:50%;background:#22c55e;"></div>
                      </div>
                      <div style="flex:1;background:var(--bs-bg-raised);border-radius:6px;padding:4px 12px;color:var(--bs-text-muted);font-size:0.75rem;font-family:monospace;">
                        {project.url.replace('https://', '')}
                      </div>
                    </div>
                    <img src={project.image} alt={`${project.title} website preview`} style="width:100%;height:320px;object-fit:cover;display:block;" loading="lazy" />
                  </a>
                ) : (
                  <a href={project.url} target="_blank" rel="noopener" style="display:block;border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.1);">
                    <div style="background:var(--bs-bg-raised);padding:12px 16px;display:flex;align-items:center;gap:8px;">
                      <div style="display:flex;gap:6px;">
                        <div style="width:10px;height:10px;border-radius:50%;background:#ef4444;"></div>
                        <div style="width:10px;height:10px;border-radius:50%;background:#eab308;"></div>
                        <div style="width:10px;height:10px;border-radius:50%;background:#22c55e;"></div>
                      </div>
                      <div style="flex:1;background:var(--bs-bg-raised);border-radius:6px;padding:4px 12px;color:var(--bs-text-muted);font-size:0.75rem;font-family:monospace;">
                        {project.url.replace('https://', '')}
                      </div>
                    </div>
                    <div style="background:linear-gradient(135deg,rgba(255,45,149,0.1),rgba(255,45,149,0.1));padding:80px 40px;text-align:center;">
                      <div style="font-size:3rem;margin-bottom:12px;">🌐</div>
                      <div style="color:var(--bs-text);font-size:1rem;font-weight:500;">{project.title}</div>
                      <div style="color:var(--bs-accent);font-size:0.85rem;margin-top:8px;">Visit Site →</div>
                    </div>
                  </a>
                )}
              </div>

              {/* Info */}
              <div style={`${i % 2 !== 0 ? 'order:1;' : ''}`}>
                <div style="display:inline-block;padding:6px 14px;background:linear-gradient(135deg,var(--bs-accent),var(--bs-accent));border-radius:100px;color:white;font-size:0.8rem;font-weight:600;margin-bottom:16px;">
                  {project.plan} Plan
                </div>
                <h2 style="font-size:2rem;color:white;margin-bottom:8px;">{project.title}</h2>
                <p style="color:#f9a8d4;font-weight:600;font-size:1.05rem;margin-bottom:20px;">{project.subtitle}</p>
                <p style="color:var(--bs-text-muted);line-height:1.8;font-size:1.05rem;margin-bottom:24px;">{project.description}</p>
                
                <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px;">
                  {project.tags.map(tag => (
                    <span style="padding:6px 14px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.1);border-radius:100px;font-size:0.82rem;font-weight:500;color:var(--bs-text);">{tag}</span>
                  ))}
                </div>

                <a href={project.url} target="_blank" rel="noopener" class="btn btn-purple" style="display:inline-flex;">
                  View Live Site →
                </a>
              </div>
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section style="padding:80px 0">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:32px;text-align:center;">
        <div>
          <div style="font-size:2.5rem;font-weight:800;color:white;">10+</div>
          <div style="color:var(--bs-text-muted);font-size:0.95rem;margin-top:4px;">Solutions Deployed</div>
        </div>
        <div>
          <div style="font-size:2.5rem;font-weight:800;color:white;">100%</div>
          <div style="color:var(--bs-text-muted);font-size:0.95rem;margin-top:4px;">Client Satisfaction</div>
        </div>
        <div>
          <div style="font-size:2.5rem;font-weight:800;color:white;">EN/ES</div>
          <div style="color:var(--bs-text-muted);font-size:0.95rem;margin-top:4px;">Bilingual Ready</div>
        </div>
        <div>
          <div style="font-size:2.5rem;font-weight:800;color:white;">2-3</div>
          <div style="color:var(--bs-text-muted);font-size:0.95rem;margin-top:4px;">Days to Deliver</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding:100px 0;text-align:center;position:relative;overflow:hidden">
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 30% 50%,rgba(255,45,149,0.15),transparent 50%);"></div>
    <div class="container" style="position:relative;z-index:1;">
      <h2 style="font-size:2.5rem;color:white;margin-bottom:16px;text-transform:uppercase;">Want a Solution <em style="font-style:normal;color:var(--bs-accent);">Like These?</em></h2>
      <p style="color:var(--bs-text);font-size:1.15rem;max-width:550px;margin:0 auto 40px;line-height:1.8;">
        Let's build something amazing for your business. Fast delivery, professional design, and affordable pricing.
      </p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/contact" class="btn btn-purple" style="font-size:1.1rem;padding:18px 36px;">
          Start Your Project →
        </a>
        <a href="/#pricing-websites" class="btn" style="background:transparent;color:white;border:2px solid rgba(255,255,255,0.3);font-size:1.1rem;padding:18px 36px;">
          View Plans →
        </a>
      </div>
    </div>
  </section>

  <style>
    .project-image:hover {
      transform: translateY(-4px);
      box-shadow: 0 24px 70px rgba(0,0,0,0.4) !important;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.3); }
    }
    @media (max-width: 768px) {
      .project-row {
        grid-template-columns: 1fr !important;
      }
      .project-row > div {
        order: unset !important;
      }
    }
  </style>
</BaseLayout>