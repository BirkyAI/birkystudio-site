---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Case Studies & Portfolio" description="Birky Studio case studies built through running our own real estate agency in Antigua Guatemala. AI agents, bilingual websites, and a live AI receptionist. Real work, honestly told." image="/images/portfolio/og-portfolio-en.jpg">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Birky Studio case studies",
    "description": "Case studies built from running Birky Studio and Antigua Real Estate Development day to day: an AI-runs-the-agency setup, a real lead-to-listings flow, a bilingual client website, and an in-house AI voice assistant.",
    "url": "https://birkystudio.com/portfolio/",
    "isPartOf": { "@type": "WebSite", "name": "Birky Studio", "url": "https://birkystudio.com/" },
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Antigua Real Estate Development: running the whole agency on AI", "url": "https://antiguarealestatedevelopment.com/" },
        { "@type": "ListItem", "position": 2, "name": "One lead form, three listings: AI lead capture to closed leads" },
        { "@type": "ListItem", "position": 3, "name": "Watalam Guatemala: a bilingual community ecotourism website", "url": "https://watalamguatemala.com/" },
        { "@type": "ListItem", "position": 4, "name": "Elliot: Birky Studio's in-house AI voice assistant" }
      ]
    }
  })}></script>

  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow"><span class="dot"></span>Built from running my own agency</div>
      <h1 class="h1">Proof, not <em>promise.</em></h1>
      <p class="lead"><b>Birky Studio builds and installs done-for-you AI agents and bilingual websites for small businesses.</b> This portfolio of case studies comes from running our own agency, Antigua Real Estate Development, day to day. Few paying clients yet, and I will be honest about that. Everything here is real: real customers, live products, and real lead flow, not a sales pitch.</p>
    </div>
  </section>

  <div class="wrap">
    <!-- Case 1 · ARD -->
    <div class="sec-label">Case study 01 · <b>Built and running</b></div>
    <article class="case">
      <span class="kind"><span class="pk">●</span> Antigua Real Estate Development · Flagship</span>
      <h2 class="h2">Running the whole agency on the Base Agent.</h2>
      <div class="lead">
        <div class="pb">
          <h3>The problem</h3>
          <p>A solo real-estate agency in Antigua Guatemala had <b>no online presence, no listing workflow,</b> and no way to answer enquiries fast enough to win sellers.</p>
        </div>
        <div class="sol">
          <h3>What I built</h3>
          <p>A bilingual (EN/ES) site with property listings, photo galleries, a daily SEO blog, WhatsApp lead capture, and structured data for Google, all run on the Notion system that <b>runs my agency.</b></p>
          <ul>
            <li>Live bilingual property listings</li>
            <li>Daily SEO content engine</li>
            <li>Notion lead pipeline end to end</li>
            <li>A live AI voice agent taking calls 24/7</li>
          </ul>
        </div>
      </div>
      <div class="metrics">
        <div class="metric"><div class="n">EN/ES</div><div class="l">Bilingual site</div></div>
        <div class="metric"><div class="n">24/7</div><div class="l">Live voice agent</div></div>
        <div class="metric"><div class="n">100%</div><div class="l">Run on Notion</div></div>
      </div>
      <div class="tools">
        <span class="tool">Astro</span><span class="tool">Vercel</span><span class="tool">Notion</span><span class="tool">Vapi voice</span><span class="tool">WhatsApp</span><span class="tool">GA4</span><span class="tool">SEO / AEO</span>
      </div>
      <div class="cfoot">
        <a class="visit" href="https://antiguarealestatedevelopment.com" target="_blank" rel="noopener">View the live site →</a>
        <span class="note">This is the business this portfolio runs on.</span>
      </div>
    </article>

    <!-- Case 2 · Juan -->
    <div class="sec-label">Case study 02 · <b>Real lead</b></div>
    <article class="case">
      <span class="kind"><span class="pk">●</span> Lead to closed · The Base Agent</span>
      <h2 class="h2">One lead form, three listings.</h2>
      <div class="lead">
        <div class="pb">
          <h3>The problem</h3>
          <p>Sellers give their listing to whoever <b>answers first and reliably.</b> A slow reply loses the deal before the first phone call.</p>
        </div>
        <div class="sol">
          <h3>What happened</h3>
          <p>A seller submitted the site's lead form. The enquiry landed in the Notion pipeline and I replied <b>within 5 minutes.</b> After one in-person visit, he had committed three properties to sell through ARD.</p>
          <ul>
            <li>Lead form to capture to instant response</li>
            <li>CRM follow-up on track</li>
            <li>One visit turned the enquiry into listings</li>
          </ul>
        </div>
      </div>
      <div class="metrics">
        <div class="metric"><div class="n">5 min</div><div class="l">First reply</div></div>
        <div class="metric"><div class="n">1</div><div class="l">In-person visit</div></div>
        <div class="metric"><div class="n">3</div><div class="l">Listings won</div></div>
      </div>
      <div class="tools">
        <span class="tool">Lead form</span><span class="tool">WhatsApp</span><span class="tool">Notion CRM</span><span class="tool">The Base Agent</span>
      </div>
      <div class="cfoot">
        <span class="note">One real instance, not a manufactured metric. This is exactly how the system is built to behave every time.</span>
      </div>
    </article>

    <!-- Case 3 · Watalam -->
    <div class="sec-label">Case study 03 · <b>Client website</b></div>
    <article class="case">
      <span class="kind"><span class="pk">●</span> Watalam Guatemala · First client</span>
      <h2 class="h2">A community ecotourism site that speaks to travellers.</h2>
      <div class="lead">
        <div class="pb">
          <h3>The problem</h3>
          <p>A community ecotourism venture near Antigua needed a <b>serious web presence</b> to reach international travellers who do not read Spanish, and to make booking easy.</p>
        </div>
        <div class="sol">
          <h3>What I built</h3>
          <p>A bilingual (EN/ES) site, with adventure packages priced in Quetzales, a photo gallery, traveller reviews, and direct WhatsApp booking.</p>
          <ul>
            <li>Full EN/ES language toggle</li>
            <li>Packages and prices in Quetzales</li>
            <li>WhatsApp booking in one tap</li>
          </ul>
        </div>
      </div>
      <div class="metrics">
        <div class="metric"><div class="n">EN/ES</div><div class="l">Bilingual site</div></div>
        <div class="metric"><div class="n">Q</div><div class="l">Local pricing</div></div>
        <div class="metric"><div class="n">1 tap</div><div class="l">WhatsApp booking</div></div>
      </div>
      <div class="tools">
        <span class="tool">Astro</span><span class="tool">Vercel</span><span class="tool">WhatsApp</span><span class="tool">i18n</span>
      </div>

      <div class="review">
        <div class="stars">★★★★★</div>
        <p class="q">"Luna built the website for our ecotourism project, Watalam Guatemala. She understood what we do from the first conversation and never made it technical. The site is in English and Spanish, our adventures show prices in Quetzales, and travelers can book us straight on WhatsApp. It looks professional and it finally feels like us."</p>
        <div class="who"><b>Lesli Tahón</b>, owner of Watalam Guatemala · 5 stars on Google
          <a href="https://www.google.com/maps/search/?api=1&query=Birky%20Studio%20Antigua%20Guatemala&query_place_id=ChIJ9-RD-HRNkQARtg1Z7VtB2zM" target="_blank" rel="noopener">See it on Google →</a>
        </div>
      </div>
      <div class="cfoot">
        <a class="visit" href="https://watalamguatemala.com" target="_blank" rel="noopener">View the live site →</a>
        <span class="note">My first paying client. The review is genuine and unprompted.</span>
      </div>
    </article>

    <!-- Case 4 · Elliot -->
    <div class="sec-label">Case study 04 · <b>In-house</b></div>
    <article class="case">
      <span class="kind"><span class="pk">●</span> Birky Studio · Elliot, our own assistant</span>
      <h2 class="h2">We built Elliot to run our own front desk.</h2>
      <div class="lead">
        <div class="pb">
          <h3>The problem</h3>
          <p>Birky Studio is a one-person agency. When I am on a build or a site visit, calls and WhatsApp enquiries went unanswered, especially <b>after hours and in Spanish.</b></p>
        </div>
        <div class="sol">
          <h3>What I built</h3>
          <p>Elliot, a live Vapi voice agent, now runs our own front desk. He answers questions about our services and pricing, confirms the caller's details accurately, and knows when to end the call.</p>
          <ul>
            <li>Runs our own front desk</li>
            <li>Bilingual, EN and Spanish, 24/7</li>
            <li>Every update is tested on ourselves first</li>
          </ul>
        </div>
      </div>
      <div class="metrics">
        <div class="metric"><div class="n">24/7</div><div class="l">Always on</div></div>
        <div class="metric"><div class="n">EN/ES</div><div class="l">Bilingual</div></div>
        <div class="metric"><div class="n">1st</div><div class="l">Our own client</div></div>
      </div>
      <div class="tools">
        <span class="tool">Vapi</span><span class="tool">US phone line</span><span class="tool">Tuned voice prompt</span>
      </div>
      <div class="cfoot">
        <a class="visit" href="https://vapi.ai?demo=true&shareKey=60d98cd1-2e54-45ca-adb0-393aa7fa8091&assistantId=90c9ce2b-461e-4b8e-b20f-bae3cf05a5e1" target="_blank" rel="noopener">Call Elliot now →</a>
        <span class="note">Our own assistant, live. No login, one click.</span>
      </div>
    </article>

    <!-- Capability strip -->
    <div class="sec-label">What I do</div>
    <div class="caps">
      <div class="cap"><h4>AI Agent setup</h4><p>Notion CRM, email follow-ups, WhatsApp and Telegram, Google Business Profile content. The Base Agent.</p></div>
      <div class="cap"><h4>Bilingual websites</h4><p>EN/ES builds with SEO and AEO ready out of the box. No coding needed on your side.</p></div>
      <div class="cap"><h4>AI voice receptionists</h4><p>24/7 bilingual voice agents that take real calls, not just demos.</p></div>
      <div class="cap"><h4>Content engine</h4><p>A daily SEO blog and Google Business posting that keep sites working for you.</p></div>
    </div>

    <!-- Honesty -->
    <div class="honest">
      <h3>Where I am today</h3>
      <p>I am early, and I am not going to hide it. Birky Studio is a small operation and paying clients so far number one. What you see above is not a wall of client logos. It is <b>real operational experience from running my own real estate agency</b>, plus the real clients and live products I have. That is worth more to me, and to you, than a made-up track record.</p>
    </div>
  </div>

  <!-- CTA -->
  <section class="cta">
    <h2 class="cta-h">Want a setup <em>like these?</em></h2>
    <p>Tell me what your business does and I will show you, honestly, what would help and what would not.</p>
    <a href="/contact" class="btn btn-white">Start the conversation →</a>
  </section>

  <style>
    .wrap{max-width:1080px;margin:0 auto;padding:0 48px}
    .hero{padding:110px 0 70px}
    .eyebrow{display:inline-flex;align-items:center;gap:9px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--bs-accent);border:1px solid rgba(255,45,149,.35);background:rgba(255,45,149,.07);border-radius:999px;padding:7px 15px;margin-bottom:28px}
    .dot{width:7px;height:7px;border-radius:50%;background:var(--bs-accent)}
    .h1{font-size:clamp(38px,5vw,56px);font-weight:900;line-height:1.05;letter-spacing:-.02em;text-transform:uppercase;margin-bottom:26px}
    .h1 em,.h2 em,.cta-h em{font-style:normal;color:var(--bs-accent)}
    .hero .lead{color:var(--bs-text-muted);font-size:17px;max-width:660px;line-height:1.8}
    .hero .lead b{color:var(--bs-text);font-weight:600}
    .sec-label{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--bs-text-muted);margin:72px 0 8px}
    .sec-label b{color:var(--bs-accent)}
    .case{background:rgba(255,255,255,.03);border:1px solid var(--bs-border);border-radius:22px;padding:40px 44px;margin-top:16px;margin-bottom:48px}
    .kind{display:inline-block;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--bs-text-muted);border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:5px 12px;margin-bottom:18px}
    .kind .pk{color:var(--bs-accent)}
    .h2{font-size:clamp(26px,3vw,34px);font-weight:800;line-height:1.15;letter-spacing:-.01em;margin-bottom:30px}
    .lead{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-bottom:30px}
    .pb h3,.sol h3{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--bs-accent);margin-bottom:8px;font-weight:700}
    .pb p,.sol p{color:var(--bs-text-muted);font-size:15px}
    .pb p b,.sol p b{color:var(--bs-text);font-weight:600}
    .sol ul{margin-top:12px;display:flex;flex-direction:column;gap:10px}
    .sol li{color:var(--bs-text-muted);font-size:15px;list-style:none;display:flex;gap:10px}
    .sol li::before{content:"";flex:none;width:6px;height:6px;border-radius:50%;background:var(--bs-accent);margin-top:9px}
    .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:26px}
    .metric{background:rgba(255,45,149,.06);border:1px solid rgba(255,45,149,.18);border-radius:14px;padding:16px 18px}
    .metric .n{font-size:26px;font-weight:900;letter-spacing:-.02em;line-height:1}
    .metric .l{font-size:12px;color:var(--bs-text-muted);margin-top:6px;text-transform:uppercase;letter-spacing:.05em}
    .tools{display:flex;flex-wrap:wrap;gap:8px}
    .tool{font-size:12px;font-weight:500;color:var(--bs-text-muted);border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:5px 12px}
    .cfoot{margin-top:26px;padding-top:22px;border-top:1px solid rgba(255,255,255,.07);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
    .visit{color:var(--bs-accent);font-size:14px;font-weight:600;text-decoration:none;text-transform:uppercase;letter-spacing:.04em}
    .visit:hover{color:var(--bs-accent-2)}
    .note{font-size:12.5px;color:var(--bs-text-muted);font-style:italic}
    .review{background:rgba(255,255,255,.04);border:1px solid rgba(255,45,149,.2);border-left:3px solid var(--bs-accent);border-radius:16px;padding:26px 30px;margin-top:26px}
    .review .stars{color:var(--bs-accent);font-size:15px;letter-spacing:2px;margin-bottom:10px}
    .review .q{font-size:15px;font-style:italic;line-height:1.8;margin-bottom:12px}
    .review .who{font-size:13px;color:var(--bs-text-muted)}
    .review .who b{color:var(--bs-text);font-weight:600}
    .review .who a{color:var(--bs-accent);font-size:12.5px;font-weight:600;text-decoration:none;text-transform:uppercase;letter-spacing:.04em;margin-left:8px}
    .caps{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:12px}
    .cap{background:rgba(255,255,255,.02);border:1px solid var(--bs-border);border-radius:14px;padding:18px 22px}
    .cap h4{font-size:13px;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;font-weight:700}
    .cap p{font-size:13.5px;color:var(--bs-text-muted);line-height:1.6}
    .honest{background:rgba(255,255,255,.03);border:1px solid var(--bs-border);border-radius:20px;padding:34px 38px;margin:52px 0 0}
    .honest h3{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--bs-accent);margin-bottom:12px;font-weight:700}
    .honest p{color:var(--bs-text-muted);font-size:15px;line-height:1.85;max-width:820px}
    .honest p b{color:var(--bs-text);font-weight:600}
    .cta{padding:110px 0;text-align:center}
    .cta-h{font-size:32px;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;margin-bottom:14px}
    .cta p{color:var(--bs-text-muted);max-width:520px;margin:0 auto 32px;font-size:16px}
    @media(max-width:760px){
      .wrap{padding:0 24px}
      .lead{grid-template-columns:1fr;gap:28px}
      .metrics{grid-template-columns:1fr;gap:12px}
      .caps{grid-template-columns:1fr}
      .hero{padding:80px 0 50px}
    }
  </style>
</BaseLayout>
