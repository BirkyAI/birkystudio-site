---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Free Verified Prospect List Sample"
  description="Get a free sample of a verified, scored prospect list. See the exact format: real owner data, equity estimates, and a motivation score, checked against public records. No subscription, no contract."
  image="/images/birky-logo.jpg"
>
  <section style="padding:100px 0 80px;position:relative;overflow:hidden">
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 20% 50%,rgba(255,45,149,0.15),transparent 50%),radial-gradient(circle at 80% 50%,rgba(255,45,149,0.1),transparent 50%);"></div>
    <div style="max-width:700px;margin:0 auto;padding:0 32px;position:relative;z-index:1;text-align:center;">
      <div style="font-size:3rem;margin-bottom:20px;">🎯</div>
      <h1 style="font-size:clamp(1.8rem,4vw,2.8rem);font-weight:800;color:white;margin-bottom:16px;line-height:1.15;">
        See the Exact List Before You Pay a Cent
      </h1>
      <p style="font-size:1.1rem;color:var(--bs-text);line-height:1.8;max-width:560px;margin:0 auto 32px;">
        A real sample of a verified prospect list. Real owner data, equity estimates, and a motivation score, checked against public records. Not a recycled CSV. Not a subscription. See it, use it, judge it.
      </p>
      <div style="display:flex;justify-content:center;">
        <a href="#get-sample" class="btn btn-primary" style="font-size:1.1rem;padding:16px 36px;">
          Get the Free Sample →
        </a>
      </div>
    </div>
  </section>

  <section style="padding:60px 0">
    <div style="max-width:700px;margin:0 auto;padding:0 32px;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px;text-align:center;">
        <div>
          <div style="font-size:2rem;font-weight:800;color:var(--bs-accent);">Verified</div>
          <div style="color:var(--bs-text-muted);font-size:0.9rem;">Checked against public records</div>
        </div>
        <div>
          <div style="font-size:2rem;font-weight:800;color:var(--bs-accent);">Scored</div>
          <div style="color:var(--bs-text-muted);font-size:0.9rem;">Equity + motivation, ranked</div>
        </div>
        <div>
          <div style="font-size:2rem;font-weight:800;color:var(--bs-accent);">Yours</div>
          <div style="color:var(--bs-text-muted);font-size:0.9rem;">One-time. No subscription.</div>
        </div>
      </div>
    </div>
  </section>

  <section style="padding:80px 0">
    <div style="max-width:700px;margin:0 auto;padding:0 32px;">
      <h2 style="font-size:1.6rem;font-weight:700;color:white;margin-bottom:24px;">Why Most "Leads" Are a Waste of Money</h2>
      <p style="color:var(--bs-text);line-height:1.8;margin-bottom:16px;">
        You pay top dollar for a lead, and the same one goes to five other agents in your ZIP. It's a rented introduction, not a prospect you own. And the moment you stop paying, the stream stops.
      </p>
      <p style="color:var(--bs-text);line-height:1.8;margin-bottom:24px;">
        A prospect list is different. It's a list of owners you can actually reach, ranked by who's most likely to sell, and it's yours to keep. No contract. No shared leads. No monthly fee.
      </p>
      <div style="padding:24px;background:rgba(255,45,149,0.1);border:1px solid rgba(255,45,149,0.3);border-radius:12px;">
        <p style="color:var(--bs-text);font-style:italic;margin:0;">
          "I got leads but did not close a single deal from them because they were all tire kickers and dreamers."
        </p>
        <p style="color:var(--bs-accent);font-size:0.85rem;margin-top:8px;">- A realtor on buying portal leads</p>
      </div>
    </div>
  </section>

  <section style="padding:80px 0">
    <div style="max-width:700px;margin:0 auto;padding:0 32px;">
      <h2 style="font-size:1.6rem;font-weight:700;color:white;margin-bottom:24px;">What's in the Sample</h2>
      <div style="display:grid;gap:20px;">
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;display:flex;gap:16px;align-items:flex-start;">
          <div style="font-size:1.8rem;flex-shrink:0;">✅</div>
          <div>
            <h3 style="color:white;font-weight:600;margin-bottom:6px;font-size:1.05rem;">Verified Owner Data</h3>
            <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.6;margin:0;">Name, address, phone, and email, matched against public records. Not a scraped guess.</p>
          </div>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;display:flex;gap:16px;align-items:flex-start;">
          <div style="font-size:1.8rem;flex-shrink:0;">📊</div>
          <div>
            <h3 style="color:white;font-weight:600;margin-bottom:6px;font-size:1.05rem;">Equity Estimate</h3>
            <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.6;margin:0;">How much equity each owner holds, so you know who can actually afford to sell.</p>
          </div>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;display:flex;gap:16px;align-items:flex-start;">
          <div style="font-size:1.8rem;flex-shrink:0;">🔥</div>
          <div>
            <h3 style="color:white;font-weight:600;margin-bottom:6px;font-size:1.05rem;">Motivation Score</h3>
            <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.6;margin:0;">A 0-100 score ranking who's most likely to sell, from signals like high equity, absentee owners, and expired listings.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="get-sample" style="padding:80px 0">
    <div style="max-width:500px;margin:0 auto;padding:0 32px;text-align:center;">
      <div style="font-size:2.5rem;margin-bottom:16px;">🎯</div>
      <h2 style="font-size:1.6rem;font-weight:700;color:white;margin-bottom:12px;">Get Your Free Sample</h2>
            <p style="color:var(--bs-text-muted);font-size:0.95rem;line-height:1.7;margin-bottom:32px;">
              Tell us your market and we'll send a sample list built for it. See the exact format and scoring before you decide anything.
            </p>
            <div style="display:flex;flex-direction:column;gap:12px;max-width:420px;margin:0 auto;">
              <input type="text" id="lead-name" placeholder="First name" style="width:100%;padding:14px 20px;border-radius:12px;border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.05);color:white;font-size:1rem;outline:none;box-sizing:border-box;" />
              <input type="email" id="lead-email" placeholder="your@email.com" style="width:100%;padding:14px 20px;border-radius:12px;border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.05);color:white;font-size:1rem;outline:none;box-sizing:border-box;" />
              <input type="text" id="lead-area" placeholder="Your market, e.g. Austin TX" style="width:100%;padding:14px 20px;border-radius:12px;border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.05);color:white;font-size:1rem;outline:none;box-sizing:border-box;" />
              <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;">
                <button type="button" onclick="setLeadType('seller')" id="type-seller" style="flex:1;min-width:90px;padding:12px 16px;border-radius:12px;border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.05);color:white;font-size:0.9rem;cursor:pointer;">Seller leads</button>
                <button type="button" onclick="setLeadType('buyer')" id="type-buyer" style="flex:1;min-width:90px;padding:12px 16px;border-radius:12px;border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.05);color:white;font-size:0.9rem;cursor:pointer;">Buyer leads</button>
                <button type="button" onclick="setLeadType('both')" id="type-both" style="flex:1;min-width:90px;padding:12px 16px;border-radius:12px;border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.05);color:white;font-size:0.9rem;cursor:pointer;">Both</button>
              </div>
              <button onclick="submitLead()" class="btn btn-primary" style="width:100%;padding:14px 28px;font-size:1rem;">
                Get the Sample →
              </button>
            </div>
            <p id="form-message" style="color:var(--bs-accent);font-size:0.9rem;margin-top:16px;display:none;"></p>
            <p style="color:var(--bs-text-muted);font-size:0.8rem;margin-top:12px;">No spam. Ever. Unsubscribe anytime.</p>
    </div>
  </section>

  <section style="padding:60px 0;text-align:center">
    <div style="max-width:600px;margin:0 auto;padding:0 32px;">
      <div style="font-size:1.8rem;margin-bottom:12px;">📦</div>
      <h2 style="font-size:1.5rem;color:white;margin-bottom:12px;">Want the Full List?</h2>
      <p style="color:var(--bs-text-muted);font-size:0.95rem;line-height:1.7;margin-bottom:8px;">
        The sample is a taste. The full Verified Prospect List is a scored, owned list for your market, delivered CRM-ready, with compliant outreach and an AI that answers the replies. One-time, yours forever.
      </p>
      <a href="/products/lead-generation-pack/" class="btn btn-primary" style="font-size:1rem;padding:14px 28px;">
        See the Full List →
      </a>
    </div>
  </section>

  <script is:inline>
      let leadType = 'both';
      window.setLeadType = function(t) {
        leadType = t;
        ['seller','buyer','both'].forEach(function(k) {
          var b = document.getElementById('type-' + k);
          if (b) {
            b.style.background = (k === t) ? 'rgba(255,45,149,0.35)' : 'rgba(255,255,255,0.05)';
            b.style.borderColor = (k === t) ? 'var(--bs-accent)' : 'rgba(255,255,255,0.2)';
          }
        });
      };
      window.submitLead = function() {
        const email = document.getElementById('lead-email').value.trim();
        const name = document.getElementById('lead-name').value.trim();
        const area = document.getElementById('lead-area').value.trim();
        const msg = document.getElementById('form-message');
      
        if (!email) {
          msg.style.color = '#f87171';
          msg.textContent = 'Please enter your email';
          msg.style.display = 'block';
          return;
        }
      
        // Send to the lead capture webhook
        fetch('https://script.google.com/macros/s/AKfycbyY6p6a7Mpve8MsSBx5R6RU1JbuNctGJHWC827dpbjpMeQOwXZlW8Bu01RXk8N0mvHr/exec', {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: name || 'Sample List Lead',
            email: email,
            phone: '',
            interest: 'Free Sample Prospect List',
            source: 'free-sample-list',
            area: area,
            leadType: leadType
          })
        });
      
        msg.style.color = 'var(--bs-accent)';
        msg.style.display = 'block';
        msg.innerHTML = '✅ Thanks! Here is your sample list:<br><br><a href="/sample-prospect-list.csv" target="_blank" style="color:var(--bs-accent);font-weight:600;font-size:1.2rem;">📄 Download the Sample List →</a><br><br><small style="color:var(--bs-text-muted);">Names and contacts are placeholders to show the format. Your real list is verified against public records.</small>';
      
        document.getElementById('lead-email').value = '';
        document.getElementById('lead-name').value = '';
        document.getElementById('lead-area').value = '';
      }
    </script>
</BaseLayout>
