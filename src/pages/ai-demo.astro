---
// AI Agent Demo. Birky Studio sales bot, real WhatsApp CTA.
// Standalone document on purpose: it is embedded as an iframe inside the
// portfolio cards (EN /portfolio and ES /es/portafolio), so it must not carry
// the site nav. It DOES need the brand tokens, which it did not used to have,
// so every var(--bs-*) silently collapsed and the page rendered as a plain
// white sheet with an invisible banner. Luna, 29 Sep 2026.
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Birky Studio. Live AI Demo</title>
  <meta name="description" content="Watch a real AI agent conversation: a WhatsApp chat with a real estate agent, answered by Birky Studio's AI in English and Spanish. Then try the real thing.">
  <link rel="canonical" href="https://birkystudio.com/ai-demo/">
  <meta property="og:title" content="Birky Studio. Live AI Demo">
  <meta property="og:description" content="Watch a real AI agent conversation: a WhatsApp chat with a real estate agent, answered by Birky Studio's AI in English and Spanish.">
  <meta property="og:image" content="https://birkystudio.com/images/birky-logo.jpg">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://birkystudio.com/ai-demo/">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style is:inline>
    /* Brand tokens, mirrored from src/styles/hero.css. This page is a standalone
       document, so it does not inherit them from BaseLayout. Without this block
       every var(--bs-*) below resolves to nothing. */
    :root {
      --bs-bg-deep: #150b26;
      --bs-bg-raised: #241340;
      --bs-border: rgba(255, 255, 255, .08);
      --bs-text: #f5f3f7;
      --bs-text-muted: #a79fbb;
      --bs-accent: #ff2d95;
      --bs-accent-2: #b0005a;
      --bs-btn-light: #e6e3ee;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bs-bg-deep);
      color: var(--bs-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* the same fixed 64px grid the rest of the site paints, so the embedded
       copy matches the page it sits in */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255, 255, 255, .06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, .06) 1px, transparent 1px);
      background-size: 64px 64px;
    }

    .demo-bar {
      position: relative;
      z-index: 1;
      background: linear-gradient(135deg, var(--bs-accent), var(--bs-accent-2));
      padding: 10px 20px;
      text-align: center;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      color: #fff;
      flex-shrink: 0;
    }

    .content {
      position: relative;
      z-index: 1;
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      padding: 18px 20px 20px;
    }

    .brand { text-align: center; flex-shrink: 0; }
    .wordmark {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bs-text-muted);
      margin-bottom: 6px;
    }
    .brand h1 {
      font-size: 1.5rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: #fff;
      margin-bottom: 8px;
    }
    .brand h1 em { font-style: normal; color: var(--bs-accent); }
    .brand p {
      font-size: 0.85rem;
      line-height: 1.55;
      color: var(--bs-text-muted);
      max-width: 340px;
      margin: 0 auto;
    }

    .phone-mockup {
      width: 100%;
      max-width: 380px;
      background: var(--bs-bg-raised);
      border-radius: 24px;
      padding: 18px;
      border: 1px solid rgba(255, 255, 255, .1);
      display: flex;
      flex-direction: column;
      gap: 10px;
      /* Must be able to shrink: the portfolio embeds this in a fixed-height
         iframe, and without this the panel keeps its natural height and the
         CTA below it gets clipped off the bottom of the frame. */
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
    }

    .chat-bubble {
      max-width: 88%;
      padding: 10px 14px;
      border-radius: 16px;
      font-size: 0.85rem;
      line-height: 1.55;
      animation: fadeIn 0.4s ease;
      flex-shrink: 0;
    }
    .chat-bubble.bot {
      background: rgba(255, 255, 255, .07);
      border: 1px solid rgba(255, 255, 255, .1);
      color: var(--bs-text);
      border-bottom-left-radius: 4px;
      align-self: flex-start;
    }
    .chat-bubble.user {
      background: var(--bs-accent);
      color: #fff;
      border-bottom-right-radius: 4px;
      align-self: flex-end;
    }
    .chat-bubble .time { display: block; font-size: 0.65rem; color: var(--bs-text-muted); margin-top: 4px; text-align: right; }
    .chat-bubble.user .time { color: rgba(255, 255, 255, 0.65); }

    .typing-dots {
      align-self: flex-start;
      padding: 8px 16px;
      background: rgba(255, 255, 255, .07);
      border: 1px solid rgba(255, 255, 255, .1);
      border-radius: 16px;
      border-bottom-left-radius: 4px;
      display: flex;
      gap: 4px;
      flex-shrink: 0;
    }
    .typing-dots span { width: 6px; height: 6px; background: var(--bs-text-muted); border-radius: 50%; animation: bounce 1.4s infinite; }
    .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
    .typing-dots span:nth-child(3) { animation-delay: 0.4s; }

    .actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      flex-wrap: wrap;
      flex-shrink: 0;
    }

    .try-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #25D366;
      color: white;
      padding: 13px 28px;
      border-radius: 100px;
      font-size: 0.95rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s;
      border: none;
      cursor: pointer;
    }
    .try-btn:hover { transform: scale(1.04); box-shadow: 0 8px 30px rgba(37,211,102,0.4); }
    .try-btn svg { width: 20px; height: 20px; flex-shrink: 0; }

    .qr-section { display: flex; flex-direction: column; align-items: center; gap: 6px; }
    .qr-section img { width: 84px; height: 84px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, .1); background: #fff; }
    .qr-section p { font-size: 0.7rem; color: var(--bs-text-muted); }

    /* Embedded in the portfolio card: the QR is pointless (the visitor is already
       on the site) and the header can go tighter, which buys height for the chat
       inside the fixed-height iframe. */
    body.embedded .qr-section { display: none; }
    body.embedded .brand p { display: none; }
    body.embedded .brand h1 { font-size: 1.2rem; }
    body.embedded .phone-mockup { max-width: 400px; padding: 16px; }
    body.embedded .chat-bubble { font-size: 0.81rem; padding: 9px 13px; }
    body.embedded .content { gap: 13px; padding: 15px 16px 17px; }

    @keyframes bounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-6px); } }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    @media (max-width: 460px) {
      .actions { flex-direction: column; gap: 12px; }
      .brand h1 { font-size: 1.25rem; }
      .qr-section img { width: 72px; height: 72px; }
      .phone-mockup { padding: 15px; }
      .chat-bubble { font-size: 0.82rem; }
    }
  </style>
</head>
<body>

<div class="demo-bar">Live demo. This is the real assistant, on WhatsApp.</div>

<div class="content">
  <div class="brand">
    <div class="wordmark">Birky.Studio</div>
    <h1>Live AI Agent <em>Demo</em></h1>
    <p>A real conversation with our WhatsApp assistant, in English or Spanish.</p>
  </div>

  <!-- Live Conversation Preview -->
  <div class="phone-mockup">
    <div class="chat-bubble bot">
      Hey! I'm Birky Studio's AI assistant. I can help with AI agents, receptionist plans, and websites. What's your business type?
      <span class="time">10:02 AM</span>
    </div>
    <div class="chat-bubble user">
      I'm a real estate agent in Antigua
      <span class="time">10:02 AM</span>
    </div>
    <div class="typing-dots"><span></span><span></span><span></span></div>
    <div class="chat-bubble bot" style="animation-delay: 0.2s;">
      Great, I work with lots of agents here. For a realtor the <strong>base agent is $1,297</strong>, and it includes a Notion CRM built for agents. Want me to walk you through what is included?
      <span class="time">10:02 AM</span>
    </div>
    <div class="chat-bubble user">
      Yeah tell me more
      <span class="time">10:03 AM</span>
    </div>
    <div class="typing-dots"><span></span><span></span><span></span></div>
    <div class="chat-bubble bot" style="animation-delay: 0.4s;">
      Sure. It catches every enquiry from your website and WhatsApp, qualifies the lead, saves it to your Notion CRM, sends you a summary with a draft reply, and follows up 2 days later if nobody answered. All bilingual EN/ES. Want to try the real thing on WhatsApp?
      <span class="time">10:03 AM</span>
    </div>
  </div>

  <div class="actions">
    <a href="https://wa.me/50234775110?text=Hi%20Birky%20Studio!%20I%20saw%20the%20demo%20on%20your%20website%20and%20want%20to%20try%20the%20real%20AI." target="_blank" rel="noopener" class="try-btn">
      <svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Try the Real AI on WhatsApp
    </a>

    <div class="qr-section">
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=https://wa.me/50234775110?text=Hi%20Birky%20Studio!%20I%20saw%20the%20demo%20on%20your%20website" alt="QR Code to try BirkyStudio on WhatsApp" loading="lazy">
      <p>Scan to try it now</p>
    </div>
  </div>
</div>

<script is:inline>
  // Inside the portfolio card the QR is redundant, and the tighter header buys
  // vertical room for the chat in the fixed-height iframe.
  if (window.self !== window.top) document.body.classList.add('embedded');
</script>

</body>
</html>
