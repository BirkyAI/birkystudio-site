function matchIntent(text) {
  const t = text.toLowerCase();
  if (/pric(e|ing)|precio|cuest|cost|cuánto|cuanto|how much|budget|presupuesto|rates?|tarif/.test(t)) return 'pricing';
  if (/websit(e|es)|site|web|págin|sitio|starter|basic|basico|profesional|premium/i.test(t)) return 'websites';
  if (/agent(e|s)?|ia|ai\b|ai agent|asistente|real estate|bienes raíces|corredor|realtor|real estate agent/i.test(t) && !/receptionist|recepcion/i.test(t)) return 'aiAgent';
  if (/real estate|bienes raíce|realtor|corredor|property|propiedad(es)?|listing/i.test(t) && /agent|ia|ai\b/i.test(t)) return 'realEstate';
  if (/receptionist|recepcion|recepcionista|voice|voz|phone|teléfono|telefono|llamad|call/i.test(t)) return 'receptionist';
  if (/timeline|tiempo|how long|cuánto tard|fast|rápid|delivery|entrega|day|días?/i.test(t)) return 'timeline';
  if (/process|proceso|cómo funcion|how.works|steps?|pasos?/i.test(t)) return 'process';
  if (/support|soporte|manten|maintenance|help|ayuda|training|entrenam/i.test(t)) return 'support';
  if (/guarantee|garant|risk|riesg|refund|reembol|safe|segur/i.test(t)) return 'guarantee';
  if (/vs\b|compared?|compar|different|versus|wix|squarespace|diferenc/i.test(t)) return 'compare';
  if (/contact|contacto|whatsapp|email|correo|message|mensaj|start|empezar|get started/i.test(t)) return 'contact';
  return 'default';
}

function getTime() {
  return new Date().toLocaleTimeString(currentLang === 'en' ? 'en-US' : 'es-GT', { hour: '2-digit', minute: '2-digit' });
}

function addMessage(text, sender) {
  const chat = document.getElementById('chat');
  const msg = document.createElement('div');
  msg.className = 'msg ' + sender;
  msg.innerHTML = text.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>') + '<span class="time">' + getTime() + '</span>';
  chat.appendChild(msg);
  chat.scrollTop = chat.scrollHeight;
}

function showTyping() {
  document.getElementById('typing').style.display = '';
}

function hideTyping() {
  document.getElementById('typing').style.display = 'none';
}

function sendMessage(text) {
  const input = document.getElementById('userInput');
  const message = text || input.value.trim();
  if (!message) return;
  if (!text) input.value = '';
  addMessage(message, 'user');
  document.getElementById('quickReplies').innerHTML = '';
  showTyping();
  setTimeout(() => {
    hideTyping();
    const intent = matchIntent(message);
    const response = knowledge[currentLang].responses[intent];
    addMessage(response, 'bot');
    setTimeout(() => showQuickReplies(), 500);
  }, 600 + Math.random() * 800);
}

function showQuickReplies() {
  const container = document.getElementById('quickReplies');
  const replies = knowledge[currentLang].quickReplies;
  container.innerHTML = replies.map(r =>
    '<button style="padding:8px 16px;border:1px solid #334155;border-radius:100px;background:#1e293b;color:#a5b4fc;font-size:0.82rem;font-weight:500;cursor:pointer;font-family:\'Inter\',sans-serif;" onclick="sendMessage(\'' + r.replace(/'/g, "\\'") + '\')">' + r + '</button>'
  ).join('');
}

function setLang(lang) {
  currentLang = lang;
  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.classList.toggle('active', btn.textContent.trim() === lang.toUpperCase());
  });
  document.getElementById('userInput').placeholder = knowledge[lang].inputPlaceholder;
  document.getElementById('chat').innerHTML = '';
  addMessage(knowledge[lang].greeting, 'bot');
  showQuickReplies();
}

document.getElementById('userInput').addEventListener('keydown', (e) => {
  if (e.key === 'Enter') sendMessage();
});

setLang('en');
</script>

