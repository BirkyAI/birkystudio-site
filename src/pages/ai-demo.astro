---
// AI Agent Demo. Birky Studio sales bot, real WhatsApp CTA.
// Standalone document on purpose: it is embedded as an iframe inside the
// portfolio cards (EN /portfolio and ES /es/portafolio), so it must not carry
// the site nav. It DOES need the brand tokens, which it did not used to have,
// so every var(--bs-*) silently collapsed and the page rendered as a plain
// white sheet with an invisible banner. Luna, 29 Sep 2026.
//
// Sep 2026 upgrade: four industry scenarios, bubble-by-bubble playback that
// reads like a screen recording, and a replay control.
// Spanish twin lives at src/pages/es/ai-demo.astro. Keep the SCENARIOS data in
// the two files in sync, and keep the prices matching the live site.
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Birky Studio. Live AI Demo</title>
  <meta name="description" content="Watch a real AI agent conversation, answered by Birky Studio's WhatsApp assistant in English and Spanish. Realtor, dentist, boutique and restaurant scenarios.">
  <link rel="canonical" href="https://birkystudio.com/ai-demo/">
  <link rel="alternate" hreflang="en" href="https://birkystudio.com/ai-demo/">
  <link rel="alternate" hreflang="es" href="https://birkystudio.com/es/ai-demo/">
  <link rel="alternate" hreflang="x-default" href="https://birkystudio.com/ai-demo/">
  <meta property="og:title" content="Birky Studio. Live AI Demo">
  <meta property="og:description" content="Watch a real AI agent conversation, answered by Birky Studio's WhatsApp assistant in English and Spanish.">
  <meta property="og:image" content="https://birkystudio.com/images/birky-logo.jpg">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://birkystudio.com/ai-demo/">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style is:inline>
    /* Brand tokens, mirrored from src/styles/hero.css. This page is a standalone
       document, so it does not inherit them from BaseLayout. Without this block
       every var(--bs-*) below resolves to nothing. */
    :root {
      --bs-bg-deep: #150b26;
      --bs-bg-raised: #241340;
      --bs-border: rgba(255, 255, 255, .08);
      --bs-text: #f5f3f7;
      --bs-text-muted: #f5f3f7;
      --bs-accent: #ff2d95;
      --bs-accent-2: #b0005a;
      --bs-btn-light: #e6e3ee;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bs-bg-deep);
      color: var(--bs-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* the same fixed 64px grid the rest of the site paints, so the embedded
       copy matches the page it sits in */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255, 255, 255, .06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, .06) 1px, transparent 1px);
      background-size: 64px 64px;
    }

    .demo-bar {
      position: relative;
      z-index: 1;
      background: linear-gradient(135deg, var(--bs-accent), var(--bs-accent-2));
      padding: 10px 20px;
      text-align: center;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      color: #fff;
      flex-shrink: 0;
    }

    .content {
      position: relative;
      z-index: 1;
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      padding: 18px 20px 20px;
    }

    .brand { text-align: center; flex-shrink: 0; }
    .wordmark {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bs-text-muted);
      margin-bottom: 6px;
    }
    .brand h1 {
      font-size: 1.5rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: #fff;
      margin-bottom: 8px;
    }
    .brand h1 em { font-style: normal; color: var(--bs-accent); }
    .brand p {
      font-size: 0.85rem;
      line-height: 1.55;
      color: var(--bs-text-muted);
      max-width: 360px;
      margin: 0 auto;
    }

    /* ---------- scenario switcher ---------- */
    .scenario-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      flex-wrap: wrap;
      flex-shrink: 0;
    }
    .scenario {
      font-family: inherit;
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--bs-text-muted);
      background: rgba(255, 255, 255, .06);
      border: 1px solid rgba(255, 255, 255, .1);
      border-radius: 100px;
      padding: 7px 15px;
      cursor: pointer;
      transition: all .16s ease;
    }
    .scenario:hover { color: #fff; border-color: rgba(255, 45, 149, .5); }
    .scenario.is-active {
      background: var(--bs-accent);
      border-color: var(--bs-accent);
      color: #fff;
    }
    .replay {
      font-family: inherit;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(255, 255, 255, .06);
      border: 1px solid rgba(255, 255, 255, .12);
      color: var(--bs-text-muted);
      cursor: pointer;
      transition: all .16s ease;
    }
    .replay:hover:not(:disabled) { color: #fff; border-color: var(--bs-accent); }
    .replay:disabled { opacity: .4; cursor: default; }
    .replay svg { width: 15px; height: 15px; }
    .replay.is-spinning svg { animation: spin .7s linear infinite; }

    .phone-mockup {
      width: 100%;
      max-width: 380px;
      background: var(--bs-bg-raised);
      border-radius: 24px;
      padding: 18px;
      border: 1px solid rgba(255, 255, 255, .1);
      display: flex;
      flex-direction: column;
      gap: 10px;
      /* Must be able to shrink: the portfolio embeds this in a fixed-height
         iframe, and without this the panel keeps its natural height and the
         CTA below it gets clipped off the bottom of the frame. */
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      scrollbar-width: thin;
    }

    .chat-bubble {
      max-width: 88%;
      padding: 10px 14px;
      border-radius: 16px;
      font-size: 0.85rem;
      line-height: 1.55;
      animation: popIn .3s ease both;
      flex-shrink: 0;
    }
    .chat-bubble.bot {
      background: rgba(255, 255, 255, .07);
      border: 1px solid rgba(255, 255, 255, .1);
      color: var(--bs-text);
      border-bottom-left-radius: 4px;
      align-self: flex-start;
    }
    .chat-bubble.user {
      background: var(--bs-accent);
      color: #fff;
      border-bottom-right-radius: 4px;
      align-self: flex-end;
    }
    .chat-bubble strong { font-weight: 700; }
    .chat-bubble .time { display: block; font-size: 0.65rem; color: var(--bs-text-muted); margin-top: 4px; text-align: right; }
    .chat-bubble.user .time { color: rgba(255, 255, 255, 0.65); }

    .typing-dots {
      align-self: flex-start;
      padding: 9px 16px;
      background: rgba(255, 255, 255, .07);
      border: 1px solid rgba(255, 255, 255, .1);
      border-radius: 16px;
      border-bottom-left-radius: 4px;
      display: flex;
      gap: 4px;
      flex-shrink: 0;
      animation: popIn .2s ease both;
    }
    .typing-dots span { width: 6px; height: 6px; background: var(--bs-text-muted); border-radius: 50%; animation: bounce 1.4s infinite; }
    .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
    .typing-dots span:nth-child(3) { animation-delay: 0.4s; }

    .actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      flex-wrap: wrap;
      flex-shrink: 0;
    }

    .try-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #25D366;
      color: white;
      padding: 13px 28px;
      border-radius: 100px;
      font-size: 0.95rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s;
      border: none;
      cursor: pointer;
    }
    .try-btn:hover { transform: scale(1.04); box-shadow: 0 8px 30px rgba(37,211,102,0.4); }
    .try-btn svg { width: 20px; height: 20px; flex-shrink: 0; }

    .qr-section { display: flex; flex-direction: column; align-items: center; gap: 6px; }
    .qr-section img { width: 84px; height: 84px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, .1); background: #fff; }
    .qr-section p { font-size: 0.7rem; color: var(--bs-text-muted); }

    /* Do not paint the server-rendered conversation, then blow it away and
       replay it. The inline script in <head> adds .js before first paint. */
    html.js .phone-mockup > .ssr { visibility: hidden; }

    /* Embedded in the portfolio card: the QR is pointless (the visitor is already
       on the site) and the header can go tighter, which buys height for the chat
       inside the fixed-height iframe. */
    body.embedded .qr-section { display: none; }
    body.embedded .brand p { display: none; }
    body.embedded .brand h1 { font-size: 1.2rem; }
    body.embedded .phone-mockup { max-width: 400px; padding: 16px; }
    body.embedded .chat-bubble { font-size: 0.81rem; padding: 9px 13px; }
    body.embedded .content { gap: 12px; padding: 15px 16px 17px; }
    body.embedded .scenario { font-size: 0.72rem; padding: 6px 12px; }

    @keyframes bounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-6px); } }
    @keyframes popIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes spin { to { transform: rotate(360deg); } }

    @media (prefers-reduced-motion: reduce) {
      .chat-bubble, .typing-dots { animation: none; }
    }

    @media (max-width: 460px) {
      .actions { flex-direction: column; gap: 12px; }
      .brand h1 { font-size: 1.25rem; }
      .qr-section img { width: 72px; height: 72px; }
      .phone-mockup { padding: 15px; }
      .chat-bubble { font-size: 0.82rem; }
      .scenario { font-size: 0.72rem; padding: 6px 11px; }
      .scenario-row { gap: 6px; }
      .replay { width: 30px; height: 30px; }
    }
  </style>
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>

<div class="demo-bar">Live demo. This is the real assistant, on WhatsApp.</div>

<div class="content">
  <div class="brand">
    <div class="wordmark">Birky.Studio</div>
    <h1>Live AI Agent <em>Demo</em></h1>
    <p>A real conversation with our WhatsApp assistant, in English or Spanish.</p>
  </div>

  <div class="scenario-row" id="scenarios" role="group" aria-label="Choose a business type">
    <button type="button" class="scenario is-active" data-scenario="realtor" aria-pressed="true">Realtor</button>
    <button type="button" class="scenario" data-scenario="dentist" aria-pressed="false">Dentist</button>
    <button type="button" class="scenario" data-scenario="boutique" aria-pressed="false">Boutique</button>
    <button type="button" class="scenario" data-scenario="restaurant" aria-pressed="false">Restaurant</button>
    <button type="button" class="replay" id="replay" aria-label="Play the conversation again">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3.2-6.9"/><path d="M21 3.5V9h-5.5"/></svg>
    </button>
  </div>

  <!-- Live conversation preview. Server-rendered with the first scenario so the
       demo still reads with JavaScript off; the script replaces it and plays. -->
  <div class="phone-mockup" id="phone" aria-live="polite">
    <div class="chat-bubble bot ssr">
      Hey! I'm Birky Studio's AI assistant. I can help with AI agents, receptionist plans, and websites. What's your business type?
      <span class="time">10:02 AM</span>
    </div>
    <div class="chat-bubble user ssr">
      I'm a real estate agent in Antigua
      <span class="time">10:02 AM</span>
    </div>
    <div class="chat-bubble bot ssr">
      Great, I work with lots of agents here. For a realtor the <strong>base agent is $1,297</strong>, and it includes a Notion CRM built for agents. Want me to walk you through what is included?
      <span class="time">10:03 AM</span>
    </div>
    <div class="chat-bubble user ssr">
      Yeah tell me more
      <span class="time">10:03 AM</span>
    </div>
    <div class="chat-bubble bot ssr">
      Sure. It catches every enquiry from your website and WhatsApp, qualifies the lead, saves it to your Notion CRM, sends you a summary with a draft reply, and follows up 2 days later if nobody answered. All bilingual EN/ES. Want to try the real thing on WhatsApp?
      <span class="time">10:04 AM</span>
    </div>
  </div>

  <div class="actions">
    <a href="https://wa.me/50234775110?text=Hi%20Birky%20Studio!%20I%20saw%20the%20demo%20on%20your%20website%20and%20want%20to%20try%20the%20real%20AI." target="_blank" rel="noopener" class="try-btn">
      <svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Try the Real AI on WhatsApp
    </a>

    <div class="qr-section">
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=https://wa.me/50234775110?text=Hi%20Birky%20Studio!%20I%20saw%20the%20demo%20on%20your%20website" alt="QR Code to try BirkyStudio on WhatsApp" loading="lazy">
      <p>Scan to try it now</p>
    </div>
  </div>
</div>

<script is:inline>
  // Inside the portfolio card the QR is redundant, and the tighter header buys
  // vertical room for the chat in the fixed-height iframe.
  if (window.self !== window.top) document.body.classList.add('embedded');

  // Conversation data. Prices must match the live site plans.
  var SCENARIOS = {
    realtor: [
      { from: 'bot',  text: "Hey! I'm Birky Studio's AI assistant. I can help with AI agents, receptionist plans, and websites. What's your business type?" },
      { from: 'user', text: "I'm a real estate agent in Antigua" },
      { from: 'bot',  text: "Great, I work with lots of agents here. For a realtor the <strong>base agent is $1,297</strong>, and it includes a Notion CRM built for agents. Want me to walk you through what is included?" },
      { from: 'user', text: "Yeah tell me more" },
      { from: 'bot',  text: "Sure. It catches every enquiry from your website and WhatsApp, qualifies the lead, saves it to your Notion CRM, sends you a summary with a draft reply, and follows up 2 days later if nobody answered. All bilingual EN/ES. Want to try the real thing on WhatsApp?" }
    ],
    dentist: [
      { from: 'bot',  text: "Hey! I'm Birky Studio's AI assistant. What kind of business do you run?" },
      { from: 'user', text: "A dental clinic. Two chairs, front desk only answers in office hours" },
      { from: 'bot',  text: "Got it. For a clinic the <strong>voice receptionist is $550</strong>. It answers every call 24/7, books appointments straight into your calendar, and flags anything urgent. Want to hear how the booking side works?" },
      { from: 'user', text: "Yes. We miss a lot of calls over lunch" },
      { from: 'bot',  text: "That is the usual one. It picks up while the desk is closed, offers the next free slot, and confirms by WhatsApp. You get a daily list of who booked and why. Bilingual EN/ES. Want to try the real thing on WhatsApp?" }
    ],
    boutique: [
      { from: 'bot',  text: "Hey! I'm Birky Studio's AI assistant. What do you sell?" },
      { from: 'user', text: "A clothing boutique. Most orders come through WhatsApp" },
      { from: 'bot',  text: "That is a fit for the <strong>text receptionist at $297</strong>. It answers the same sizing and shipping questions all day, takes the order details, and logs every customer in your CRM. Want to see how it handles a sizing question?" },
      { from: 'user', text: "Yes, that is most of my day" },
      { from: 'bot',  text: "It replies in seconds with your size guide, asks for the two measurements it needs, and sends you the order summary. Nothing sits unanswered overnight. Bilingual EN/ES. Want to try the real thing on WhatsApp?" }
    ],
    restaurant: [
      { from: 'bot',  text: "Hey! I'm Birky Studio's AI assistant. What is your business type?" },
      { from: 'user', text: "A restaurant. We get the same calls all day long" },
      { from: 'bot',  text: "Very common. The <strong>voice receptionist at $550</strong> answers opening hours, the menu and reservations, and books tables into your own calendar. Want to know what happens on a fully booked night?" },
      { from: 'user', text: "Yeah, that is when it gets messy" },
      { from: 'bot',  text: "It offers the next available table, adds them to a waiting list, and flags the request for you. No missed calls while the kitchen is busy. Bilingual EN/ES. Want to try the real thing on WhatsApp?" }
    ]
  };

  (function () {
    var phone = document.getElementById('phone');
    var replay = document.getElementById('replay');
    var pills = Array.prototype.slice.call(document.querySelectorAll('.scenario'));
    var active = 'realtor';
    var timers = [];
    var playing = false;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function clearTimers() {
      timers.forEach(clearTimeout);
      timers = [];
    }

    function atBottom() {
      phone.scrollTop = phone.scrollHeight;
    }

    function bubble(msg) {
      var el = document.createElement('div');
      el.className = 'chat-bubble ' + msg.from;
      el.innerHTML = msg.text;
      return el;
    }

    function typing() {
      var el = document.createElement('div');
      el.className = 'typing-dots';
      el.innerHTML = '<span></span><span></span><span></span>';
      return el;
    }

    function paint(msgs) {
      phone.innerHTML = '';
      msgs.forEach(function (m) { phone.appendChild(bubble(m)); });
      atBottom();
    }

    function setPlaying(on) {
      playing = on;
      replay.disabled = on;
      replay.classList.toggle('is-spinning', on);
    }

    function play(key) {
      active = key;
      clearTimers();
      pills.forEach(function (p) {
        var on = p.dataset.scenario === key;
        p.classList.toggle('is-active', on);
        p.setAttribute('aria-pressed', on ? 'true' : 'false');
      });

      var msgs = SCENARIOS[key] || [];
      phone.innerHTML = '';

      if (reduce) { paint(msgs); setPlaying(false); return; }

      setPlaying(true);
      var t = 0;
      msgs.forEach(function (m) {
        if (m.from === 'bot') {
          t += 320;
          var dots = typing();
          (function () {
            var at = t;
            timers.push(setTimeout(function () {
              phone.appendChild(dots);
              atBottom();
            }, at));
          })();
          t += 950;
          (function (msg, node) {
            var at = t;
            timers.push(setTimeout(function () {
              if (node.parentNode) node.parentNode.removeChild(node);
              phone.appendChild(bubble(msg));
              atBottom();
            }, at));
          })(m, dots);
        } else {
          t += 750;
          (function (msg) {
            var at = t;
            timers.push(setTimeout(function () {
              phone.appendChild(bubble(msg));
              atBottom();
            }, at));
          })(m);
        }
      });
      timers.push(setTimeout(function () { setPlaying(false); }, t + 200));
    }

    pills.forEach(function (p) {
      p.addEventListener('click', function () { play(p.dataset.scenario); });
    });
    replay.addEventListener('click', function () { play(active); });

    // Play when the demo is actually on screen. In an iframe this fires as soon
    // as the frame is visible, which is what makes it read like a recording.
    var started = false;
    function startOnce() {
      if (started) return;
      started = true;
      play('realtor');
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { setTimeout(startOnce, 450); io.disconnect(); }
        });
      }, { threshold: 0.25 });
      io.observe(phone);
    } else {
      setTimeout(startOnce, 400);
    }
  })();
</script>

</body>
</html>
