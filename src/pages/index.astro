---
import BaseLayout from '../layouts/BaseLayout.astro';

const organizationLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Birky Studio",
  "url": "https://birkystudio.com",
  "logo": "https://birkystudio.com/images/birky-mascot.jpg",
  "description": "Professional websites and AI agents for small businesses — websites from $250, AI agents from $549, AI receptionists from $250.",
  "email": "birky.ai@proton.me",
  "telephone": "+502****6181",
  "areaServed": "Worldwide",
  "serviceType": ["Web Design", "AI Agent Setup", "AI Voice Receptionist"],
  "sameAs": [],
  "offers": [
    {
      "@type": "Offer",
      "name": "Starter Website",
      "price": "250",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Professional Website",
      "price": "500",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Premium Website",
      "price": "999",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Real Estate AI Agent",
      "price": "799",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Business AI Agent",
      "price": "549",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Text Receptionist",
      "price": "250",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Voice Receptionist Bundle",
      "price": "550",
      "priceCurrency": "USD"
    }
  ]
});

const faqLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does a website cost for a small business?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Birky Studio builds websites starting at $250 for a 1-3 page Starter site, $500 for a Professional 4-7 page bilingual site, and $999 for a Premium 10+ page site with blog and custom features. All prices are one-time with no hidden fees."
      }
    },
    {
      "@type": "Question",
      "name": "What is an AI agent and what can it do for my business?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An AI agent is a dedicated AI assistant installed on your computer that connects to your email, files, and CRM. It answers customer questions, automates tasks, drafts emails, manages your calendar, and works 24/7 in English and Spanish. For realtors, the Real Estate AI Agent at $799 includes the Notion Real Estate System for CRM and content planning."
      }
    },
    {
      "@type": "Question",
      "name": "How much does an AI receptionist cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The AI Text Receptionist for WhatsApp is $250 one-time. The AI Voice Receptionist, which answers phone calls 24/7, is $550 setup with the client paying Vapi directly about $30-50/month for call usage. Optional support is $29/month."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need technical skills to use an AI agent?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No technical skills are needed. Luna personally installs and configures everything via a screen-sharing session that takes 2-3 hours, including full training. After setup you use it through WhatsApp or Telegram like a normal chat."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to get a website or AI agent?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Websites are delivered in 2-3 days. AI agent setup takes one 2-3 hour remote session. Text receptionists are live in 1-2 days, and voice receptionists in 2-3 days. Every project includes 30 days of free support."
      }
    }
  ]
});
