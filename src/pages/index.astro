          <button onclick="toggleFaq(this)" style="width:100%;background:none;border:none;color:white;font-size:1.05rem;font-weight:600;padding:20px 24px;text-align:left;cursor:pointer;font-family:'Inter',sans-serif;display:flex;justify-content:space-between;align-items:center;gap:16px;">
            What if I don't like the result?
            <span style="color:#818cf8;font-size:1.2rem;flex-shrink:0;">+</span>
          </button>
          <div class="faq-answer" style="max-height:0;overflow:hidden;transition:max-height 0.3s ease;">
            <p style="color:#94a3b8;padding:0 24px 20px;line-height:1.7;font-size:0.95rem;">
              You're covered by our 30-day satisfaction guarantee. If something doesn't work during setup, we'll fix it or your money back — no questions asked. You also get free revisions during setup and 30 days of free support, with no lock-in contracts.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

<!-- CTA Section -->
  <section style="padding:100px 0;background:white;">
    <div class="container" style="text-align:center;">
      <h2 style="font-size:2.5rem;margin-bottom:16px;">Ready to Work Smarter?</h2>
      <p style="color:var(--color-gray);font-size:1.1rem;max-width:600px;margin:0 auto 40px;">Whether you need a website, an AI assistant, or both — let's build something great for your business.</p>
      <a href="/contact" class="btn btn-primary" style="font-size:1.1rem;padding:18px 36px;">
        Start Your Project →
      </a>
    </div>
  </section>

  <style>
    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: 1fr !important;
      }
      .hero-grid > div:last-child {
        max-width: 400px;
        margin: 0 auto;
      }
    }
  </style>
  <script is:inline>
    function toggleFaq(btn) {
      const answer = btn.nextElementSibling;
      const icon = btn.querySelector('span:last-child');
      if (answer.style.maxHeight && answer.style.maxHeight !== '0px') {
        answer.style.maxHeight = '0';
        icon.textContent = '+';
      } else {
        answer.style.maxHeight = answer.scrollHeight + 'px';
        icon.textContent = '−';
      }
    }
  </script>

</BaseLayout>
