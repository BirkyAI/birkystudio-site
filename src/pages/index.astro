---
import BaseLayout from '../layouts/BaseLayout.astro';

// WebSite structured data, per Google's "Site Names in Google Search" docs this
// is "the most important signal" for the site name shown above results. Without
// it Google guesses the brand from other on-page signals.
const websiteLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Birky Studio",
  "alternateName": "Birky",
  "url": "https://birkystudio.com/"
});

const organizationLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Birky Studio",
  "url": "https://birkystudio.com",
  "logo": "https://birkystudio.com/images/birky-logo.jpg",
  "description": "Custom AI agents with Notion CRM that save you 8+ hours a week. Plus professional websites, AI receptionists, and voice agents, bilingual EN/ES, delivered in 3 days.",
  "email": "birky.ai@proton.me",
  "telephone": "+50234775110",
  "areaServed": "Worldwide",
  "serviceType": ["Web Design", "AI Agent Setup", "AI Voice Receptionist"],
  "sameAs": [
    "https://www.facebook.com/Birky.Studio",
    "https://www.instagram.com/birky.studio/",
    "https://www.tiktok.com/@birky_studio"
  ],
  "offers": [
    {
      "@type": "Offer",
      "name": "Starter Website",
      "price": "499",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Professional Website",
      "price": "999",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Premium Website",
      "price": "1999",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "AI Agent Setup",
      "price": "1297",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "AI Text Receptionist",
      "price": "297",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Voice Receptionist Bundle",
      "price": "550",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Self-Editing CMS",
      "price": "130",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Content Booster (Monthly)",
      "price": "149",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Content Pro (Monthly)",
      "price": "199",
      "priceCurrency": "USD"
    }
  ]
});

const faqLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does a website cost for a small business?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Birky Studio builds websites starting at $499 for a 1-3 page Starter site, $999 for a Professional 4-7 page bilingual site, and $1,999 for a Premium 10+ page site with blog and custom features. All prices are one-time with no hidden fees."
      }
    },
    {
      "@type": "Question",
      "name": "What is an AI agent and what can it do for my business?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An AI agent is a dedicated AI assistant installed on your computer that connects to your email, files, and CRM. It answers customer questions, automates tasks, drafts emails, manages your calendar, and works 24/7 in English and Spanish. For realtors, the AI Agent Setup at $1,297 includes a Notion CRM built for agents."
      }
    },
    {
      "@type": "Question",
      "name": "How much does an AI receptionist cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The AI Text Receptionist for WhatsApp is $297 one-time. The AI Voice Receptionist, which answers phone calls 24/7, is $550 setup, with the client paying Vapi directly about $30-50/month for call usage. Ongoing support is $97/month (Care & Maintenance) or $197/month (Business AI Partner)."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need technical skills to use an AI agent?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No technical skills are needed. Luna personally installs and configures everything with you on a screen-sharing call. The build takes about 15 minutes on her side, and the call covers connecting your accounts and a full walkthrough. After setup you use it through WhatsApp or Telegram like a normal chat."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to get a website or AI agent?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Websites are delivered in 2-3 days. AI agent setup is about 15 minutes of build plus a call to connect your accounts. Text receptionists are live in 1-2 days, and voice receptionists in 2-3 days. Every project includes 30 days of free support."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Lead Generation Pack and how much does it cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Lead Generation Pack is a one-time service at $1,997 that gives you real, verified prospects plus the AI to follow them up. It includes a verified, enriched, scored prospect list for any niche, automated outreach setup, an AI agent trained on your niche and pitch, and an AI receptionist that catches and qualifies replies 24/7. You own the list and data forever, no subscription, no lock-in. A Standalone Lead Generation Starter List is $497 (up to 25 verified prospects) and the Pro List is $997 (up to 100 prospects plus outreach templates)."
      }
    }
  ]
});
---

<BaseLayout title="Take Back Your Time" description="Automate the repetitive tasks that eat up your workweek. Websites, receptionists and business assistants for real estate agents and small business owners." image="/images/birky-logo.jpg">
  <script type="application/ld+json" set:html={websiteLD} />
  <script type="application/ld+json" set:html={organizationLD} />
  <script type="application/ld+json" set:html={faqLD} />


<!-- Hero Section -->
  <section class="hero-sec">
    <div class="hero-orb o1"></div>
    <div class="hero-orb o2"></div>

    <div class="hero-wrap hero-grid">
      <!-- Left: copy (text preserved verbatim for SEO) -->
      <div>
        <span class="hero-eyebrow">Get Hours Back Every Week</span>
        <h1 class="hero-h1">
          Take Back Your<br>
          <em>Time</em>
        </h1>
        <p class="hero-sub">
          Automate repetitive tasks that eat up your workweek. Spend your days running the business, not chasing it.
        </p>
        <div class="hero-tags">
          <span>For Realtors</span>
          <span>For Local Business</span>
          <span>Restaurants &amp; Hotels</span>
        </div>
        <div class="hero-ctas">
          <a href="/contact" class="btn hero-btn-primary">Get My Time Back →</a>
          <a href="/#products" class="btn hero-btn-ghost">See How It Works</a>
        </div>
      </div>

      <!-- Right: the six building blocks of the base agent -->
      <div class="mod-stage">
        <div class="mod m1">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3z"/><path d="M3 7l9 6 9-6"/></svg></span>
          <span><span class="mod-label">Catch enquiries</span><span class="mod-meta">Web + WhatsApp</span></span>
        </div>
        <div class="mod m2">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></span>
          <span><span class="mod-label">Qualify the lead</span><span class="mod-meta">Asks the right things</span></span>
        </div>
        <div class="mod m3">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/></svg></span>
          <span><span class="mod-label">Save to CRM</span><span class="mod-meta">Notion, built in</span></span>
        </div>
        <div class="mod m4 is-key">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 8h18s-3-1-3-8"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></span>
          <span><span class="mod-label">Alert you with a reply</span><span class="mod-meta">Summary + draft</span></span>
        </div>
        <div class="mod m5">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.1a8.4 8.4 0 0 1-.9-3.9 8.4 8.4 0 0 1 8.4-8.4 8.4 8.4 0 0 1 8.6 8.4z"/></svg></span>
          <span><span class="mod-label">Auto-reply</span><span class="mod-meta">Instant, EN/ES</span></span>
        </div>
        <div class="mod m6">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span>
          <span><span class="mod-label">Follow up in 2 days</span><span class="mod-meta">Nothing goes cold</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- AI demo lives on the portfolio page only (Luna, 27 Sep 2026) -->

  <!-- Pricing: AI Agent -->
