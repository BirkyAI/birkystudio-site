---
import BaseLayout from '../layouts/BaseLayout.astro';

// WebSite structured data, per Google's "Site Names in Google Search" docs this
// is "the most important signal" for the site name shown above results. Without
// it Google guesses the brand from other on-page signals.
const websiteLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Birky Studio",
  "alternateName": "Birky",
  "url": "https://birkystudio.com/"
});

const organizationLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Birky Studio",
  "url": "https://birkystudio.com",
  "logo": "https://birkystudio.com/images/birky-logo.jpg",
  "description": "Custom AI agents with Notion CRM that save you 8+ hours a week. Plus professional websites, AI receptionists, and voice agents, bilingual EN/ES, delivered in 3 days.",
  "email": "birky.ai@proton.me",
  "telephone": "+50234775110",
  "areaServed": "Worldwide",
  "serviceType": ["Web Design", "AI Agent Setup", "AI Voice Receptionist"],
  "sameAs": [
    "https://www.facebook.com/Birky.Studio",
    "https://www.instagram.com/birky.studio/",
    "https://www.tiktok.com/@birky_studio"
  ],
  "offers": [
    {
      "@type": "Offer",
      "name": "Starter Website",
      "price": "499",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Professional Website",
      "price": "999",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Premium Website",
      "price": "1999",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "The Base Agent",
      "price": "1297",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "AI Text Receptionist",
      "price": "297",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Voice Receptionist Bundle",
      "price": "550",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Self-Editing CMS",
      "price": "130",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Content Booster (Monthly)",
      "price": "149",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Content Pro (Monthly)",
      "price": "199",
      "priceCurrency": "USD"
    }
  ]
});

const faqLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does a website cost for a small business?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Birky Studio builds websites starting at $499 for a 1-3 page Starter site, $999 for a Professional 4-7 page bilingual site, and $1,999 for a Premium 10+ page site with blog and custom features. All prices are one-time with no hidden fees."
      }
    },
    {
      "@type": "Question",
      "name": "What is an AI agent and what can it do for my business?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The base agent is a lead-catching system that runs on its own server, not your laptop, so it keeps working when you shut down. It reads every website and WhatsApp enquiry, sorts it, saves it to a Notion CRM built for agents, answers it instantly and follows up automatically, so no lead goes cold. It works in English and Spanish. The install is $1,297 and the Notion CRM is included. Answering your customers by voice or message is a separate product, the AI Receptionist."
      }
    },
    {
      "@type": "Question",
      "name": "How much does an AI receptionist cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The AI Text Receptionist for WhatsApp is $297 one-time. The AI Voice Receptionist, which answers phone calls 24/7, is $550 setup, with the client paying Vapi directly about $30-50/month for call usage. Ongoing support is $97/month (Care & Maintenance) or $197/month (Business AI Partner)."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need technical skills to use an AI agent?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No technical skills are needed. Luna sets everything up for you, connects your accounts and walks you through it. The build takes about 15 minutes on her side, and you get 30 days of free support after. You do not need to know anything technical to run it."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to get a website or AI agent?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Websites are delivered in 2-3 days. AI agent setup is about 15 minutes of build plus a call to connect your accounts. Text receptionists are live in 1-2 days, and voice receptionists in 2-3 days. Every project includes 30 days of free support."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Lead Generation Pack and how much does it cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Lead Generation Pack is a one-time service at $1,997 that gives you real, verified prospects plus the AI to follow them up. It includes a verified, enriched, scored prospect list for any niche, automated outreach setup, an AI agent trained on your niche and pitch, and an AI receptionist that catches and qualifies replies 24/7. You own the list and data forever, no subscription, no lock-in. A Standalone Lead Generation Starter List is $497 (up to 25 verified prospects) and the Pro List is $997 (up to 100 prospects plus outreach templates)."
      }
    }
  ]
});
---

<BaseLayout title="Take Back Your Time" description="Automate the repetitive tasks that eat up your workweek. Websites, receptionists and business assistants for real estate agents and small business owners." image="/images/birky-logo.jpg">
  <script type="application/ld+json" set:html={websiteLD} />
  <script type="application/ld+json" set:html={organizationLD} />
  <script type="application/ld+json" set:html={faqLD} />


<!-- Hero Section -->
  <section class="hero-sec">
    <div class="hero-orb o1"></div>
    <div class="hero-orb o2"></div>

    <div class="hero-wrap hero-grid">
      <!-- Left: copy (text preserved verbatim for SEO) -->
      <div>
        <span class="hero-eyebrow">Get Hours Back Every Week</span>
        <h1 class="hero-h1">
          Take Back Your<br>
          <em>Time</em>
        </h1>
        <p class="hero-sub">
          Automate repetitive tasks that eat up your workweek. Spend your days running the business, not chasing it.
        </p>
        <div class="hero-tags">
          <span>For Realtors</span>
          <span>For Small &amp; Medium Businesses</span>
          <span>Restaurants &amp; Hotels</span>
        </div>
        <div class="hero-ctas">
          <a href="/products/free-audit" class="btn hero-btn-primary">Get My Time Back →</a>
          <a href="/#products" class="btn hero-btn-ghost">See How It Works</a>
        </div>
      </div>

      <!-- Right: the six building blocks of the base agent -->
      <div class="mod-stage">
        <div class="mod m1">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3z"/><path d="M3 7l9 6 9-6"/></svg></span>
          <span><span class="mod-label">Catch enquiries</span><span class="mod-meta">Web + WhatsApp</span></span>
        </div>
        <div class="mod m2">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></span>
          <span><span class="mod-label">Qualify the lead</span><span class="mod-meta">Asks the right things</span></span>
        </div>
        <div class="mod m3">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/></svg></span>
          <span><span class="mod-label">Save to CRM</span><span class="mod-meta">Notion, built in</span></span>
        </div>
        <div class="mod m4 is-key">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 8h18s-3-1-3-8"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></span>
          <span><span class="mod-label">Alert you with a reply</span><span class="mod-meta">Summary + draft</span></span>
        </div>
        <div class="mod m5">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.1a8.4 8.4 0 0 1-.9-3.9 8.4 8.4 0 0 1 8.4-8.4 8.4 8.4 0 0 1 8.6 8.4z"/></svg></span>
          <span><span class="mod-label">Auto-reply</span><span class="mod-meta">Instant, EN/ES</span></span>
        </div>
        <div class="mod m6">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span>
          <span><span class="mod-label">Follow up in 2 days</span><span class="mod-meta">Nothing goes cold</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- AI demo lives on the portfolio page only (Luna, 27 Sep 2026) -->

  <div id="products"></div>

  <!-- Pricing: The System (base agent + building blocks) -->
  <section id="pricing-ai" style="padding:100px 0">
    <div class="container">
      <div style="text-align:center;margin-bottom:56px;">
        <div style="display:inline-block;padding:6px 16px;background:rgba(255,45,149,0.16);border-radius:100px;color:var(--bs-accent);font-size:0.85rem;font-weight:600;margin-bottom:16px;">The System</div>
        <h2 class="sec-h2">One agent. Add <em>only what you need.</em></h2>
        <p style="color:var(--bs-text-muted);font-size:1.1rem;max-width:640px;margin:0 auto;">The base agent is the machine that runs your front desk, your CRM and your follow-up. Everything else is a block you add on top, one at a time, only when you need it.</p>
      </div>

      <div class="sys-head first">
        <h3>Start here</h3>
        <span>Every build starts with a conversation, not a contract.</span>
      </div>

      <div class="sys-assess">
        <a href="/products/free-audit" class="sys-tile is-first">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></div>
          <div class="sys-nm">Free 15-Minute Audit</div>
          <div class="sys-ds">One short call, and we name the one thing costing you the most time.</div>
          <div class="sys-pr">Free</div>
        </a>
        <a href="/products/custom-assessment" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M9 3h6v3H9z"/><path d="M7 6h10v14H7z"/><path d="M10 11h4M10 15h4"/></svg></div>
          <div class="sys-nm">Custom Assessment, solo</div>
          <div class="sys-ds">A 45-minute interview and a written plan. Credits against your blocks.</div>
          <div class="sys-pr">$349</div>
        </a>
        <a href="/products/custom-assessment" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M9 3h6v3H9z"/><path d="M7 6h10v14H7z"/><path d="M10 11h4M10 15h4"/></svg></div>
          <div class="sys-nm">Custom Assessment, business</div>
          <div class="sys-ds">The same, for a business with staff. Measured in team hours saved.</div>
          <div class="sys-pr">$999</div>
        </a>
      </div>

      <p class="sys-note">Only need the functions that are already in the base agent? Book the free audit and skip the paid one entirely. The Custom Assessment is for when you have several problems to fix, and its fee credits in full against your blocks.</p>

      <!-- The base agent: the rectangle -->
      <a href="/products/ai-agent-setup" class="sys-base">
        <div class="sys-base-l">
          <div class="sys-core">
            <svg viewBox="0 0 24 24"><path d="M12 2 21 7l-9 5-9-5z"/><path d="M3 12l9 5 9-5"/><path d="M3 17l9 5 9-5"/></svg>
          </div>
          <div>
            <span class="sys-eyebrow">The machine</span>
            <h3>The Base Agent</h3>
            <p>Catches every enquiry from your site and WhatsApp, qualifies it, saves it to your Notion CRM, answers it instantly and follows up on its own. No lead ever goes cold.</p>
            <div class="sys-chips">
              <span class="sys-chip">Notion CRM included</span>
              <span class="sys-chip">Bilingual EN/ES</span>
              <span class="sys-chip">Live in about 15 minutes</span>
              <span class="sys-chip">You own it</span>
            </div>
          </div>
        </div>
        <div class="sys-price">
          <span class="sys-num">$1,297</span>
          <span class="sys-sub">one-time, solo</span>
          <span class="sys-alt">from <b>$2,997</b> with a team</span>
        </div>
      </a>

      <!-- The building blocks: the squares -->
      <div class="sys-head">
        <h3>Then add the blocks you need</h3>
        <span>Each block is a separate install. Stack them over time.</span>
      </div>

            <div class="sys-grid">
        <a href="/products/text-receptionist" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.1a8.4 8.4 0 0 1-.9-3.9 8.4 8.4 0 0 1 8.4-8.4 8.4 8.4 0 0 1 8.6 8.4z"/></svg></div>
          <div class="sys-nm">Text Receptionist</div>
          <div class="sys-ds">Answers your WhatsApp day and night.</div>
          <div class="sys-pr">$297</div>
        </a>
        <a href="/products/voice-receptionist" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg></div>
          <div class="sys-nm">Voice Receptionist</div>
          <div class="sys-ds">Answers your phone in a natural voice, 24/7.</div>
          <div class="sys-pr">$550</div>
        </a>
        <a href="/products/review-engine" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.3 2.9 1-6.1L3.3 9.5l6.1-.9z"/></svg></div>
          <div class="sys-nm">Review Engine</div>
          <div class="sys-ds">Turns your past clients into Google reviews.</div>
          <div class="sys-pr">$497 <small>+ $97/mo</small></div>
        </a>
        <a href="/products/lead-generation-starter-list" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></div>
          <div class="sys-nm">Verified Prospect List</div>
          <div class="sys-ds">A real, scored list of prospects you own forever.</div>
          <div class="sys-pr">from $497</div>
        </a>
        <a href="/products/lead-generation-pack" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M22 2 11 13"/><path d="M22 2l-7 20-4-9-9-4z"/></svg></div>
          <div class="sys-nm">Lead Generation Pack</div>
          <div class="sys-ds">The list, plus the outreach and follow-up that work it.</div>
          <div class="sys-pr">$1,997</div>
        </a>
        <a href="/products/outreach-engine" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M3 5h18v14H3z"/><path d="M3 6l9 7 9-7"/></svg></div>
          <div class="sys-nm">Outreach Engine</div>
          <div class="sys-ds">Sends the compliant email follow-up for you.</div>
          <div class="sys-pr">$797</div>
        </a>
        <a href="/products/gbp-autopilot" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></div>
          <div class="sys-nm">GBP Autopilot</div>
          <div class="sys-ds">Keeps your Google Business Profile posting.</div>
          <div class="sys-pr">$397</div>
        </a>
        <a href="/products/content-engine" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div>
          <div class="sys-nm">Content Engine</div>
          <div class="sys-ds">Blog and SEO content, written and published for you.</div>
          <div class="sys-pr">$497</div>
        </a>
      </div>

      <p class="sys-foot">Blocks start at $297, and we quote custom blocks. Monthly care after install: <b>$97</b> Care &amp; Maintenance, or <b>$197</b> Business AI Partner.</p>
    </div>
  </section>

  <style>
    .sys-base{display:flex;align-items:center;justify-content:space-between;gap:36px;text-decoration:none;
      background:var(--bs-bg-raised);border:1.5px solid rgba(255,45,149,.45);border-radius:24px;padding:34px 40px;
      box-shadow:0 22px 60px rgba(255,45,149,.20),0 0 0 1px rgba(255,45,149,.12);transition:transform .2s ease,box-shadow .2s ease}
    .sys-base:hover{transform:translateY(-3px);box-shadow:0 30px 70px rgba(255,45,149,.28),0 0 0 1px rgba(255,45,149,.18)}
    .sys-base-l{display:flex;gap:20px;align-items:flex-start;max-width:680px}
    .sys-core{width:58px;height:58px;flex:0 0 58px;border-radius:15px;display:grid;place-items:center;
      background:rgba(255,45,149,.14);border:1px solid rgba(255,45,149,.42)}
    .sys-core svg{width:26px;height:26px;fill:none;stroke:var(--bs-accent);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
    .sys-eyebrow{display:block;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--bs-accent);font-weight:600;margin-bottom:8px}
    .sys-base h3{margin:0 0 8px;font-size:1.5rem;color:white;letter-spacing:-.01em}
    .sys-base p{margin:0;color:var(--bs-text-muted);font-size:.98rem;line-height:1.65}
    .sys-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
    .sys-chip{font-size:.76rem;color:var(--bs-text-muted);border:1px solid var(--bs-border);
      background:rgba(255,255,255,.04);border-radius:100px;padding:5px 12px}
    .sys-price{text-align:right;white-space:nowrap;flex:0 0 auto}
    .sys-num{font-size:2.5rem;font-weight:800;letter-spacing:-.03em;display:block;line-height:1;color:white}
    .sys-sub{color:var(--bs-text-muted);font-size:.82rem;display:block;margin-top:4px}
    .sys-alt{margin-top:12px;padding-top:12px;border-top:1px solid var(--bs-border);color:var(--bs-text-muted);font-size:.85rem;display:block}
    .sys-alt b{color:white;font-weight:700}
    .sys-head{display:flex;align-items:baseline;gap:14px;margin:52px 0 20px}
    .sys-head h3{margin:0;font-size:1.35rem;color:white;letter-spacing:-.01em}
    .sys-head span{color:var(--bs-text-muted);font-size:.88rem}
    .sys-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
    .sys-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .sys-grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
    .sys-tile.auto{aspect-ratio:auto;min-height:170px}
    .sys-assess{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .sys-tile.is-first{border-color:rgba(255,45,149,.45);box-shadow:0 0 0 1px rgba(255,45,149,.12)}
    .sys-note{max-width:820px;margin:22px auto 0;text-align:center;color:var(--bs-text-muted);font-size:.88rem;line-height:1.65}
    .sys-head.first{margin-top:0}
    .sys-tile{position:relative;text-decoration:none;background:var(--bs-bg-raised);border:1px solid var(--bs-border);
      border-radius:18px;padding:24px;aspect-ratio:1/1;display:flex;flex-direction:column;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}
    .sys-tile:hover{transform:translateY(-4px);border-color:rgba(255,45,149,.42);box-shadow:0 18px 40px rgba(0,0,0,.4)}
    .sys-ic{width:38px;height:38px;flex:0 0 38px;border-radius:11px;display:grid;place-items:center;
      background:rgba(255,255,255,.05);border:1px solid var(--bs-border);margin-bottom:16px}
    .sys-ic svg{width:18px;height:18px;fill:none;stroke:var(--bs-text);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
    .sys-nm{font-size:1.05rem;font-weight:600;letter-spacing:-.01em;margin-bottom:6px;color:white}
    .sys-ds{color:var(--bs-text-muted);font-size:.88rem;line-height:1.5;flex-grow:1}
    .sys-pr{font-size:1.05rem;font-weight:700;margin-top:16px;color:white}
    .sys-pr small{color:var(--bs-text-muted);font-weight:500;font-size:.78rem}
    .sys-foot{margin-top:28px;text-align:center;color:var(--bs-text-muted);font-size:.9rem}
    .sys-foot b{color:var(--bs-text);font-weight:600}
    @media (max-width:820px){
      .sys-grid,.sys-grid3{grid-template-columns:repeat(2,1fr)}
      .sys-grid2{grid-template-columns:1fr}
      .sys-assess{grid-template-columns:repeat(2,1fr)}
      .sys-base{flex-direction:column;align-items:flex-start;gap:22px}
      .sys-price{text-align:left}
    }
    @media (max-width:520px){ .sys-grid,.sys-grid3,.sys-grid2{grid-template-columns:1fr} .sys-assess{grid-template-columns:1fr} }
  </style>

    <!-- Pricing: Websites -->
  <section id="pricing-websites" style="padding:100px 0">
    <div class="container">
      <div style="text-align:center;margin-bottom:56px;">
        <div style="display:inline-block;padding:6px 16px;background:rgba(255,45,149,0.16);border-radius:100px;color:var(--bs-text-muted);font-size:0.85rem;font-weight:600;margin-bottom:16px;">Website Design</div>
        <h2 class="sec-h2">Website <em>Plans</em></h2>
        <p style="color:var(--bs-text-muted);font-size:1.1rem;max-width:640px;margin:0 auto;">Professional websites at fair prices, plus the add-ons that keep them growing. No hidden fees, no surprises.</p>
      </div>

      <div class="sys-grid3">
        <a href="/products/website-starter" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/></svg></div>
          <div class="sys-nm">Starter Website</div>
          <div class="sys-ds">Perfect for new businesses. 1 to 3 pages.</div>
