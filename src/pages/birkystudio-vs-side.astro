---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is Side cheaper than BirkyStudio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BirkyStudio is significantly cheaper upfront. A custom AI agent costs $1,297 one-time setup (includes Notion Real Estate System), with optional support from $29/month. Side does not publish pricing — it's a consultation-based partnership tied to your production volume. Side's model involves creating a new brokerage entity, and costs are based on commission splits. BirkyStudio works with your existing brokerage and charges a fixed one-time fee."
      }
    },
    {
      "@type": "Question",
      "name": "Does Side offer an AI receptionist or AI agent for leads?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Side AI focuses on transaction-level busywork — documents, signatures, compliance checks, and back-office automation within their SideOS platform. It does not answer incoming phone calls, handle WhatsApp messages, or engage with leads. BirkyStudio's AI is purpose-built for lead conversations: answering calls on Vapi, responding on WhatsApp, qualifying prospects, scheduling showings, and following up — all in English and Spanish."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use BirkyStudio if I'm already a Side partner?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. BirkyStudio works alongside Side. Side handles your back office (transaction management, compliance, payments) and BirkyStudio handles your front office (lead conversations, WhatsApp, phone calls, follow-ups). They address different parts of your business and don't conflict."
      }
    },
    {
      "@type": "Question",
      "name": "Who should choose Side over BirkyStudio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Choose Side if you're a top-producing agent ($2M+ annual volume) who wants to own your own brokerage company, keep your brand, and have a dedicated back office handling compliance, payments, and transaction coordination. Side is ideal for agents who want to build a real estate company, not just automate their workflow."
      }
    },
    {
      "@type": "Question",
      "name": "Who should choose BirkyStudio over Side?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Choose BirkyStudio if you're a solo agent or small team who wants AI to handle lead conversations, calls, WhatsApp messages, and daily admin — without restructuring your business or meeting a minimum production threshold. BirkyStudio works with any brokerage, costs a fixed one-time fee, and is set up in 2-3 hours."
      }
    },
    {
      "@type": "Question",
      "name": "Does Side or BirkyStudio offer WhatsApp integration?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BirkyStudio includes WhatsApp AI as standard in every setup — full AI-powered conversations in English and Spanish. Side does not offer WhatsApp integration as part of its platform. SideOS focuses on transaction management, compliance, and brokerage operations, not lead communication channels."
      }
    }
  ]
});

const articleLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "BirkyStudio vs Side (2026 Comparison) — Brand Ownership vs AI Automation for Realtors",
  "description": "Honest head-to-head comparison of BirkyStudio vs Side. Real prices, pros and cons, and which one fits your real estate business stage. Side helps top agents own their brokerage; BirkyStudio automates lead response.",
  "author": {
    "@type": "Person",
    "name": "Luna Jerney",
    "url": "https://birkystudio.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Birky Studio",
    "url": "https://birkystudio.com"
  },
  "datePublished": "2026-09-08",
  "dateModified": "2026-09-08"
});
---

<BaseLayout
  title="BirkyStudio vs Side (2026 Comparison)"
  description="BirkyStudio vs Side honest comparison for real estate agents. Side helps top producers own their own brokerage. BirkyStudio automates lead response, WhatsApp, and calls. Real pricing, real pros and cons."
  image="/images/comparison/side.jpg"
  >
    <script type="application/ld+json" set:html={faqLD} />
    <script type="application/ld+json" set:html={articleLD} />

    <!-- Hero -->
    <section style="background:linear-gradient(135deg,#0f172a 0%,#1e1b4b 50%,#312e81 100%);padding:100px 0 80px;position:relative;overflow:hidden;">
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 20% 50%,rgba(99,102,241,0.15),transparent 50%),radial-gradient(circle at 80% 50%,rgba(236,72,153,0.1),transparent 50%);"></div>
    <div style="max-width:900px;margin:0 auto;padding:0 32px;position:relative;z-index:1;">
      <div style="display:inline-block;padding:8px 20px;background:rgba(255,255,255,0.1);border-radius:100px;color:#a5b4fc;font-size:0.85rem;font-weight:500;margin-bottom:20px;">
        🔍 Updated September 2026 • Honest comparison
      </div>
      <h1 style="font-size:clamp(1.8rem,4vw,3rem);font-weight:800;color:white;margin-bottom:20px;line-height:1.15;">
        BirkyStudio vs Side<br>
        <span style="background:linear-gradient(135deg,#818cf8,#f472b6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Brand Ownership vs AI Automation</span>
      </h1>
      <p style="font-size:1.1rem;color:#cbd5e1;line-height:1.8;max-width:700px;">
        Side helps top-producing real estate agents launch their own brokerage companies. BirkyStudio gives agents AI that handles lead conversations, WhatsApp, and phone calls. One is about owning your brand and infrastructure. The other is about automating your daily workload. Here's how they compare — and why you might need both, not one or the other.
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <section style="padding:80px 0;background:linear-gradient(135deg,#1a0f2e 0%,#2d1b4e 100%);">
    <div style="max-width:900px;margin:0 auto;padding:0 32px;">

      <!-- Quick Answer -->
      <div style="background:linear-gradient(135deg,#1e1b4b,#312e81);border-radius:16px;padding:32px;margin-bottom:64px;border:1px solid rgba(129,140,248,0.3);">
        <h2 style="color:white;font-size:1.3rem;margin-bottom:16px;">⚡ Quick Answer</h2>
        <p style="color:#cbd5e1;line-height:1.8;margin-bottom:16px;">
          <strong style="color:white;">Choose BirkyStudio if:</strong> You're a solo agent or small team that wants AI to handle lead conversations, WhatsApp messages, phone calls, and daily admin — without restructuring your business or meeting a minimum production threshold. Best for agents who want AI labor, not a new brokerage.<br><br>
          <strong style="color:white;">Choose Side if:</strong> You're a top-producing agent ($2M+ annual volume) who wants to own your own brokerage company, keep your brand, and have a dedicated back office handling compliance, payments, and transactions. Best for agents ready to build a real estate company, not just work in one.<br><br>
          <strong style="color:white;">Better together:</strong> Many Side partners could benefit from BirkyStudio's AI receptionist handling their front desk while Side handles the back office. They don't compete — they serve different layers of the business.
        </p>
      </div>

      <!-- Article Image 1 -->
      <div style="text-align:center;margin-bottom:64px;">
        <img src="/images/comparison/side-article-1.jpg" alt="Modern real estate office with glass walls, plants, and natural light, showing a professional workspace" style="width:100%;max-width:800px;border-radius:12px;height:auto;box-shadow:0 4px 24px rgba(0,0,0,0.3);" loading="lazy">
      </div>

      <!-- Why Compare -->
      <h2 style="font-size:1.6rem;font-weight:700;color:white;margin-bottom:16px;">Why compare BirkyStudio and Side?</h2>
      <p style="color:#cbd5e1;line-height:1.8;margin-bottom:16px;">
        Side is one of the most recognized names in real estate technology. They've helped over 600 top-producing agents launch their own boutique brokerage companies — handling back-office operations, compliance, payments, and transaction management so agents can focus on growing their brand. Their platform (SideOS) powers companies that collectively do $135B+ in annual volume.
      </p>
      <p style="color:#cbd5e1;line-height:1.8;margin-bottom:16px;">
        BirkyStudio takes a different approach. Instead of changing your business structure, it gives you an AI agent that handles the front-desk work — answering calls, responding on WhatsApp, following up with leads, managing your inbox, and handling daily admin tasks. You keep your current brokerage, your current brand, and your current setup. You just add an AI that does the work you'd rather not do.
      </p>
      <p style="color:#cbd5e1;line-height:1.8;margin-bottom:40px;">
        While Side and BirkyStudio serve different layers of a real estate business, they're both competing for the same thing: your time and attention. Side wants you to invest in owning your own company. BirkyStudio wants you to invest in AI that handles the work. Both can be right — depending on where you are in your career.
      </p>

      <!-- Comparison Table -->
      <h2 id="comparison" style="font-size:1.6rem;font-weight:700;color:white;margin-bottom:24px;">BirkyStudio vs Side — Side by Side</h2>
      <div style="overflow-x:auto;margin-bottom:64px;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <thead>
            <tr style="border-bottom:2px solid #818cf8;">
              <th style="text-align:left;padding:14px 12px;color:#818cf8;font-weight:600;">Feature</th>
              <th style="text-align:left;padding:14px 12px;color:#818cf8;font-weight:600;">BirkyStudio</th>
              <th style="text-align:left;padding:14px 12px;color:#818cf8;font-weight:600;">Side</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Starting Price</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">$1,297 one-time</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">⚠️ Not published — consultation only</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.02);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Setup Time</td>
              <td style="padding:14px 12px;color:#cbd5e1;">2-3 hours (guided screen share)</td>
              <td style="padding:14px 12px;color:#cbd5e1;">Weeks to months (onboarding + compliance)</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
              <td style="padding:14px 12px;color:white;font-weight:600;">AI Lead Conversations</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ AI trained on your business</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">❌ No lead AI — focuses on transaction back office</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.02);">
              <td style="padding:14px 12px;color:white;font-weight:600;">WhatsApp Integration</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ Included (full AI conversations)</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">❌ Not available</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Phone Call Answering</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ Voice receptionist on Vapi</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">❌ Not available</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.02);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Bilingual (EN/ES)</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ Included</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">⚠️ Limited (US-based platform)</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Custom AI Training</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ Trained on your listings & process</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">⚠️ Side AI handles transaction busywork, not custom training</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.02);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Transaction Management</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">❌ Not available</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ Full contract-to-close pipeline</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Compliance & Legal</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">❌ Not available</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ Dedicated compliance team reviews every file</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.02);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Own Your Own Brokerage</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">❌ Works with your existing brokerage</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ You launch your own branded company</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Same-Day Agent Payments</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">❌ Not available</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ 85% same-day payment on close</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.02);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Minimum Production Required</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ None — works for any agent</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">⚠️ Top producers only ($2M+ volume)</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Free Trial</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ 30-day money-back guarantee</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">⚠️ Free consultation, no trial</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.02);">
              <td style="padding:14px 12px;color:white;font-weight:600;">Dedicated Support</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ Same person who built it</td>
              <td style="padding:14px 12px;color:white;font-weight:600;">✅ Dedicated partner success team</td>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
