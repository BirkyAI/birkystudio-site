---
// Demo de IA. Versión en español de src/pages/ai-demo.astro.
// Documento independiente: se incrusta como iframe en las tarjetas del portafolio
// (/es/portafolio), así que no debe llevar el menú del sitio, pero sí necesita los
// tokens de marca (no hereda hero.css).
// Los precios deben coincidir con los planes del sitio es (Quetzales).
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Birky Studio. Demo de IA en Vivo</title>
  <meta name="description" content="Mira una conversación real con el asistente de WhatsApp de Birky Studio, en inglés y español. Escenarios de agente inmobiliario, dentista, boutique y restaurante.">
  <link rel="canonical" href="https://birkystudio.com/es/ai-demo/">
  <link rel="alternate" hreflang="en" href="https://birkystudio.com/ai-demo/">
  <link rel="alternate" hreflang="es" href="https://birkystudio.com/es/ai-demo/">
  <link rel="alternate" hreflang="x-default" href="https://birkystudio.com/ai-demo/">
  <meta property="og:title" content="Birky Studio. Demo de IA en Vivo">
  <meta property="og:description" content="Mira una conversación real con el asistente de WhatsApp de Birky Studio, en inglés y español.">
  <meta property="og:image" content="https://birkystudio.com/images/birky-logo.jpg">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://birkystudio.com/es/ai-demo/">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style is:inline>
    /* Tokens de marca, copiados de src/styles/hero.css. Esta página es un
       documento independiente, así que no los hereda de BaseLayout. Sin este
       bloque, cada var(--bs-*) se resuelve a nada. */
    :root {
      --bs-bg-deep: #150b26;
      --bs-bg-raised: #241340;
      --bs-border: rgba(255, 255, 255, .08);
      --bs-text: #f5f3f7;
      --bs-text-muted: #a79fbb;
      --bs-accent: #ff2d95;
      --bs-accent-2: #b0005a;
      --bs-btn-light: #e6e3ee;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bs-bg-deep);
      color: var(--bs-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255, 255, 255, .06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, .06) 1px, transparent 1px);
      background-size: 64px 64px;
    }

    .demo-bar {
      position: relative;
      z-index: 1;
      background: linear-gradient(135deg, var(--bs-accent), var(--bs-accent-2));
      padding: 10px 20px;
      text-align: center;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      color: #fff;
      flex-shrink: 0;
    }

    .content {
      position: relative;
      z-index: 1;
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      padding: 18px 20px 20px;
    }

    .brand { text-align: center; flex-shrink: 0; }
    .wordmark {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bs-text-muted);
      margin-bottom: 6px;
    }
    .brand h1 {
      font-size: 1.5rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: #fff;
      margin-bottom: 8px;
    }
    .brand h1 em { font-style: normal; color: var(--bs-accent); }
    .brand p {
      font-size: 0.85rem;
      line-height: 1.55;
      color: var(--bs-text-muted);
      max-width: 360px;
      margin: 0 auto;
    }

    .scenario-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      flex-wrap: wrap;
      flex-shrink: 0;
    }
    .scenario {
      font-family: inherit;
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--bs-text-muted);
      background: rgba(255, 255, 255, .06);
      border: 1px solid rgba(255, 255, 255, .1);
      border-radius: 100px;
      padding: 7px 15px;
      cursor: pointer;
      transition: all .16s ease;
    }
    .scenario:hover { color: #fff; border-color: rgba(255, 45, 149, .5); }
    .scenario.is-active {
      background: var(--bs-accent);
      border-color: var(--bs-accent);
      color: #fff;
    }
    .replay {
      font-family: inherit;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(255, 255, 255, .06);
      border: 1px solid rgba(255, 255, 255, .12);
      color: var(--bs-text-muted);
      cursor: pointer;
      transition: all .16s ease;
    }
    .replay:hover:not(:disabled) { color: #fff; border-color: var(--bs-accent); }
    .replay:disabled { opacity: .4; cursor: default; }
    .replay svg { width: 15px; height: 15px; }
    .replay.is-spinning svg { animation: spin .7s linear infinite; }

    .phone-mockup {
      width: 100%;
      max-width: 380px;
      background: var(--bs-bg-raised);
      border-radius: 24px;
      padding: 18px;
      border: 1px solid rgba(255, 255, 255, .1);
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      scrollbar-width: thin;
    }

    .chat-bubble {
      max-width: 88%;
      padding: 10px 14px;
      border-radius: 16px;
      font-size: 0.85rem;
      line-height: 1.55;
      animation: popIn .3s ease both;
      flex-shrink: 0;
    }
    .chat-bubble.bot {
      background: rgba(255, 255, 255, .07);
      border: 1px solid rgba(255, 255, 255, .1);
      color: var(--bs-text);
      border-bottom-left-radius: 4px;
      align-self: flex-start;
    }
    .chat-bubble.user {
      background: var(--bs-accent);
      color: #fff;
      border-bottom-right-radius: 4px;
      align-self: flex-end;
    }
    .chat-bubble strong { font-weight: 700; }
    .chat-bubble .time { display: block; font-size: 0.65rem; color: var(--bs-text-muted); margin-top: 4px; text-align: right; }
    .chat-bubble.user .time { color: rgba(255, 255, 255, 0.65); }

    .typing-dots {
      align-self: flex-start;
      padding: 9px 16px;
      background: rgba(255, 255, 255, .07);
      border: 1px solid rgba(255, 255, 255, .1);
      border-radius: 16px;
      border-bottom-left-radius: 4px;
      display: flex;
      gap: 4px;
      flex-shrink: 0;
      animation: popIn .2s ease both;
    }
    .typing-dots span { width: 6px; height: 6px; background: var(--bs-text-muted); border-radius: 50%; animation: bounce 1.4s infinite; }
    .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
    .typing-dots span:nth-child(3) { animation-delay: 0.4s; }

    .actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      flex-wrap: wrap;
      flex-shrink: 0;
    }

    .try-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #25D366;
      color: white;
      padding: 13px 28px;
      border-radius: 100px;
      font-size: 0.95rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s;
      border: none;
      cursor: pointer;
    }
    .try-btn:hover { transform: scale(1.04); box-shadow: 0 8px 30px rgba(37,211,102,0.4); }
    .try-btn svg { width: 20px; height: 20px; flex-shrink: 0; }

    .qr-section { display: flex; flex-direction: column; align-items: center; gap: 6px; }
    .qr-section img { width: 84px; height: 84px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, .1); background: #fff; }
    .qr-section p { font-size: 0.7rem; color: var(--bs-text-muted); }

    /* No pintar la conversación del HTML y luego borrarla para reproducirla.
       El script del <head> añade .js antes del primer pintado. */
    html.js .phone-mockup > .ssr { visibility: hidden; }

    /* Dentro de la tarjeta del portafolio el QR no aporta y la cabecera puede ir
       más ajustada, lo que gana altura para el chat dentro del iframe fijo. */
    body.embedded .qr-section { display: none; }
    body.embedded .brand p { display: none; }
    body.embedded .brand h1 { font-size: 1.2rem; }
    body.embedded .phone-mockup { max-width: 400px; padding: 16px; }
    body.embedded .chat-bubble { font-size: 0.81rem; padding: 9px 13px; }
    body.embedded .content { gap: 12px; padding: 15px 16px 17px; }
    body.embedded .scenario { font-size: 0.72rem; padding: 6px 12px; }

    @keyframes bounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-6px); } }
    @keyframes popIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes spin { to { transform: rotate(360deg); } }

    @media (prefers-reduced-motion: reduce) {
      .chat-bubble, .typing-dots { animation: none; }
    }

    @media (max-width: 460px) {
      .actions { flex-direction: column; gap: 12px; }
      .brand h1 { font-size: 1.25rem; }
      .qr-section img { width: 72px; height: 72px; }
      .phone-mockup { padding: 15px; }
      .chat-bubble { font-size: 0.82rem; }
      .scenario { font-size: 0.72rem; padding: 6px 11px; }
      .scenario-row { gap: 6px; }
      .replay { width: 30px; height: 30px; }
    }
  </style>
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>

<div class="demo-bar">Demo en vivo. Este es el asistente real, en WhatsApp.</div>

<div class="content">
  <div class="brand">
    <div class="wordmark">Birky.Studio</div>
    <h1>Demo de Agente IA <em>en Vivo</em></h1>
    <p>Una conversación real con nuestro asistente de WhatsApp, en inglés o español.</p>
  </div>

  <div class="scenario-row" id="scenarios" role="group" aria-label="Elige un tipo de negocio">
    <button type="button" class="scenario is-active" data-scenario="realtor" aria-pressed="true">Inmobiliaria</button>
    <button type="button" class="scenario" data-scenario="dentist" aria-pressed="false">Dentista</button>
    <button type="button" class="scenario" data-scenario="boutique" aria-pressed="false">Boutique</button>
    <button type="button" class="scenario" data-scenario="restaurant" aria-pressed="false">Restaurante</button>
    <button type="button" class="replay" id="replay" aria-label="Reproducir la conversación otra vez">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3.2-6.9"/><path d="M21 3.5V9h-5.5"/></svg>
    </button>
  </div>

  <div class="phone-mockup" id="phone" aria-live="polite">
    <div class="chat-bubble bot ssr">
      ¡Hola! Soy el asistente de IA de Birky Studio. Puedo ayudarte con agentes de IA, planes de recepcionista y sitios web. ¿Qué tipo de negocio tienes?
      <span class="time">10:02 AM</span>
    </div>
    <div class="chat-bubble user ssr">
      Soy agente inmobiliario en Antigua
      <span class="time">10:02 AM</span>
    </div>
    <div class="chat-bubble bot ssr">
      Genial, trabajo con muchos agentes de aquí. Para un agente el <strong>agente base cuesta Q9,900</strong> e incluye un CRM en Notion hecho para inmobiliarias. ¿Quieres que te explique qué incluye?
      <span class="time">10:03 AM</span>
    </div>
    <div class="chat-bubble user ssr">
      Sí, cuéntame más
      <span class="time">10:03 AM</span>
    </div>
    <div class="chat-bubble bot ssr">
      Claro. Atrapa cada consulta de tu sitio web y de WhatsApp, califica al prospecto, lo guarda en tu CRM de Notion, te envía un resumen con un borrador de respuesta, y le da seguimiento 2 días después si nadie contestó. Bilingüe inglés y español. ¿Quieres probar el real en WhatsApp?
      <span class="time">10:04 AM</span>
    </div>
  </div>

  <div class="actions">
    <a href="https://wa.me/50234775110?text=Hola%20Birky%20Studio!%20Vi%20la%20demo%20en%20su%20sitio%20web%20y%20quiero%20probar%20la%20IA%20real." target="_blank" rel="noopener" class="try-btn">
      <svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Probar la IA Real en WhatsApp
    </a>

    <div class="qr-section">
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=https://wa.me/50234775110?text=Hola%20Birky%20Studio!%20Vi%20la%20demo%20en%20su%20sitio%20web" alt="Código QR para probar BirkyStudio en WhatsApp" loading="lazy">
      <p>Escanea para probarlo</p>
    </div>
  </div>
</div>

<script is:inline>
  if (window.self !== window.top) document.body.classList.add('embedded');

  // Los precios deben coincidir con los planes del sitio en Quetzales.
  var SCENARIOS = {
    realtor: [
      { from: 'bot',  text: "¡Hola! Soy el asistente de IA de Birky Studio. Puedo ayudarte con agentes de IA, planes de recepcionista y sitios web. ¿Qué tipo de negocio tienes?" },
      { from: 'user', text: "Soy agente inmobiliario en Antigua" },
      { from: 'bot',  text: "Genial, trabajo con muchos agentes de aquí. Para un agente el <strong>agente base cuesta Q9,900</strong> e incluye un CRM en Notion hecho para inmobiliarias. ¿Quieres que te explique qué incluye?" },
      { from: 'user', text: "Sí, cuéntame más" },
      { from: 'bot',  text: "Claro. Atrapa cada consulta de tu sitio web y de WhatsApp, califica al prospecto, lo guarda en tu CRM de Notion, te envía un resumen con un borrador de respuesta, y le da seguimiento 2 días después si nadie contestó. Bilingüe inglés y español. ¿Quieres probar el real en WhatsApp?" }
    ],
    dentist: [
      { from: 'bot',  text: "¡Hola! Soy el asistente de IA de Birky Studio. ¿Qué tipo de negocio tienes?" },
      { from: 'user', text: "Una clínica dental. Dos sillas, y la recepción solo contesta en horario de oficina" },
      { from: 'bot',  text: "Entendido. Para una clínica la <strong>recepcionista de voz cuesta Q4,200</strong>. Contesta cada llamada 24/7, agenda las citas directo en tu calendario y te marca lo urgente. ¿Quieres ver cómo funciona el agendado?" },
      { from: 'user', text: "Sí. Perdemos muchas llamadas a la hora del almuerzo" },
      { from: 'bot',  text: "Esa es la típica. Contesta mientras la recepción está cerrada, ofrece el siguiente espacio libre y confirma por WhatsApp. Recibes una lista diaria de quién agendó y por qué. Bilingüe. ¿Quieres probar el real en WhatsApp?" }
    ],
    boutique: [
      { from: 'bot',  text: "¡Hola! Soy el asistente de IA de Birky Studio. ¿Qué vendes?" },
      { from: 'user', text: "Una boutique de ropa. Casi todos los pedidos llegan por WhatsApp" },
      { from: 'bot',  text: "Eso encaja con la <strong>recepcionista de texto, Q2,300</strong>. Contesta las mismas preguntas de tallas y envíos todo el día, toma los datos del pedido y guarda cada cliente en tu CRM. ¿Quieres ver cómo maneja una pregunta de talla?" },
      { from: 'user', text: "Sí, eso es casi todo mi día" },
      { from: 'bot',  text: "Responde en segundos con tu guía de tallas, pide las dos medidas que necesita y te manda el resumen del pedido. Nada se queda sin contestar de noche. Bilingüe. ¿Quieres probar el real en WhatsApp?" }
    ],
    restaurant: [
      { from: 'bot',  text: "¡Hola! Soy el asistente de IA de Birky Studio. ¿Cuál es tu tipo de negocio?" },
      { from: 'user', text: "Un restaurante. Recibimos las mismas llamadas todo el día" },
      { from: 'bot',  text: "Muy común. La <strong>recepcionista de voz, Q4,200</strong>, contesta horarios, el menú y las reservas, y las agenda en tu propio calendario. ¿Quieres saber qué pasa una noche llena?" },
      { from: 'user', text: "Sí, ahí es cuando se complica" },
      { from: 'bot',  text: "Ofrece la siguiente mesa disponible, los pone en lista de espera y te marca la solicitud. No se pierde ninguna llamada mientras la cocina está ocupada. Bilingüe. ¿Quieres probar el real en WhatsApp?" }
    ]
  };

  (function () {
    var phone = document.getElementById('phone');
    var replay = document.getElementById('replay');
    var pills = Array.prototype.slice.call(document.querySelectorAll('.scenario'));
    var active = 'realtor';
    var timers = [];
    var playing = false;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function clearTimers() {
      timers.forEach(clearTimeout);
      timers = [];
    }

    function atBottom() { phone.scrollTop = phone.scrollHeight; }

    function bubble(msg) {
      var el = document.createElement('div');
      el.className = 'chat-bubble ' + msg.from;
      el.innerHTML = msg.text;
      return el;
    }

    function typing() {
      var el = document.createElement('div');
      el.className = 'typing-dots';
      el.innerHTML = '<span></span><span></span><span></span>';
      return el;
    }

    function paint(msgs) {
      phone.innerHTML = '';
      msgs.forEach(function (m) { phone.appendChild(bubble(m)); });
      atBottom();
    }

    function setPlaying(on) {
      playing = on;
      replay.disabled = on;
      replay.classList.toggle('is-spinning', on);
    }

    function play(key) {
      active = key;
      clearTimers();
      pills.forEach(function (p) {
        var on = p.dataset.scenario === key;
        p.classList.toggle('is-active', on);
        p.setAttribute('aria-pressed', on ? 'true' : 'false');
      });

      var msgs = SCENARIOS[key] || [];
      phone.innerHTML = '';

      if (reduce) { paint(msgs); setPlaying(false); return; }

      setPlaying(true);
      var t = 0;
      msgs.forEach(function (m) {
        if (m.from === 'bot') {
          t += 320;
          var dots = typing();
          (function () {
            var at = t;
            timers.push(setTimeout(function () {
              phone.appendChild(dots);
              atBottom();
            }, at));
          })();
          t += 950;
          (function (msg, node) {
            var at = t;
            timers.push(setTimeout(function () {
              if (node.parentNode) node.parentNode.removeChild(node);
              phone.appendChild(bubble(msg));
              atBottom();
            }, at));
          })(m, dots);
        } else {
          t += 750;
          (function (msg) {
            var at = t;
            timers.push(setTimeout(function () {
              phone.appendChild(bubble(msg));
              atBottom();
            }, at));
          })(m);
        }
      });
      timers.push(setTimeout(function () { setPlaying(false); }, t + 200));
    }

    pills.forEach(function (p) {
      p.addEventListener('click', function () { play(p.dataset.scenario); });
    });
    replay.addEventListener('click', function () { play(active); });

    var started = false;
    function startOnce() {
      if (started) return;
      started = true;
      play('realtor');
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { setTimeout(startOnce, 450); io.disconnect(); }
        });
      }, { threshold: 0.25 });
      io.observe(phone);
    } else {
      setTimeout(startOnce, 400);
    }
  })();
</script>

</body>
</html>
