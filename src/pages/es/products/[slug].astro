---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { products, getProduct } from '../../../data/products-es.js';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProduct(slug);

if (!product) {
  return Astro.redirect('/es/products/');
}

const title = product.name;
const description = `${product.tagline}, ${product.price} ${product.priceNote}. Ve exactamente qué incluye y qué no.`;

const productSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.tagline,
  brand: { '@type': 'Brand', name: 'Birky Studio' },
  image: 'https://birkystudio.com/images/birky-logo.jpg',
  offers: {
    '@type': 'Offer',
    url: `https://birkystudio.com/es/products/${product.slug}/`,
    priceCurrency: 'USD',
    price: product.price.replace(/[^0-9.]/g, '') || undefined,
    availability: 'https://schema.org/InStock',
  },
});

const faqSchema = product.faqs?.length
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: product.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })
  : null;
---

<BaseLayout title={title} description={description} image="/images/birky-logo.jpg">
  <script type="application/ld+json" set:html={productSchema} />
  {faqSchema && <script type="application/ld+json" set:html={faqSchema} />}

  <!-- Hero -->
  <section style="padding:80px 0 60px">
    <div class="container" style="max-width:900px;">
      <a href="/es/products" style="color:var(--bs-text-muted);font-size:0.9rem;font-weight:500;display:inline-block;margin-bottom:24px;">← Todos los productos</a>
      <div style="display:inline-block;padding:6px 16px;background:rgba(255,45,149,0.22);border-radius:100px;color:var(--bs-accent);font-size:0.82rem;font-weight:600;margin-bottom:20px;">
        {product.icon} {product.category}
      </div>
      {product.badge && (
        <div style={`display:inline-block;padding:6px 16px;margin-left:8px;background:${product.accent};border-radius:100px;color:white;font-size:0.82rem;font-weight:600;margin-bottom:20px;`}>
          {product.badge}
        </div>
      )}
      <h1 style="font-size:2.8rem;color:white;margin-bottom:16px;line-height:1.15;text-transform:uppercase;">{product.name.split(' ').slice(0, -1).join(' ')} <em style="font-style:normal;color:var(--bs-accent);">{product.name.split(' ').slice(-1)}</em></h1>
      <p style="color:var(--bs-text-muted);font-size:1.25rem;line-height:1.7;max-width:680px;margin-bottom:32px;">{product.tagline}</p>

      <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <span style="font-size:3rem;font-weight:800;color:white;text-transform:uppercase;">{product.price}</span>
        <span style="color:var(--bs-text-muted);font-size:1.1rem;">{product.priceNote}</span>
      </div>

      <a href="/es/contacto" class="btn btn-purple" style="font-size:1.05rem;padding:16px 36px;">Empezar →</a>
    </div>
  </section>

  <!-- Qué es -->
  <section style="padding:64px 0">
    <div class="container" style="max-width:900px;">
      <h2 style="font-size:1.8rem;color:white;margin-bottom:20px;text-transform:uppercase;">Qué <em style="font-style:normal;color:var(--bs-accent);">es</em></h2>
      <p style="color:var(--bs-text);font-size:1.08rem;line-height:1.9;">{product.whatItIs}</p>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px;margin-top:40px;">
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;">
          <div style="font-size:0.8rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--bs-accent);margin-bottom:8px;">Entrega</div>
          <p style="color:var(--bs-text);font-size:0.98rem;line-height:1.7;margin:0;">{product.delivery}</p>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;">
          <div style="font-size:0.8rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#f9a8d4;margin-bottom:8px;">Ideal para</div>
          <p style="color:var(--bs-text);font-size:0.98rem;line-height:1.7;margin:0;">{product.bestFor}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Qué incluye + Qué no incluye -->
  <section style="padding:64px 0">
    <div class="container" style="max-width:900px;display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:40px;">
      <div>
        <h2 style="font-size:1.6rem;color:white;margin-bottom:24px;text-transform:uppercase;">Qué <em style="font-style:normal;color:var(--bs-accent);">incluye</em></h2>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:16px;">
          {product.included.map((item) => (
            <li style="color:var(--bs-text);display:flex;align-items:flex-start;gap:12px;font-size:1.02rem;line-height:1.7;">
              <span style="color:var(--bs-accent);flex-shrink:0;font-weight:700;">✓</span>
              <span set:html={item} />
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 style="font-size:1.6rem;color:white;margin-bottom:24px;text-transform:uppercase;">Qué no <em style="font-style:normal;color:var(--bs-accent);">incluye</em></h2>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:16px;">
          {product.boundaries.map((item) => (
            <li style="color:var(--bs-text-muted);display:flex;align-items:flex-start;gap:12px;font-size:1.02rem;line-height:1.7;">
              <span style="color:var(--bs-text-muted);flex-shrink:0;font-weight:700;">✕</span>
              <span set:html={item} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {product.faqs?.length && (
    <section style="padding:64px 0">
      <div class="container" style="max-width:820px;">
        <h2 style="font-size:1.8rem;color:white;margin-bottom:32px;text-transform:uppercase;">Preguntas sobre {product.name.split(' ').slice(0, -1).join(' ')} <em style="font-style:normal;color:var(--bs-accent);">{product.name.split(' ').slice(-1)}</em></h2>
        <div style="display:flex;flex-direction:column;gap:16px;">
          {product.faqs.map((f) => (
            <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;">
              <h3 style="color:white;font-size:1.05rem;font-weight:600;margin:0 0 12px;">{f.q}</h3>
              <p style="color:var(--bs-text-muted);font-size:0.98rem;line-height:1.8;margin:0;">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section style="padding:80px 0;text-align:center">
    <div class="container">
      <h2 style="font-size:2rem;margin-bottom:16px;text-transform:uppercase;">¿Listo para <em style="font-style:normal;color:var(--bs-accent);">empezar?</em></h2>
      <p style="color:var(--color-gray);font-size:1.05rem;max-width:520px;margin:0 auto 32px;">
        Cuéntanos qué necesitas y nosotros nos encargamos, entrega rápida, sin contratos.
      </p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/es/contacto" class="btn btn-purple" style="font-size:1.05rem;padding:16px 32px;">Empezar →</a>
        <a href="/es/products" class="btn btn-outline" style="font-size:1.05rem;padding:16px 32px;border:2px solid var(--bs-accent);color:var(--bs-accent);border-radius:12px;text-decoration:none;font-weight:600;">Ver Todos los Productos</a>
      </div>
    </div>
  </section>
</BaseLayout>