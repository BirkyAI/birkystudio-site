---
import BaseLayout from '../../layouts/BaseLayout.astro';

const oneTime = [
  { name: 'Agente Base, solo', retail: '$1,297', pay: '$648', keep: '$649' },
  { name: 'Agente Base, con equipo', retail: '$2,997', pay: '$1,498', keep: '$1,499' },
  { name: 'Recepcionista de Texto (WhatsApp)', retail: '$297', pay: '$148', keep: '$149' },
  { name: 'Recepcionista de Voz (teléfono, 24/7)', retail: '$550', pay: '$275', keep: '$275' },
  { name: 'Review Engine', retail: '$497', pay: '$248', keep: '$249' },
  { name: 'Lista de Prospectos verificada, starter (25)', retail: '$497', pay: '$248', keep: '$249' },
  { name: 'Lista de Prospectos verificada, pro (100)', retail: '$997', pay: '$498', keep: '$499' },
  { name: 'Paquete de Generación de Leads', retail: '$1,997', pay: '$998', keep: '$999' },
  { name: 'Outreach Engine', retail: '$797', pay: '$398', keep: '$399' },
  { name: 'GBP Autopilot', retail: '$397', pay: '$198', keep: '$199' },
  { name: 'Content Engine', retail: '$497', pay: '$248', keep: '$249' },
  { name: 'Sitio Web Starter (1 a 3 páginas)', retail: '$499', pay: '$249', keep: '$250' },
  { name: 'Sitio Web Profesional (EN y ES)', retail: '$999', pay: '$499', keep: '$500' },
  { name: 'Sitio Web Premium (10+ páginas con blog)', retail: '$1,999', pay: '$999', keep: '$1,000' },
  { name: 'CMS Auto-Editable', retail: '$130', pay: '$65', keep: '$65' },
  { name: 'Evaluación Personalizada, solo', retail: '$349', pay: '$174', keep: '$175' },
  { name: 'Evaluación Personalizada, negocio', retail: '$999', pay: '$499', keep: '$500' },
];

const monthly = [
  { name: 'Cuidado y Mantenimiento', retail: '$97', pay: '$48', keep: '$49' },
  { name: 'Business AI Partner', retail: '$197', pay: '$98', keep: '$99' },
  { name: 'Content Booster', retail: '$149', pay: '$74', keep: '$75' },
  { name: 'Content Pro', retail: '$199', pay: '$99', keep: '$100' },
];
---

<BaseLayout title="Programa de Marca Blanca IA" description="Revende agentes de IA, recepcionistas, generación de leads y sitios web bajo tu propia marca. Compras a la mitad del precio publicado, vendes al precio publicado y te quedas con la diferencia." image="/images/birky-logo.jpg">

  <!-- Hero -->
  <section style="padding:100px 0 80px;position:relative;overflow:hidden">
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 20% 50%,rgba(255,45,149,0.15),transparent 50%),radial-gradient(circle at 80% 50%,rgba(255,45,149,0.1),transparent 50%);"></div>
    <div class="container" style="position:relative;z-index:1;text-align:center;">
      <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--bs-accent),var(--bs-accent));display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:2.2rem;box-shadow:0 0 40px rgba(255,45,149,0.3);">
        🤝
      </div>
      <h1 style="font-size:clamp(2rem,5vw,3.2rem);font-weight:800;color:white;margin-bottom:20px;text-transform:uppercase;">
        Agentes de IA al Mayoreo.<br><span style="color:var(--bs-accent);">Bajo Tu Propia Marca.</span>
      </h1>
      <p style="font-size:1.15rem;color:var(--bs-text);max-width:680px;margin:0 auto;line-height:1.8;">
        Compras a <strong>la mitad del precio publicado</strong>. Vendes al precio publicado o más, con tu propia factura y tu propia marca. Nosotros construimos, operamos y damos soporte detrás del telón, y tu cliente nunca escucha nuestro nombre.
      </p>
    </div>
  </section>

  <!-- Cómo funciona el dinero -->
  <section style="padding:80px 0">
    <div class="container">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:48px;text-transform:uppercase;">
        Cómo Funciona El <em style="font-style:normal;color:var(--bs-accent);">Dinero</em>
      </h2>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;max-width:1000px;margin:0 auto 40px;">
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;">
          <div style="font-size:2rem;margin-bottom:8px;">🏷️</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:10px;text-transform:uppercase;">Compras a la Mitad</h3>
          <p style="color:var(--bs-text-muted);font-size:0.92rem;line-height:1.7;">
            Cada producto tiene un precio de socio: la mitad del precio publicado, redondeado hacia abajo al dólar, así el dólar impar siempre queda de tu lado. Sin niveles, sin regateo, sin compromiso de volumen.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;">
          <div style="font-size:2rem;margin-bottom:8px;">🧾</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:10px;text-transform:uppercase;">Vendes Con Tu Factura</h3>
          <p style="color:var(--bs-text-muted);font-size:0.92rem;line-height:1.7;">
            Tu cliente te paga a ti, al precio publicado o más. Tu factura, tu marca, tu precio. Nosotros nunca le facturamos ni lo contactamos.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;">
          <div style="font-size:2rem;margin-bottom:8px;">💵</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:10px;text-transform:uppercase;">Te Quedas Con La Diferencia</h3>
          <p style="color:var(--bs-text-muted);font-size:0.92rem;line-height:1.7;">
            Desde la primera factura, en tu propia cuenta. Sin comisiones por cobrar, sin reparto de ingresos que seguir, sin esperar a que nosotros te paguemos.
          </p>
        </div>
      </div>

      <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;max-width:620px;margin:0 auto;">
        <h3 style="color:white;font-size:1.1rem;margin-bottom:16px;text-align:center;">📊 Un Ejemplo</h3>
        <div style="color:var(--bs-text-muted);font-size:0.95rem;line-height:1.8;">
          <p style="margin-bottom:12px;">El Recepcionista de Voz:</p>
          <div style="display:grid;grid-template-columns:1fr auto;gap:6px 16px;">
            <span style="color:var(--bs-text);">Tu cliente te paga</span><span style="color:var(--bs-text);text-align:right;">$550</span>
            <span style="color:var(--bs-text);">Tú nos pagas a Birky Studio</span><span style="color:var(--bs-text);text-align:right;">$275</span>
            <span style="border-top:1px solid rgba(255,255,255,0.15);padding-top:8px;color:white;font-weight:700;">Tú te quedas</span><span style="color:var(--bs-accent);text-align:right;font-weight:700;border-top:1px solid rgba(255,255,255,0.15);padding-top:8px;">$275</span>
          </div>
          <p style="font-size:0.88rem;margin-top:16px;">
            Con un plan mensual de cuidado el mismo reparto se aplica cada mes: tu cliente paga $97, tú nos pagas $48, tú te quedas $49 mientras se quede. Cinco clientes en cuidado son $245 al mes que llegan sin una sola venta nueva.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Lista de precios -->
  <section style="padding:80px 0">
    <div class="container" style="max-width:900px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:16px;text-transform:uppercase;">
        La Lista De Precios <em style="font-style:normal;color:var(--bs-accent);">Para Socios</em>
      </h2>
      <p style="color:var(--bs-text-muted);text-align:center;font-size:0.95rem;margin-bottom:40px;line-height:1.7;">
        Los precios publicados son los de birkystudio.com y son tu piso: nunca vendas por debajo.
      </p>

      <h3 style="color:white;font-size:1.1rem;margin-bottom:16px;text-transform:uppercase;">Pagos Únicos</h3>
      <div style="overflow-x:auto;margin-bottom:40px;">
        <table style="width:100%;border-collapse:collapse;font-size:0.92rem;">
          <thead>
            <tr>
              <th style="text-align:left;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">Producto</th>
              <th style="text-align:right;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">Tu cliente paga</th>
              <th style="text-align:right;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">Tú nos pagas</th>
              <th style="text-align:right;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">Tú te quedas</th>
            </tr>
          </thead>
          <tbody>
            {oneTime.map((p) => (
              <tr>
                <td style="padding:10px 12px;color:var(--bs-text);border-bottom:1px solid rgba(255,255,255,0.07);">{p.name}</td>
                <td style="padding:10px 12px;color:var(--bs-text-muted);text-align:right;white-space:nowrap;border-bottom:1px solid rgba(255,255,255,0.07);">{p.retail}</td>
                <td style="padding:10px 12px;color:var(--bs-text-muted);text-align:right;white-space:nowrap;border-bottom:1px solid rgba(255,255,255,0.07);">{p.pay}</td>
                <td style="padding:10px 12px;color:var(--bs-accent);text-align:right;white-space:nowrap;font-weight:600;border-bottom:1px solid rgba(255,255,255,0.07);">{p.keep}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 style="color:white;font-size:1.1rem;margin-bottom:16px;text-transform:uppercase;">Mensual, Donde Vive El Ingreso Recurrente</h3>
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:0.92rem;">
          <thead>
            <tr>
              <th style="text-align:left;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">Producto</th>
              <th style="text-align:right;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">Tu cliente paga</th>
              <th style="text-align:right;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">Tú nos pagas</th>
              <th style="text-align:right;color:var(--bs-text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.15);">Tú te quedas</th>
            </tr>
          </thead>
          <tbody>
            {monthly.map((p) => (
              <tr>
                <td style="padding:10px 12px;color:var(--bs-text);border-bottom:1px solid rgba(255,255,255,0.07);">{p.name}</td>
                <td style="padding:10px 12px;color:var(--bs-text-muted);text-align:right;white-space:nowrap;border-bottom:1px solid rgba(255,255,255,0.07);">{p.retail} / mes</td>
                <td style="padding:10px 12px;color:var(--bs-text-muted);text-align:right;white-space:nowrap;border-bottom:1px solid rgba(255,255,255,0.07);">{p.pay}</td>
                <td style="padding:10px 12px;color:var(--bs-accent);text-align:right;white-space:nowrap;font-weight:600;border-bottom:1px solid rgba(255,255,255,0.07);">{p.keep}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p style="color:var(--bs-text-muted);font-size:0.88rem;margin-top:24px;line-height:1.8;">
        El uso de llamadas de voz se factura al costo, entre $30 y $50 por cliente al mes vía Vapi, sin margen. Si prefieres ser tú la primera línea de soporte, te quedas con todo el mensual.
      </p>
    </div>
  </section>

  <!-- Cinco reglas -->
  <section style="padding:80px 0">
    <div class="container" style="max-width:800px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:40px;text-transform:uppercase;">
        Cinco Reglas, Para No Negociar <em style="font-style:normal;color:var(--bs-accent);">Dos Veces</em>
      </h2>
      <div style="display:grid;gap:16px;">
        <div style="background:rgba(255,45,149,0.08);border:1px solid rgba(255,45,149,0.25);border-radius:12px;padding:22px 26px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:6px;text-transform:uppercase;">El precio publicado es el piso</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">Vende al precio publicado o más. Bajar el precio a otros socios, o a nuestros propios clientes, es lo único que termina un acuerdo.</p>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:22px 26px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:6px;text-transform:uppercase;">El precio de socio es entre socios</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">Nunca se ofrece a un cliente final como descuento, ni se publica fuera de una conversación de socio.</p>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:22px 26px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:6px;text-transform:uppercase;">El cliente es tuyo</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">Nunca lo contactamos directamente, ni le vendemos después. Tu lista se queda tuya.</p>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:22px 26px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:6px;text-transform:uppercase;">Solo tu marca</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">Ningún logo, nombre o enlace de Birky Studio en lo que recibe tu cliente. Si quieres marca compartida, es tu decisión y se pide antes del lanzamiento.</p>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:22px 26px;">
          <h3 style="color:white;font-size:1rem;margin-bottom:6px;text-transform:uppercase;">Treinta días de soporte incluidos</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">En cada instalación, igual que nuestros clientes directos. Después, plan de cuidado o cambios cotizados.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Para quién es -->
  <section style="padding:80px 0">
    <div class="container" style="max-width:900px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:48px;text-transform:uppercase;">
        Para Quién <em style="font-style:normal;color:var(--bs-accent);">Es</em>
      </h2>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:24px;">
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;text-align:center;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🏢</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:12px;">Agencias</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">
            Marketing, web, SEO, CRM y agencias de GoHighLevel. Suma agentes de IA y recepcionistas a lo que ya vendes, sin contratar desarrolladores ni construir una plataforma.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;text-align:center;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🛠️</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:12px;">Automatizadores</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">
            Operadores de n8n, Make y Zapier que ya tienen clientes y quieren un producto terminado de voz y leads para ofrecer, en lugar de construirlo desde cero.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:32px;text-align:center;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🤝</div>
          <h3 style="color:white;font-size:1.1rem;margin-bottom:12px;">Consultores</h3>
          <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.7;">
            Ya asesoras a dueños de negocio sobre cómo trabajan. Ahora puedes entregarles un sistema real, quedarte con el margen y dejar que nosotros carguemos la parte técnica.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section style="padding:80px 0">
    <div class="container" style="max-width:800px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:48px;text-transform:uppercase;">
        Cómo <em style="font-style:normal;color:var(--bs-accent);">Funciona</em>
      </h2>

      <div style="display:grid;grid-template-columns:1fr;gap:0px;position:relative;">
        <div style="position:absolute;left:24px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--bs-accent),var(--bs-accent));"></div>

        <div style="display:flex;gap:24px;padding-bottom:40px;position:relative;">
          <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,var(--bs-accent),var(--bs-accent));display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;color:white;flex-shrink:0;position:relative;z-index:1;">1</div>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;flex:1;">
            <h3 style="color:white;font-size:1rem;margin-bottom:4px;">Una Llamada Corta</h3>
            <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.6;">Acordamos los términos, recibes la lista de precios y el formulario de ingreso, y eres socio el mismo día. Sin compromiso de volumen, sin exclusividad, sin mínimo.</p>
          </div>
        </div>

        <div style="display:flex;gap:24px;padding-bottom:40px;position:relative;">
          <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,var(--bs-accent),var(--bs-accent));display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;color:white;flex-shrink:0;position:relative;z-index:1;">2</div>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;flex:1;">
            <h3 style="color:white;font-size:1rem;margin-bottom:4px;">Tú Lo Vendes A Tu Manera</h3>
            <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.6;">Tu pitch, tu cliente, tu precio. Nosotros quedamos fuera de la conversación. Si necesitas una demo o una respuesta técnica, te la damos para que la entregues tú.</p>
          </div>
        </div>

        <div style="display:flex;gap:24px;padding-bottom:40px;position:relative;">
          <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,var(--bs-accent),var(--bs-accent));display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;color:white;flex-shrink:0;position:relative;z-index:1;">3</div>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;flex:1;">
            <h3 style="color:white;font-size:1rem;margin-bottom:4px;">Lo Construimos Bajo Tu Marca</h3>
            <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.6;">Envías el formulario, confirmamos la cotización por escrito y construimos. El Agente Base toma unos 15 minutos más una llamada para conectar cuentas, los recepcionistas quedan listos en 1 a 3 días y los sitios web en 2 a 3 días.</p>
          </div>
        </div>

        <div style="display:flex;gap:24px;padding-bottom:0;position:relative;">
          <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,var(--bs-accent),var(--bs-accent));display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700;color:white;flex-shrink:0;position:relative;z-index:1;">4</div>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:20px 24px;flex:1;">
            <h3 style="color:white;font-size:1rem;margin-bottom:4px;">Tú Facturas Y Te Quedas Con El Margen</h3>
            <p style="color:var(--bs-text-muted);font-size:0.9rem;line-height:1.6;">La mitad de tu precio de socio al ordenar, la mitad al lanzar. Seguimos siendo la segunda línea de soporte detrás de ti, así siempre tienes a quién pasarle un problema técnico.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="padding:80px 0">
    <div class="container" style="max-width:760px;">
      <h2 style="font-size:1.8rem;color:white;text-align:center;margin-bottom:48px;text-transform:uppercase;">
        Preguntas <em style="font-style:normal;color:var(--bs-accent);">Frecuentes</em>
      </h2>

      <div style="display:grid;gap:16px;">
