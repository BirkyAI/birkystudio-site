---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Recupera Tu Tiempo" description="Automatiza las tareas repetitivas que se comen tu semana. Sitios web, recepcionistas y asistentes para agentes inmobiliarios y negocios locales." image="/images/birky-logo.jpg">
  
  <!-- Hero Section -->
  <section class="hero-sec">
    <div class="hero-orb o1"></div>
    <div class="hero-orb o2"></div>

    <div class="hero-wrap">
      <!-- Left: copy (texto preservado tal cual, por SEO) -->
      <div>
        <span class="hero-eyebrow">Recupera Horas Cada Semana</span>
        <h1 class="hero-h1">
          Recupera Tu<br>
          <em>Tiempo</em>
        </h1>
        <p class="hero-sub">
          Automatiza las tareas repetitivas que se comen tu semana. Dedica tus días a hacer crecer tu negocio, no a perseguirlo.
        </p>
        <div class="hero-tags">
          <span>Para Corredores</span>
          <span>Para Pequeñas y Medianas Empresas</span>
          <span>Restaurantes y Hoteles</span>
        </div>
        <div class="hero-ctas">
          <a href="/es/products/free-audit" class="btn hero-btn-white">Recuperar Mi Tiempo →</a>
          <a href="#productos" class="btn hero-btn-ghost">Ver Cómo Funciona →</a>
        </div>
      </div>

      <!-- Right: los seis bloques del agente base -->
      <div class="mod-stage">
        <div class="mod m1">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3z"/><path d="M3 7l9 6 9-6"/></svg></span>
          <span><span class="mod-label">Captura consultas</span><span class="mod-meta">Web + WhatsApp</span></span>
        </div>
        <div class="mod m2">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></span>
          <span><span class="mod-label">Califica al cliente</span><span class="mod-meta">Pregunta lo necesario</span></span>
        </div>
        <div class="mod m3">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/></svg></span>
          <span><span class="mod-label">Guarda en el CRM</span><span class="mod-meta">Notion, incluido</span></span>
        </div>
        <div class="mod m4 is-key">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 8h18s-3-1-3-8"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></span>
          <span><span class="mod-label">Te alerta con borrador</span><span class="mod-meta">Resumen + borrador</span></span>
        </div>
        <div class="mod m5">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.1a8.4 8.4 0 0 1-.9-3.9 8.4 8.4 0 0 1 8.4-8.4 8.4 8.4 0 0 1 8.6 8.4z"/></svg></span>
          <span><span class="mod-label">Respuesta automática</span><span class="mod-meta">Instantánea, ES/EN</span></span>
        </div>
        <div class="mod m6">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span>
          <span><span class="mod-label">Seguimiento a 2 días</span><span class="mod-meta">Nada se enfría</span></span>
        </div>
      </div>
    </div>
  </section>

  <div id="productos"></div>

  <!-- Precios: El Sistema (agente base + bloques) -->
  <section id="precios-ia" style="padding:100px 0">
    <div class="container">
      <div style="text-align:center;margin-bottom:56px;">
        <div style="display:inline-block;padding:6px 16px;background:rgba(255,255,255,0.1);border-radius:100px;color:white;font-size:0.85rem;font-weight:600;margin-bottom:16px;">El Sistema</div>
        <h2 class="sec-h2">Un agente. Agrega <em>solo lo que necesites.</em></h2>
        <p style="color:var(--bs-text-muted);font-size:1.1rem;max-width:640px;margin:0 auto;">El agente base es la máquina que atiende la entrada, el CRM y el seguimiento. Todo lo demás es un bloque que se suma encima, uno a la vez, solo cuando hace falta.</p>
      </div>

      <div class="sys-head first">
        <h3>Empieza aquí</h3>
        <span>Cada proyecto empieza con una conversación, no con un contrato.</span>
      </div>

      <div class="sys-assess">
        <a href="/es/products/free-audit" class="sys-tile is-first">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></div>
          <div class="sys-nm">Auditoría Gratis de 15 Minutos</div>
          <div class="sys-ds">Una llamada corta, y le ponemos nombre a lo que más tiempo te cuesta.</div>
          <div class="sys-pr">Gratis</div>
        </a>
        <a href="/es/products/custom-assessment" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M9 3h6v3H9z"/><path d="M7 6h10v14H7z"/><path d="M10 11h4M10 15h4"/></svg></div>
          <div class="sys-nm">Evaluación Personalizada, solo</div>
          <div class="sys-ds">Una entrevista de 45 minutos y un plan escrito. Se acredita contra tus bloques.</div>
          <div class="sys-pr">Q2,700</div>
        </a>
        <a href="/es/products/custom-assessment" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M9 3h6v3H9z"/><path d="M7 6h10v14H7z"/><path d="M10 11h4M10 15h4"/></svg></div>
          <div class="sys-nm">Evaluación Personalizada, negocio</div>
          <div class="sys-ds">Lo mismo, para un negocio con equipo. Medido en horas del equipo.</div>
          <div class="sys-pr">Q7,600</div>
        </a>
      </div>

      <p class="sys-note">Si las funciones que ya trae el agente base resuelven el problema, con la auditoría gratis alcanza y la evaluación pagada no hace falta. La Evaluación Personalizada es para cuando hay varios problemas que resolver, y su costo se acredita completo contra los bloques.</p>

      <!-- El agente base: el rectángulo -->
      <a href="/es/products/ai-agent-setup" class="sys-base">
        <div class="sys-base-l">
          <div class="sys-core">
            <svg viewBox="0 0 24 24"><path d="M12 2 21 7l-9 5-9-5z"/><path d="M3 12l9 5 9-5"/><path d="M3 17l9 5 9-5"/></svg>
          </div>
          <div>
            <span class="sys-eyebrow">La máquina</span>
            <h3>El Agente Base</h3>
            <p>Atrapa cada consulta del sitio web y de WhatsApp, la califica, la guarda en el CRM de Notion, la contesta al instante y le da seguimiento por su cuenta. Ningún cliente se enfría.</p>
            <div class="sys-chips">
              <span class="sys-chip">CRM en Notion incluido</span>
              <span class="sys-chip">Inglés y español</span>
              <span class="sys-chip">En vivo en unos 15 minutos</span>
              <span class="sys-chip">Es tuyo</span>
            </div>
          </div>
        </div>
        <div class="sys-price">
          <span class="sys-num">Q9,900</span>
          <span class="sys-sub">pago único, solo</span>
          <span class="sys-alt">desde <b>Q22,900</b> con equipo</span>
        </div>
      </a>

      <!-- Los bloques: los cuadrados -->
      <div class="sys-head">
        <h3>Después suma los bloques que necesites</h3>
        <span>Cada bloque es una instalación aparte. Se suman con el tiempo.</span>
      </div>

      <div class="sys-grid">
        <a href="/es/products/text-receptionist" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.1a8.4 8.4 0 0 1-.9-3.9 8.4 8.4 0 0 1 8.4-8.4 8.4 8.4 0 0 1 8.6 8.4z"/></svg></div>
          <div class="sys-nm">Recepcionista de Texto</div>
          <div class="sys-ds">Contesta tu WhatsApp de día y de noche.</div>
          <div class="sys-pr">Q2,300</div>
        </a>
        <a href="/es/products/voice-receptionist" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg></div>
          <div class="sys-nm">Recepcionista de Voz</div>
          <div class="sys-ds">Contesta tu teléfono con una voz natural, a toda hora.</div>
          <div class="sys-pr">Q4,200</div>
        </a>
        <a href="/es/products/review-engine" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.3 2.9 1-6.1L3.3 9.5l6.1-.9z"/></svg></div>
          <div class="sys-nm">Motor de Reseñas</div>
          <div class="sys-ds">Convierte a tus clientes de siempre en reseñas de Google.</div>
          <div class="sys-pr">Q3,800 <small>+ Q740/mes</small></div>
        </a>
        <a href="/es/products/lead-generation-starter-list" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></div>
          <div class="sys-nm">Lista Verificada de Prospectos</div>
          <div class="sys-ds">Una lista real y ordenada de prospectos que es tuya para siempre.</div>
          <div class="sys-pr">desde Q3,800</div>
        </a>
        <a href="/es/products/lead-generation-pack" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M22 2 11 13"/><path d="M22 2l-7 20-4-9-9-4z"/></svg></div>
          <div class="sys-nm">Paquete de Generación de Prospectos</div>
          <div class="sys-ds">La lista, más el contacto y el seguimiento que la trabaja.</div>
          <div class="sys-pr">Q15,200</div>
        </a>
        <a href="/es/products/outreach-engine" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M3 5h18v14H3z"/><path d="M3 6l9 7 9-7"/></svg></div>
          <div class="sys-nm">Motor de Contacto</div>
          <div class="sys-ds">Hace el primer contacto por correo, cumpliendo las normas.</div>
          <div class="sys-pr">Q6,100</div>
        </a>
        <a href="/es/products/gbp-autopilot" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></div>
          <div class="sys-nm">Piloto Automático de Google</div>
          <div class="sys-ds">Mantiene publicando tu Perfil de Empresa de Google.</div>
          <div class="sys-pr">Q3,000</div>
        </a>
        <a href="/es/products/content-engine" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div>
          <div class="sys-nm">Motor de Contenido</div>
          <div class="sys-ds">Contenido de blog y SEO, escrito y publicado por ti.</div>
          <div class="sys-pr">Q3,800</div>
        </a>
      </div>

      <p class="sys-foot">Los bloques empiezan en Q2,300, y los bloques a la medida se cotizan. El cuidado mensual después de la instalación: <b>Q740</b> Cuidado y Mantenimiento, o <b>Q1,500</b> Socio de IA para Negocios.</p>
    </div>
  </section>

  <style>
    .sys-base{display:flex;align-items:center;justify-content:space-between;gap:36px;text-decoration:none;
      background:var(--bs-bg-raised);border:1.5px solid rgba(255,45,149,.45);border-radius:24px;padding:34px 40px;
      box-shadow:0 22px 60px rgba(255,45,149,.20),0 0 0 1px rgba(255,45,149,.12);transition:transform .2s ease,box-shadow .2s ease}
    .sys-base:hover{transform:translateY(-3px);box-shadow:0 30px 70px rgba(255,45,149,.28),0 0 0 1px rgba(255,45,149,.18)}
    .sys-base-l{display:flex;gap:20px;align-items:flex-start;max-width:680px}
    .sys-core{width:58px;height:58px;flex:0 0 58px;border-radius:15px;display:grid;place-items:center;
      background:rgba(255,45,149,.14);border:1px solid rgba(255,45,149,.42)}
    .sys-core svg{width:26px;height:26px;fill:none;stroke:var(--bs-accent);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
    .sys-eyebrow{display:block;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--bs-accent);font-weight:600;margin-bottom:8px}
    .sys-base h3{margin:0 0 8px;font-size:1.5rem;color:white;letter-spacing:-.01em}
    .sys-base p{margin:0;color:var(--bs-text-muted);font-size:.98rem;line-height:1.65}
    .sys-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
    .sys-chip{font-size:.76rem;color:var(--bs-text-muted);border:1px solid var(--bs-border);
      background:rgba(255,255,255,.04);border-radius:100px;padding:5px 12px}
    .sys-price{text-align:right;white-space:nowrap;flex:0 0 auto}
    .sys-num{font-size:2.5rem;font-weight:800;letter-spacing:-.03em;display:block;line-height:1;color:white}
    .sys-sub{color:var(--bs-text-muted);font-size:.82rem;display:block;margin-top:4px}
    .sys-alt{margin-top:12px;padding-top:12px;border-top:1px solid var(--bs-border);color:var(--bs-text-muted);font-size:.85rem;display:block}
    .sys-alt b{color:white;font-weight:700}
    .sys-head{display:flex;align-items:baseline;gap:14px;margin:52px 0 20px}
    .sys-head h3{margin:0;font-size:1.35rem;color:white;letter-spacing:-.01em}
    .sys-head span{color:var(--bs-text-muted);font-size:.88rem}
    .sys-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
    .sys-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .sys-grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
    .sys-tile.auto{aspect-ratio:auto;min-height:170px}
    .sys-assess{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .sys-tile{position:relative;text-decoration:none;background:var(--bs-bg-raised);border:1px solid var(--bs-border);
      border-radius:18px;padding:24px;aspect-ratio:1/1;display:flex;flex-direction:column;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}
    .sys-tile:hover{transform:translateY(-4px);border-color:rgba(255,45,149,.42);box-shadow:0 18px 40px rgba(0,0,0,.4)}
    .sys-tile.is-first{border-color:rgba(255,45,149,.45);box-shadow:0 0 0 1px rgba(255,45,149,.12)}
    .sys-ic{width:38px;height:38px;flex:0 0 38px;border-radius:11px;display:grid;place-items:center;
      background:rgba(255,255,255,.05);border:1px solid var(--bs-border);margin-bottom:16px}
    .sys-ic svg{width:18px;height:18px;fill:none;stroke:var(--bs-text);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
    .sys-nm{font-size:1.05rem;font-weight:600;letter-spacing:-.01em;margin-bottom:6px;color:white}
    .sys-ds{color:var(--bs-text-muted);font-size:.88rem;line-height:1.5;flex-grow:1}
    .sys-pr{font-size:1.05rem;font-weight:700;margin-top:16px;color:white}
    .sys-pr small{color:var(--bs-text-muted);font-weight:500;font-size:.78rem}
    .sys-note{max-width:820px;margin:22px auto 44px;text-align:center;color:var(--bs-text-muted);font-size:.88rem;line-height:1.65}
    .sys-foot{margin-top:28px;text-align:center;color:var(--bs-text-muted);font-size:.9rem}
    .sys-foot b{color:var(--bs-text);font-weight:600}
    .sys-head.first{margin-top:0}
    @media (max-width:820px){
      .sys-grid,.sys-grid3{grid-template-columns:repeat(2,1fr)}
      .sys-grid2{grid-template-columns:1fr}
      .sys-assess{grid-template-columns:repeat(2,1fr)}
      .sys-base{flex-direction:column;align-items:flex-start;gap:22px}
      .sys-price{text-align:left}
    }
    @media (max-width:520px){ .sys-grid,.sys-grid3,.sys-grid2{grid-template-columns:1fr} .sys-assess{grid-template-columns:1fr} }
  </style>

    <!-- Pricing: Websites -->
  <section id="precios-sitios" style="padding:100px 0">
    <div class="container">
      <div style="text-align:center;margin-bottom:56px;">
        <div style="display:inline-block;padding:6px 16px;background:rgba(255,255,255,0.1);border-radius:100px;color:white;font-size:0.85rem;font-weight:600;margin-bottom:16px;">Diseño de Sitios Web</div>
        <h2 class="sec-h2">Planes de <em>Sitio Web</em></h2>
        <p style="color:var(--bs-text-muted);font-size:1.1rem;max-width:640px;margin:0 auto;">Sitios web profesionales a precios justos, más los complementos que los mantienen creciendo. Sin costos escondidos.</p>
      </div>

      <div class="sys-grid3">
        <a href="/es/products/website-starter" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/></svg></div>
          <div class="sys-nm">Sitio Web Inicial</div>
          <div class="sys-ds">Perfecto para negocios que apenas empiezan. 1 a 3 páginas.</div>
          <div class="sys-pr">Q3,800</div>
        </a>
        <a href="/es/products/website-professional" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/></svg></div>
          <div class="sys-nm">Sitio Web Profesional</div>
          <div class="sys-ds">Para negocios que están creciendo, bilingüe.</div>
          <div class="sys-pr">Q7,600</div>
        </a>
        <a href="/es/products/website-premium" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/></svg></div>
          <div class="sys-nm">Sitio Web Premium</div>
          <div class="sys-ds">Negocios ya establecidos, 10+ páginas con blog.</div>
          <div class="sys-pr">Q15,300</div>
        </a>
        <a href="/es/products/self-editing-cms" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></div>
          <div class="sys-nm">CMS Auto-Editable</div>
          <div class="sys-ds">Cambia textos y fotos tú mismo, sin programar.</div>
          <div class="sys-pr">Q1,000</div>
        </a>
        <a href="/es/products/content-booster" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div>
          <div class="sys-nm">Impulsor de Contenido</div>
          <div class="sys-ds">Un artículo de blog al día y publicaciones de Google cada semana.</div>
          <div class="sys-pr">Q1,140 <small>/mes</small></div>
        </a>
        <a href="/es/products/content-pro" class="sys-tile">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg></div>
          <div class="sys-nm">Contenido Pro</div>
          <div class="sys-ds">Todo el contenido más actualizaciones mensuales.</div>
          <div class="sys-pr">Q1,520 <small>/mes</small></div>
        </a>
      </div>
    </div>
  </section>

    <!-- Pricing: AI Receptionist -->
  <section id="precios-recepcionista" style="padding:100px 0">
    <div class="container">
      <div style="text-align:center;margin-bottom:56px;">
        <div style="display:inline-block;padding:6px 16px;background:rgba(255,255,255,0.1);border-radius:100px;color:white;font-size:0.85rem;font-weight:600;margin-bottom:16px;">Recepcionista</div>
        <h2 class="sec-h2">Planes de <em>Recepcionista</em></h2>
        <p style="color:var(--bs-text-muted);font-size:1.1rem;max-width:640px;margin:0 auto;">Tu recepcionista de IA contesta llamadas y mensajes a toda hora, para que nunca pierdas un cliente. Funciona por sí sola, no hace falta el agente base.</p>
      </div>

      <div class="sys-grid2">
        <a href="/es/products/text-receptionist" class="sys-tile auto">
          <div class="sys-ic"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.1a8.4 8.4 0 0 1-.9-3.9 8.4 8.4 0 0 1 8.4-8.4 8.4 8.4 0 0 1 8.6 8.4z"/></svg></div>
          <div class="sys-nm">Recepcionista de Texto</div>
          <div class="sys-ds">Contesta tu WhatsApp de día y de noche. Funciona por sí sola.</div>
          <div class="sys-pr">Q2,300</div>
