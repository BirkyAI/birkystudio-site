---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Recupera Tu Tiempo" description="Automatiza las tareas repetitivas que se comen tu semana. Sitios web, recepcionistas y asistentes para agentes inmobiliarios y negocios locales." image="/images/birky-logo.jpg">
  
  <!-- Hero Section -->
  <section class="hero-sec">
    <div class="hero-orb o1"></div>
    <div class="hero-orb o2"></div>

    <div class="hero-wrap">
      <!-- Left: copy (texto preservado tal cual, por SEO) -->
      <div>
        <span class="hero-eyebrow">Recupera Horas Cada Semana</span>
        <h1 class="hero-h1">
          Recupera Tu<br>
          <em>Tiempo</em>
        </h1>
        <p class="hero-sub">
          Automatiza las tareas repetitivas que se comen tu semana. Dedica tus días a hacer crecer tu negocio, no a perseguirlo.
        </p>
        <div class="hero-tags">
          <span>Para Corredores</span>
          <span>Para Negocios Locales</span>
          <span>Restaurantes y Hoteles</span>
        </div>
        <div class="hero-ctas">
          <a href="/es/contacto" class="btn hero-btn-primary">Recuperar Mi Tiempo →</a>
          <a href="#productos" class="btn hero-btn-ghost">Ver Cómo Funciona</a>
        </div>
      </div>

      <!-- Right: los seis bloques del agente base -->
      <div class="mod-stage">
        <div class="mod m1">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3z"/><path d="M3 7l9 6 9-6"/></svg></span>
          <span><span class="mod-label">Captura consultas</span><span class="mod-meta">Web + WhatsApp</span></span>
        </div>
        <div class="mod m2">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></span>
          <span><span class="mod-label">Califica al cliente</span><span class="mod-meta">Pregunta lo necesario</span></span>
        </div>
        <div class="mod m3">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/></svg></span>
          <span><span class="mod-label">Guarda en el CRM</span><span class="mod-meta">Notion, incluido</span></span>
        </div>
        <div class="mod m4 is-key">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 8h18s-3-1-3-8"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></span>
          <span><span class="mod-label">Te alerta con borrador</span><span class="mod-meta">Resumen + borrador</span></span>
        </div>
        <div class="mod m5">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.1a8.4 8.4 0 0 1-.9-3.9 8.4 8.4 0 0 1 8.4-8.4 8.4 8.4 0 0 1 8.6 8.4z"/></svg></span>
          <span><span class="mod-label">Respuesta automática</span><span class="mod-meta">Instantánea, ES/EN</span></span>
        </div>
        <div class="mod m6">
          <span class="mod-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span>
          <span><span class="mod-label">Seguimiento a 2 días</span><span class="mod-meta">Nada se enfría</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing: AI Agent -->
  <section id="precios-ia" style="padding:100px 0">
    <div class="container">
      <div style="text-align:center;margin-bottom:64px;">
        <div style="display:inline-block;padding:6px 16px;background:rgba(255,45,149,0.16);border-radius:100px;color:var(--bs-accent);font-size:0.85rem;font-weight:600;margin-bottom:16px;"><svg viewBox="0 0 24 24" style="width:34px;height:34px;stroke:var(--bs-accent);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;"><rect x="4" y="8" width="16" height="12" rx="3"/><path d="M12 8V4"/><circle cx="9" cy="14" r="1.2"/><circle cx="15" cy="14" r="1.2"/></svg> Asistente</div>
        <h2 style="font-size:2.5rem;color:white;margin-bottom:16px;">Plan de Asistente</h2>
        <p style="color:var(--bs-text-muted);font-size:1.1rem;max-width:600px;margin:0 auto;">Un asistente de IA instalado en tu computadora, trabaja con tu correo, archivos y CRM. Bilingüe ES/EN, 24/7.</p>
      </div>
      
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:32px;max-width:1200px;margin:0 auto;">
        <!-- AI Agent Setup -->
        <div style="background:linear-gradient(135deg,rgba(255,45,149,0.16),rgba(255,45,149,0.16));border:2px solid rgba(255,45,149,0.45);border-radius:24px;padding:40px;position:relative;display:flex;flex-direction:column;">
          <div style="position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--bs-accent);color:white;padding:6px 20px;border-radius:100px;font-size:0.85rem;font-weight:600;">Más Popular</div>
          <h3 style="color:white;font-size:1.5rem;margin-bottom:8px;">Asistente</h3>
          <p style="color:var(--bs-text-muted);margin-bottom:24px;">Asistente IA dedicado para tu negocio, incluye CRM de Notion</p>
          <div style="margin-bottom:32px;">
            <span style="font-size:3rem;font-weight:800;color:white;">Q9,900</span>
            <span style="color:var(--bs-text-muted);"> configuración única</span>
          </div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:16px;margin-bottom:32px;">
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Responde preguntas de clientes y toma mensajes 24/7</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Gestión de correo y seguimientos automáticos</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Automatización de contenido para Google Business</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Multi-plataforma (WhatsApp + Telegram + Email)</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Bilingüe (ES/EN) + integración CRM</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> <strong style="color:white;">CRM de Notion para agentes</strong>. CRM, comisiones, planificador</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Captura, califica y da seguimiento a cada lead automáticamente</li>
          </ul>
          <a href="/es/products/ai-agent-setup" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:auto;background:var(--bs-accent);box-shadow:0 4px 15px rgba(255,45,149,0.35);">Más Información</a>
        </div>

        <!-- Support & Maintenance -->
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:24px;padding:40px;backdrop-filter:blur(10px);display:flex;flex-direction:column;">
          <h3 style="color:white;font-size:1.5rem;margin-bottom:8px;">Soporte y Mantenimiento</h3>
          <p style="color:var(--bs-text-muted);margin-bottom:24px;">Optimización continua y soporte prioritario</p>
          <div style="margin-bottom:8px;">
            <span style="font-size:3rem;font-weight:800;color:white;">Q1,500</span>
            <span style="color:var(--bs-text-muted);">/mes</span>
          </div>
          <p style="color:var(--bs-accent);font-size:0.85rem;font-weight:500;margin-bottom:24px;">Sin contrato, cancela cuando quieras</p>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:16px;margin-bottom:32px;">
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Llamada mensual de optimización</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Informe de rendimiento mensual</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Ajustes y mejoras continuas</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Mantenimiento y actualizaciones</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Soporte prioritario, sin esperas</li>
          </ul>
          <a href="/es/products/business-ai-partner" class="btn btn-secondary" style="width:100%;justify-content:center;margin-top:auto;">Más Información</a>
        </div>

        <!-- Paquete de Generación de Prospectos -->
        <div style="background:linear-gradient(135deg,rgba(255,45,149,0.12),rgba(255,45,149,0.16));border:2px solid rgba(255,45,149,0.45);border-radius:24px;padding:40px;position:relative;display:flex;flex-direction:column;">
          <div style="position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--bs-bg-raised);color:white;padding:6px 20px;border-radius:100px;font-size:0.85rem;font-weight:600;">Nuevo</div>
          <h3 style="color:white;font-size:1.5rem;margin-bottom:8px;">Paquete de Generación de Prospectos</h3>
          <p style="color:var(--bs-text-muted);margin-bottom:24px;">Prospectos verificados + IA que les da seguimiento. <strong style="color:white;">Tus prospectos son tuyos. Tu código es tuyo. Tu tranquilidad, también.</strong></p>
          <div style="margin-bottom:32px;">
            <span style="font-size:3rem;font-weight:800;color:white;">Q15,200</span>
            <span style="color:var(--bs-text-muted);"> pago único, es tuyo para siempre</span>
          </div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:16px;margin-bottom:32px;">
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Lista de prospectos verificada, reales, enriquecidos, puntuados (cualquier nicho)</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Configuración de contacto automatizado</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Agente de IA entrenado en tu nicho y tu propuesta</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Recepcionista IA que captura y califica respuestas 24/7</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Sin suscripción, sin contratos, nada que cancelar</li>
          </ul>
          <a href="/es/products/lead-generation-pack" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:auto;background:var(--bs-bg-raised);box-shadow:0 4px 15px rgba(255,45,149,0.35);">Más Información</a>
        </div>
      </div>

      <!-- Segunda fila: tiles cuadrados -->
      <div style="text-align:center;margin:56px 0 28px;padding-top:40px;border-top:1px solid rgba(255,255,255,0.1);">
        <p style="color:var(--bs-text-muted);font-size:1rem;margin:0;">¿Ya tienes un agente de IA o un proceso de contacto? <strong style="color:white;">Súmale combustible</strong>, una lista de prospectos verificada que es tuya, o un sistema que convierte a tus clientes anteriores en reseñas.</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:32px;max-width:1140px;margin:0 auto;">
        <!-- Lista Inicial de Prospectos -->
        <div style="background:linear-gradient(135deg,rgba(255,45,149,0.10),rgba(255,45,149,0.04));border:2px solid rgba(255,45,149,0.35);border-radius:24px;padding:28px;display:flex;flex-direction:column;justify-content:center;text-align:center;aspect-ratio:1/1;">
          <h3 style="color:white;font-size:1.2rem;margin-bottom:6px;">Lista Inicial de Prospectos</h3>
          <p style="color:var(--bs-text-muted);font-size:0.85rem;margin-bottom:16px;">Hasta ~25 prospectos verificados, un nicho/zona</p>
          <div style="margin-bottom:12px;">
            <span style="font-size:2.4rem;font-weight:800;color:white;">Q3,800</span>
            <span style="color:var(--bs-text-muted);"> pago único</span>
          </div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:10px;margin-bottom:20px;text-align:left;align-self:stretch;">
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:10px;font-size:0.9rem;"><span style="color:var(--bs-text);">✓</span> Contactos reales, verificados y enriquecidos</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:10px;font-size:0.9rem;"><span style="color:var(--bs-text);">✓</span> Puntuados y etiquetados por oportunidad</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:10px;font-size:0.9rem;"><span style="color:var(--bs-text);">✓</span> Es tuyo para siempre</li>
          </ul>
          <a href="/es/products/lead-generation-starter-list" class="btn btn-primary" style="width:100%;justify-content:center;background:var(--bs-bg-raised);box-shadow:0 4px 15px rgba(255,45,149,0.35);">Más Información</a>
        </div>

        <!-- Lista Pro de Prospectos -->
        <div style="background:linear-gradient(135deg,rgba(255,45,149,0.12),rgba(255,45,149,0.12));border:2px solid rgba(255,45,149,0.45);border-radius:24px;padding:28px;display:flex;flex-direction:column;justify-content:center;text-align:center;aspect-ratio:1/1;position:relative;">
          <div style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--bs-bg-raised);color:white;padding:4px 16px;border-radius:100px;font-size:0.75rem;font-weight:600;white-space:nowrap;">Mejor Valor</div>
          <h3 style="color:white;font-size:1.2rem;margin-bottom:6px;">Lista Pro de Prospectos</h3>
          <p style="color:var(--bs-text-muted);font-size:0.85rem;margin-bottom:16px;">Hasta ~100 prospectos + plantillas de contacto</p>
          <div style="margin-bottom:12px;">
            <span style="font-size:2.4rem;font-weight:800;color:white;">Q7,600</span>
            <span style="color:var(--bs-text-muted);"> pago único</span>
          </div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:10px;margin-bottom:20px;text-align:left;align-self:stretch;">
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:10px;font-size:0.9rem;"><span style="color:var(--bs-text);">✓</span> Todo lo de la Lista Inicial, 4x más prospectos</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:10px;font-size:0.9rem;"><span style="color:var(--bs-text);">✓</span> Enriquecimiento más profundo</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:10px;font-size:0.9rem;"><span style="color:var(--bs-text);">✓</span> Plantillas de mensajes incluidas</li>
          </ul>
          <a href="/es/products/lead-generation-pro-list" class="btn btn-primary" style="width:100%;justify-content:center;background:var(--bs-bg-raised);box-shadow:0 4px 15px rgba(255,45,149,0.35);">Más Información</a>
        </div>

        <!-- Review Engine -->
        <div style="background:linear-gradient(135deg,rgba(255,45,149,0.12),rgba(255,45,149,0.12));border:2px solid rgba(255,45,149,0.45);border-radius:24px;padding:28px;display:flex;flex-direction:column;justify-content:center;text-align:center;aspect-ratio:1/1;position:relative;">
          <div style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--bs-bg-raised);color:white;padding:4px 16px;border-radius:100px;font-size:0.75rem;font-weight:600;white-space:nowrap;">Nuevo</div>
          <h3 style="color:white;font-size:1.2rem;margin-bottom:6px;">Review Engine</h3>
          <p style="color:var(--bs-text-muted);font-size:0.85rem;margin-bottom:16px;">Convertimos a tus clientes anteriores en tu fuente de reseñas</p>
          <div style="margin-bottom:12px;">
            <span style="font-size:2.4rem;font-weight:800;color:white;">Q3,800</span>
            <span style="color:var(--bs-text-muted);"> configuración + Q740/mes</span>
          </div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:10px;margin-bottom:20px;text-align:left;align-self:stretch;">
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:10px;font-size:0.9rem;"><span style="color:var(--bs-text);">✓</span> Le pide reseña a cada cliente anterior, sin comprar reseñas</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:10px;font-size:0.9rem;"><span style="color:var(--bs-text);">✓</span> Recupera clientes callados</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:10px;font-size:0.9rem;"><span style="color:var(--bs-text);">✓</span> Informe mensual de reseñas y calificación</li>
          </ul>
          <a href="/es/products/review-engine" class="btn btn-primary" style="width:100%;justify-content:center;background:var(--bs-bg-raised);box-shadow:0 4px 15px rgba(255,45,149,0.35);">Más Información</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing: Websites -->
  <section id="precios-sitios" style="padding:100px 0">
    <div class="container">
      <div style="text-align:center;margin-bottom:64px;">
        <div style="display:inline-block;padding:6px 16px;background:rgba(255,45,149,0.16);border-radius:100px;color:var(--bs-text-muted);font-size:0.85rem;font-weight:600;margin-bottom:16px;"><svg viewBox="0 0 24 24" style="width:34px;height:34px;stroke:var(--bs-accent);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.6 2.6 2.6 15.4 0 18"/><path d="M12 3c-2.6 2.6-2.6 15.4 0 18"/></svg> Diseño de Sitios Web</div>
        <h2 style="font-size:2.5rem;color:white;margin-bottom:16px;">Planes de Sitios Web</h2>
        <p style="color:var(--bs-text-muted);font-size:1.1rem;max-width:600px;margin:0 auto;">Sitios web profesionales a precios justos. Sin costos ocultos, sin sorpresas.</p>
      </div>
      
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:32px;max-width:1000px;margin:0 auto;">
        <!-- Starter -->
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:24px;padding:40px;backdrop-filter:blur(10px);">
          <h3 style="color:white;font-size:1.5rem;margin-bottom:8px;">Básico</h3>
          <p style="color:var(--bs-text-muted);margin-bottom:24px;">Perfecto para negocios nuevos</p>
          <div style="margin-bottom:32px;">
            <span style="font-size:2rem;font-weight:800;color:white;">Q3,800</span>
            <span style="color:var(--bs-text-muted);"> pago único</span>
          </div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:16px;margin-bottom:32px;">
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> 1-3 páginas</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Responsivo para celular</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Botón de WhatsApp</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Google Maps</li>
            <li style="color:var(--bs-text-muted);display:flex;align-items:center;gap:12px;"><span style="color:var(--bs-text);">✓</span> Formulario de contacto</li>
          </ul>
          <a href="/es/products/website-starter" class="btn btn-secondary" style="width:100%;justify-content:center;">Más Información</a>
        </div>
        
        <!-- Professional -->
        <div style="background:linear-gradient(135deg,rgba(255,45,149,0.16),rgba(255,45,149,0.16));border:2px solid rgba(255,45,149,0.45);border-radius:24px;padding:40px;position:relative;">
          <div style="position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--gradient-primary);color:white;padding:6px 20px;border-radius:100px;font-size:0.85rem;font-weight:600;">Más Popular</div>
          <h3 style="color:white;font-size:1.5rem;margin-bottom:8px;">Profesional</h3>
          <p style="color:var(--bs-text-muted);margin-bottom:24px;">Para negocios en crecimiento</p>
          <div style="margin-bottom:32px;">
            <span style="font-size:2rem;font-weight:800;color:white;">Q7,600</span>
            <span style="color:var(--bs-text-muted);"> pago único</span>
          </div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:16px;margin-bottom:32px;">
