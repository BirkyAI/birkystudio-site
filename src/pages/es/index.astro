    function toggleFaq(btn) {
      const answer = btn.nextElementSibling;
      const icon = btn.querySelector('span:last-child');
      if (answer.style.maxHeight && answer.style.maxHeight !== '0px') {
        answer.style.maxHeight = '0';
        icon.textContent = '+';
