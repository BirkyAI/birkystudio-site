---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Contacto" description="Contáctanos para empezar tu proyecto de sitio web. Respuesta rápida, cotización gratis." image="/images/luna-about.jpg">
  
  <section style="padding:100px 0;background:linear-gradient(135deg,#0f172a 0%,#1e1b4b 100%);">
    <div class="container" style="text-align:center;">
      <div style="width:120px;height:120px;border-radius:50%;overflow:hidden;border:4px solid rgba(255,255,255,0.2);margin:0 auto 20px;box-shadow:0 0 30px rgba(99,102,241,0.3);">
        <img src="/images/birky-mascot.jpg" alt="Luna - fundadora de Birky Studio" style="width:100%;height:100%;object-fit:cover;">
      </div>
      <h1 style="font-size:clamp(2rem,5vw,3.5rem);color:white;margin-bottom:16px;">Construyamos Algo Genial</h1>
      <p style="color:#94a3b8;font-size:1.1rem;max-width:600px;margin:0 auto;">Cuéntanos sobre tu negocio y te responderemos en menos de una hora con una cotización gratis.</p>
    </div>
  </section>

  <section style="padding:80px 0;background:#f8fafc;">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:64px;max-width:1000px;margin:0 auto;">
        <!-- Contact Form -->
        <div style="background:white;border-radius:24px;padding:48px;box-shadow:0 4px 20px rgba(0,0,0,0.08);">
          <h2 style="font-size:1.5rem;margin-bottom:32px;">Envíanos un Mensaje</h2>
          <form id="contacto-es-form" style="display:flex;flex-direction:column;gap:20px;">
            <div>
              <label style="display:block;font-weight:500;margin-bottom:8px;color:var(--color-dark);">Tu Nombre</label>
              <input type="text" id="ces-name" required style="width:100%;padding:14px 16px;border:2px solid #e2e8f0;border-radius:12px;font-size:1rem;" placeholder="Juan Pérez">
            </div>
            <div>
              <label style="display:block;font-weight:500;margin-bottom:8px;color:var(--color-dark);">Correo Electrónico</label>
              <input type="email" id="ces-email" required style="width:100%;padding:14px 16px;border:2px solid #e2e8f0;border-radius:12px;font-size:1rem;" placeholder="juan@negocio.com">
            </div>
            <div>
              <label style="display:block;font-weight:500;margin-bottom:8px;color:var(--color-dark);">Nombre del Negocio</label>
              <input type="text" id="ces-business" style="width:100%;padding:14px 16px;border:2px solid #e2e8f0;border-radius:12px;font-size:1rem;" placeholder="Tu Negocio">
            </div>
            <div>
              <label style="display:block;font-weight:500;margin-bottom:8px;color:var(--color-dark);">¿Qué necesitas?</label>
              <select id="ces-service" style="width:100%;padding:14px 16px;border:2px solid #e2e8f0;border-radius:12px;font-size:1rem;background:white;">
                <option value="basico">Sitio Básico ($499)</option>
                <option value="profesional">Sitio Profesional ($999)</option>
                <option value="premium">Sitio Premium ($1,999)</option>
                <option value="agente-ia">Configuración de Agente IA ($1,297)</option>
                <option value="recepcionista-texto">Recepcionista de Texto ($297)</option>
                <option value="recepcionista-voz">Recepcionista por Voz ($550)</option>
                <option value="nosure">No estoy seguro/a</option>
              </select>
            </div>
            <div>
              <label style="display:block;font-weight:500;margin-bottom:8px;color:var(--color-dark);">Cuéntanos más</label>
              <textarea id="ces-message" rows="4" style="width:100%;padding:14px 16px;border:2px solid #e2e8f0;border-radius:12px;font-size:1rem;resize:vertical;" placeholder="¿A qué se dedica tu negocio? ¿Alguna función específica que necesites?"></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;font-size:1.1rem;padding:16px;">
              Enviar Mensaje →
            </button>
          </form>
        </div>
        
        <!-- Contact Info -->
        <div style="display:flex;flex-direction:column;gap:32px;">
          <div>
            <h3 style="font-size:1.25rem;margin-bottom:16px;">Contáctanos Directo</h3>
            <p style="color:var(--color-gray);line-height:1.8;margin-bottom:24px;">¿Prefieres escribirnos directo? Estamos disponibles en WhatsApp y correo. Normalmente respondemos en menos de una hora.</p>
          </div>
          
          <!-- Calendly Booking Widget -->
          <div style="background:white;border-radius:16px;padding:24px;border:1px solid #e2e8f0;">
            <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px;">
              <div style="width:48px;height:48px;background:linear-gradient(135deg,#006bff,#0050cc);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">
                📅
              </div>
              <div>
                <div style="font-weight:600;margin-bottom:4px;">Agenda una Llamada Demo</div>
                <div style="color:var(--color-gray);">Elige un horario que te funcione</div>
              </div>
            </div>
            <div class="calendly-inline-widget" data-url="https://calendly.com/birky-studio/ai-agent-demo-call" style="min-width:100%;height:600px;border-radius:12px;overflow:hidden;"></div>
          </div>
          
          <a href="https://wa.me/50234775110" target="_blank" rel="noopener noreferrer" style="display:block;background:white;border-radius:16px;padding:24px;border:1px solid #e2e8f0;text-decoration:none;color:inherit;transition:all 0.2s;" onmouseover="this.style.borderColor='#25d366'" onmousout="this.style.borderColor='#e2e8f0'">
            <div style="display:flex;align-items:center;gap:16px;">
              <div style="width:48px;height:48px;background:linear-gradient(135deg,#25d366,#128c7e);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">💬</div>
              <div>
                <div style="font-weight:600;margin-bottom:4px;">WhatsApp</div>
                <div style="color:var(--color-gray);">+502 3477 5110</div>
              </div>
            </div>
          </a>
          
          <div style="background:white;border-radius:16px;padding:24px;border:1px solid #e2e8f0;">
            <div style="display:flex;align-items:center;gap:16px;">
              <div style="width:48px;height:48px;background:var(--gradient-primary);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">📧</div>
              <div>
                <div style="font-weight:600;margin-bottom:4px;">Correo</div>
                <div style="color:var(--color-gray);">birky.ai@proton.me</div>
              </div>
            </div>
          </div>
          
          <div style="background:white;border-radius:16px;padding:24px;border:1px solid #e2e8f0;">
            <div style="display:flex;align-items:center;gap:16px;">
              <div style="width:48px;height:48px;background:linear-gradient(135deg,#06b6d4,#0891b2);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">⏰</div>
              <div>
                <div style="font-weight:600;margin-bottom:4px;">Tiempo de Respuesta</div>
                <div style="color:var(--color-gray);">Menos de una hora</div>
              </div>
            </div>
          </div>
          
          <div style="background:linear-gradient(135deg,#818cf8,#6366f1);border-radius:16px;padding:24px;color:white;">
            <h4 style="margin-bottom:8px;">Cotización Gratis</h4>
            <p style="opacity:0.9;line-height:1.6;">¿No sabes qué necesitas? Cuéntanos sobre tu negocio y te recomendamos el paquete ideal para ti. Sin compromiso.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

<script is:inline>
  document.getElementById('contacto-es-form').addEventListener('submit', function(e) {
    e.preventDefault();
    const name = document.getElementById('ces-name').value;
    const email = document.getElementById('ces-email').value;
    const business = document.getElementById('ces-business').value;
    const service = document.getElementById('ces-service').value;
    const message = document.getElementById('ces-message').value;
    
    const serviceLabels = {
      'basico': 'Sitio Básico ($499)',
      'profesional': 'Sitio Profesional ($999)',
      'premium': 'Sitio Premium ($1,999)',
      'agente-ia': 'Configuración de Agente IA ($1,297)',
      'recepcionista-texto': 'Recepcionista de Texto ($297)',
      'recepcionista-voz': 'Recepcionista por Voz ($550)',
      'nosure': 'No estoy seguro/a'
    };
    
    const text = `Hola! Me gustaría contactarlos.\n\nNombre: ${name}\nCorreo: ${email}\nNegocio: ${business}\nServicio: ${serviceLabels[service] || service}\n\nMensaje: ${message}`;
    
    window.open(`https://wa.me/50234775110?text=${encodeURIComponent(text)}`, '_blank');
  });
</script>

<script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
</BaseLayout>