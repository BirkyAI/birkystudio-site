---
export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "Smart digital solutions for small businesses — professional websites and AI agents, delivered fast and built to grow with you.", image = "/images/birky-mascot.jpg" } = Astro.props;

const isSpanish = Astro.url.pathname.startsWith('/es');
const lang = isSpanish ? 'es' : 'en';

// Canonical: use the current page URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// Hreflang URLs — only for pages that have actual ES translations
const pathWithoutLang = Astro.url.pathname.replace(/^\/es\/?/, '/');
const enURL = new URL(pathWithoutLang === '/' ? '/' : pathWithoutLang, Astro.site).href;
const esPath = pathWithoutLang === '/' ? '/es/' : `/es${pathWithoutLang}`;
const esURL = new URL(esPath, Astro.site).href;

// Determine if this page has a Spanish translation and what its URL is
// ES slugs are different from EN slugs
const esSlugMap = {
  '/portfolio': '/es/portafolio',
  '/about': '/es/sobre-mi',
  '/contact': '/es/contacto',
};

const currentPathRaw = isSpanish ? pathWithoutLang : Astro.url.pathname;
// Normalize trailing slash for matching
const currentPathForCheck = currentPathRaw.endsWith('/') && currentPathRaw !== '/' 
  ? currentPathRaw.slice(0, -1) : currentPathRaw;
const hasTranslation = currentPathForCheck === '/' || esSlugMap.hasOwnProperty(currentPathForCheck);
// Override esURL for pages that have different slugs in Spanish
const correctedEsURL = currentPathForCheck === '/' ? esURL : 
  hasTranslation ? new URL(esSlugMap[currentPathForCheck] || esPath, Astro.site).href : esURL;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Birky Studio</title>
  <meta name="description" content={description}>
  
  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />
  
  <!-- Hreflang -->
  <link rel="alternate" hreflang="en" href={enURL} />
  {hasTranslation && <link rel="alternate" hreflang="es" href={correctedEsURL} />}
  <link rel="alternate" hreflang="x-default" href={enURL} />
  
  <!-- Open Graph -->
  <meta property="og:title" content={`${title} | Birky Studio`}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(image, Astro.site).href}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={`${title} | Birky Studio`}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={new URL(image, Astro.site).href}>
  
  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style is:global>
    :root {
      --color-primary: #6366f1;
      --color-primary-dark: #4f46e5;
      --color-secondary: #ec4899;
      --color-accent: #06b6d4;
      --color-dark: #0f172a;
      --color-gray: #64748b;
      --color-light: #f8fafc;
      --gradient-primary: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
      --gradient-accent: linear-gradient(135deg, var(--color-accent), var(--color-primary));
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Inter', system-ui, sans-serif;
      color: var(--color-dark);
      line-height: 1.6;
      background: white;
    }
    
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }
    
    h1, h2, h3, h4 {
      line-height: 1.2;
      font-weight: 700;
    }
    
    a {
      color: inherit;
      text-decoration: none;
    }
    
    img {
      max-width: 100%;
      height: auto;
    }
    
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 1rem;
      transition: all 0.2s;
      cursor: pointer;
      border: none;
    }
    
    .btn-primary {
      background: var(--gradient-primary);
      color: white;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
    }
    
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
    }
    
    .btn-secondary {
      background: white;
      color: var(--color-primary);
      border: 2px solid var(--color-primary);
    }
    
    .btn-secondary:hover {
      background: var(--color-primary);
      color: white;
    }
    
    .gradient-text {
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    /* Mobile hamburger */
    .mobile-menu-btn {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
    }
    .mobile-menu-btn span {
      display: block;
      width: 24px;
      height: 2.5px;
      background: var(--color-dark);
      border-radius: 2px;
      transition: all 0.3s;
    }
    
    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .nav-links {
        position: fixed;
        top: 72px;
        left: 0;
        right: 0;
        background: rgba(255,255,255,0.98);
        backdrop-filter: blur(10px);
        flex-direction: column;
        gap: 0;
        padding: 16px 24px 24px;
        border-bottom: 1px solid #e2e8f0;
        transform: translateY(-120%);
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s ease;
        z-index: 99;
        box-shadow: 0 8px 30px rgba(0,0,0,0.1);
      }
      .nav-links.open {
        transform: translateY(0);
        opacity: 1;
        pointer-events: all;
        z-index: 9999;
      }
      .nav-links a {
        padding: 14px 0;
        font-size: 1.1rem;
        border-bottom: 1px solid #f1f5f9;
      }
      .nav-links a:last-child { border-bottom: none; }
      .nav-links .btn { margin-top: 8px; justify-content: center; }
    }
  </style>
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-S4438YL4EK"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-S4438YL4EK');
  </script>
</head>
<body>
  <!-- Navigation -->
  <nav style="position:sticky;top:0;z-index:100;background:rgba(255,255,255,0.95);backdrop-filter:blur(10px);border-bottom:1px solid #e2e8f0;">
    <div style="display:flex;align-items:center;justify-content:space-between;height:72px;padding:0 clamp(16px,5vw,48px);max-width:1400px;margin:0 auto;">
      <a href={Astro.url.pathname.startsWith('/es') ? '/es/' : '/'} style="font-size:1.5rem;font-weight:800;">
        <span class="gradient-text">Birky Studio</span>
      </a>
      <button class="mobile-menu-btn" onclick="toggleMobileMenu()" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
      <div class="nav-links" style="display:flex;align-items:center;gap:24px;">
        {Astro.url.pathname.startsWith('/es') ? (
          <>
            <a href="/es/portafolio" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">Portafolio</a>
            <a href="/es/sobre-mi" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">Sobre Mí</a>
            <a href="/es/#productos" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">Productos</a>
            <a href="/blog" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">Blog</a>
            <a href="/es/#precios-sitios" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">Precios</a>
            <a href="/es/contacto" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">Contacto</a>
            <a href="/" style="font-size:0.85rem;font-weight:600;padding:6px 14px;border-radius:8px;background:#f1f5f9;color:var(--color-dark);transition:all 0.2s;">EN</a>
            <a href="/es/contacto" class="btn btn-primary" style="padding:10px 20px;font-size:0.9rem;">Empezar</a>
          </>
        ) : (
          <>
            <a href="/portfolio" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">Portfolio</a>
            <a href="/about" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">About</a>
            <a href="/#products" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">Products</a>
            <a href="/blog" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">Blog</a>
            <a href="/#pricing-websites" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">Pricing</a>
            <a href="/contact" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">Contact</a>
            <a href="/partners" style="font-weight:500;color:var(--color-gray);transition:color 0.2s;">Partner</a>
            <a href="/es/" style="font-size:0.85rem;font-weight:600;padding:6px 14px;border-radius:8px;background:#f1f5f9;color:var(--color-dark);transition:all 0.2s;">ES</a>
            <a href="/contact" class="btn btn-primary" style="padding:10px 20px;font-size:0.9rem;">Get Started</a>
          </>
        )}
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer style="background:var(--color-dark);color:white;padding:64px 0 32px;">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:48px;margin-bottom:48px;">
        <div>
          <div style="font-size:1.5rem;font-weight:800;margin-bottom:16px;">
            <span style="background:linear-gradient(135deg,#818cf8,#f472b6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Birky Studio</span>
          </div>
          <p style="color:#94a3b8;line-height:1.8;">Smart digital solutions for small businesses. Websites, AI agents, and everything you need to grow online.</p>
        </div>
        <div>
          <h4 style="font-size:1rem;font-weight:600;margin-bottom:16px;">Products</h4>
          <div style="display:flex;flex-direction:column;gap:12px;">
            <a href="/portfolio" style="color:#94a3b8;transition:color 0.2s;">Portfolio</a>
