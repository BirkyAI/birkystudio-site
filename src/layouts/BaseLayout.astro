            <a href="/#products" style="color:#94a3b8;transition:color 0.2s;">Products</a>
            <a href="/blog" style="color:#94a3b8;transition:color 0.2s;">Blog</a>
            <a href="/tools/ai-savings-calculator" style="color:#94a3b8;transition:color 0.2s;">Free Tools</a>
            <a href="/#pricing-websites" style="color:#94a3b8;transition:color 0.2s;">Pricing</a>
            <a href="/contact" style="color:#94a3b8;transition:color 0.2s;">Contact</a>
          </div>
        </div>
        <div>
          <h4 style="font-size:1rem;font-weight:600;margin-bottom:16px;">Contact</h4>
          <div style="display:flex;flex-direction:column;gap:12px;color:#94a3b8;">
            <span>birky.ai@proton.me</span>
            <span>WhatsApp: +502 3477 5110</span>
