              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
            <a href="https://www.tiktok.com/@ai_agent_for_realtors" target="_blank" rel="noopener noreferrer" aria-label="TikTok" style="color:#94a3b8;transition:color 0.2s;" onmouseover="this.style.color='#818cf8'" onmouseout="this.style.color='#94a3b8'">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
            </a>
          </div>
        </div>
      </div>
      <div style="border-top:1px solid #1e293b;padding-top:24px;text-align:center;color:#64748b;font-size:0.9rem;">
        <p>&copy; {new Date().getFullYear()} Birky Studio. All rights reserved.</p>
      </div>
    </div>
  </footer>
  <script>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/insights/script.js"></script>
  <!-- WhatsApp Floating Widget -->
  <div id="whatsapp-float" style="position:fixed;bottom:24px;right:24px;z-index:999;display:flex;flex-direction:column;align-items:flex-end;gap:8px;">
    <div id="whatsapp-badge" style="background:rgba(37,211,102,0.12);backdrop-filter:blur(8px);border:1px solid rgba(37,211,102,0.3);border-radius:12px;padding:8px 14px;font-size:0.8rem;color:#25D366;font-weight:600;display:flex;align-items:center;gap:6px;transition:all 0.3s;animation:pulse-badge 2s ease-in-out infinite;">
      <span style="width:8px;height:8px;background:#25D366;border-radius:50%;display:inline-block;animation:pulse-dot 2s ease-in-out infinite;"></span>
      AI Online — Chat with us
    </div>
    <a href="https://wa.me/50234775110?text=Hi%20Birky%20Studio!%20I%20have%20a%20question%20about%20your%20services." target="_blank" rel="noopener noreferrer" style="width:60px;height:60px;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(37,211,102,0.4);transition:all 0.2s;text-decoration:none;cursor:pointer;" onmouseover="this.style.transform='scale(1.1)';document.getElementById('whatsapp-badge').style.boxShadow='0 4px 15px rgba(37,211,102,0.3)'" onmouseout="this.style.transform='scale(1)';document.getElementById('whatsapp-badge').style.boxShadow='none'" aria-label="Chat on WhatsApp">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
  </div>
  <script is:inline>
    function toggleMobileMenu() {
      const nav = document.querySelector('.nav-links');
      const wa = document.getElementById('whatsapp-float');
      nav.classList.toggle('open');
      if (nav.classList.contains('open')) {
        if (wa) wa.style.display = 'none';
        document.body.style.overflow = 'hidden';
      } else {
        if (wa) wa.style.display = '';
        document.body.style.overflow = '';
      }
    }
    // Close mobile menu when a nav link is tapped
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.nav-links a').forEach(function(link) {
        link.addEventListener('click', function() {
          var nav = document.querySelector('.nav-links');
          var wa = document.getElementById('whatsapp-float');
          nav.classList.remove('open');
          if (wa) wa.style.display = '';
          document.body.style.overflow = '';
        });
      });
    });
  </script>
  <style>
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    @keyframes pulse-badge {
      0%, 100% { box-shadow: none; }
      50% { box-shadow: 0 0 12px rgba(37,211,102,0.15); }
    }
  </style>
</body>
</html>
